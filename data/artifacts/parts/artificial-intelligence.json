    "artificial-intelligence--reinforcement-learning": {
      "type": "derivation",
      "title": "Bellman expectation",
      "steps": [
        "V^{\\pi}(s)=\\mathbb{E}_{\\pi}\\left[\\sum_{t=0}^{\\infty}\\gamma^{t}r_{t}\\mid s_{0}=s\\right]",
        "V^{\\pi}(s)=\\mathbb{E}_{\\pi}\\left[r_{0}+\\gamma\\sum_{t=0}^{\\infty}\\gamma^{t}r_{t+1}\\mid s_{0}=s\\right]",
        "V^{\\pi}(s)=R(s,\\pi(s))+\\gamma\\sum_{s'}P(s'\\mid s,\\pi(s))\\,V^{\\pi}(s')"
      ],
      "symbols": [
        [
          "\\gamma",
          "discount factor, 0 <= gamma < 1"
        ],
        [
          "r_t",
          "reward received at step t"
        ],
        [
          "R(s,a)",
          "expected immediate reward"
        ],
        [
          "P(s'\\mid s,a)",
          "transition probability"
        ],
        [
          "\\pi",
          "policy mapping states to actions"
        ]
      ],
      "note": "Pulling the first reward out of the sum leaves the same expectation one step later, which is exactly the Bellman equation."
    },
    "artificial-intelligence--decision-tree": {
      "type": "derivation",
      "title": "information gain from entropy",
      "steps": [
        "H(D)=-\\sum_{k}p_{k}\\log_{2}p_{k}",
        "H(D\\mid A)=\\sum_{v}\\frac{|D_{v}|}{|D|}\\,H(D_{v})",
        "IG(D,A)=H(D)-H(D\\mid A)",
        "A^{*}=\\arg\\max_{A}IG(D,A)"
      ],
      "symbols": [
        [
          "D",
          "training set reaching the node"
        ],
        [
          "A",
          "candidate attribute"
        ],
        [
          "D_v",
          "subset of D with A = v"
        ],
        [
          "p_k",
          "fraction of D in class k"
        ],
        [
          "H",
          "Shannon entropy in bits"
        ]
      ],
      "note": "Gain is the parent entropy minus the weighted entropy of the children, so the chosen test removes the most uncertainty."
    }
