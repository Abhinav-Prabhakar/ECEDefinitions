    "artificial-intelligence--simple-reflex-agent": {
      "type": "code",
      "lang": "python",
      "title": "condition–action rules",
      "lines": [
        "RULES = {\"dirty\": \"suck\", \"A\": \"right\", \"B\": \"left\"}",
        "",
        "def reflex(percept):",
        "    for condition, action in RULES.items():",
        "        if condition in percept:",
        "            return action",
        "    return \"noop\"",
        "",
        "print(reflex((\"A\", \"dirty\")))",
        "print(reflex((\"B\", \"clean\")))"
      ],
      "highlight": [
        5
      ],
      "output": [
        "suck",
        "left"
      ],
      "note": "The table is scanned top to bottom against the current percept only; no state or history is stored between calls."
    },
