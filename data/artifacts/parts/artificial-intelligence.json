    "artificial-intelligence--alpha-beta-pruning": {
      "type": "code",
      "lang": "python",
      "title": "minimax with alpha–beta pruning",
      "lines": [
        "def ab(node, depth, alpha, beta, hi):",
        "    if depth == 0: return node",
        "    best = -1e9 if hi else 1e9",
        "    for kid in node:",
        "        v = ab(kid, depth-1, alpha, beta, not hi)",
        "        best = max(best, v) if hi else min(best, v)",
        "        alpha, beta = (max(alpha, v), beta) if hi else (alpha, min(beta, v))",
        "        if alpha >= beta: break",
        "    return best",
        "",
        "print(ab([[3, 12], [8, 2]], 2, -1e9, 1e9, True))"
      ],
      "highlight": [
        8
      ],
      "output": [
        "3"
      ],
      "note": "Raising alpha at a MAX node and lowering beta at a MIN node lets the alpha >= beta test drop branches the opponent would refuse."
    },
    "artificial-intelligence--pddl": {
      "type": "code",
      "lang": "text",
      "title": "PDDL action schema",
      "lines": [
        "(define (domain blocks)",
        "  (:predicates (on ?x ?y) (clear ?x) (holding ?x))",
        "  (:action stack",
        "    :parameters (?x ?y)",
        "    :precondition (and (holding ?x) (clear ?y))",
        "    :effect (and (on ?x ?y) (not (holding ?x)) (not (clear ?y)))))"
      ],
      "highlight": [
        5,
        6
      ],
      "note": "Preconditions are tested before the action; effect literals are added and deleted together, so holding and clear are consumed as on is made."
    },
    "artificial-intelligence--bayes-rule": {
      "type": "derivation",
      "title": "Bayes' rule from conditional probability",
      "steps": [
        "P(A\\mid B)=\\frac{P(A\\cap B)}{P(B)},\\quad P(B)>0",
        "P(A\\cap B)=P(B\\mid A)\\,P(A)",
        "P(B)=\\sum_{a}P(B\\mid A=a)\\,P(A=a)",
        "P(A\\mid B)=\\frac{P(B\\mid A)\\,P(A)}{\\sum_{a}P(B\\mid A=a)\\,P(A=a)}"
      ],
      "symbols": [
        [
          "A",
          "hypothesis or hidden cause"
        ],
        [
          "B",
          "observed evidence"
        ],
        [
          "P(A)",
          "prior probability"
        ],
        [
          "P(B\\mid A)",
          "likelihood"
        ],
        [
          "P(A\\mid B)",
          "posterior probability"
        ]
      ],
      "note": "The numerator is the joint probability written two ways; expanding the denominator by total probability makes the rule usable without P(B)."
    },
