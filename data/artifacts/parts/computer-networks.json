          "from": 1,
          "to": 0,
          "label": "SYN + ACK"
        },
        {
          "from": 0,
          "to": 1,
          "label": "ACK"
        },
        {
          "from": 0,
          "to": 1,
          "label": "data"
        }
      ],
      "note": "The three-way handshake agrees both sequence numbers before any payload is sent."
    },
    "computer-networks--osi-reference-model": {
      "type": "table",
      "title": "OSI layers, PDUs and jobs",
      "headers": [
        "layer",
        "PDU",
        "main job"
      ],
      "rows": [
        [
          "7 application",
          "message",
          "services for the user: HTTP, DNS, SMTP"
        ],
        [
          "6 presentation",
          "message",
          "syntax, encoding, compression and encryption"
        ],
        [
          "5 session",
          "message",
          "dialog control: establish, manage, end sessions"
        ],
        [
          "4 transport",
          "segment",
          "end-to-end process delivery, ports, flow control"
        ],
        [
          "3 network",
          "packet",
          "logical addressing and routing between networks"
        ],
        [
          "2 data link",
          "frame",
          "framing, error control, MAC addressing"
        ],
        [
          "1 physical",
          "bit",
          "bit transmission over the medium"
        ]
      ],
      "highlight": 4,
      "note": "Each layer adds its own header to the unit passed down, so the PDU is renamed at layers 4, 3 and 2."
    },
    "computer-networks--checksum": {
      "type": "table",
      "title": "one's complement checksum by hand",
      "headers": [
        "step",
        "16-bit value"
      ],
      "rows": [
        [
          "data word 1",
          "0x1234"
        ],
        [
          "data word 2",
          "0x5678"
        ],
        [
          "sum",
          "0x68AC"
        ],
        [
          "checksum sent = complement of sum",
          "0x9753"
        ],
        [
          "receiver adds all three words",
          "0xFFFF, complement 0x0000, accepted"
        ]
      ],
      "highlight": 4,
      "note": "Only the complement travels, so a receiver's total folds to all ones and its complement is zero when nothing is corrupt."
    },
    "computer-networks--cyclic-redundancy-check-crc": {
      "type": "code",
      "lang": "c",
      "title": "CRC-32 remainder, one bit per clock",
      "lines": [
        "uint32_t crc32(const uint8_t *p, size_t n) {",
        "    uint32_t crc = 0xFFFFFFFFu;",
        "    while (n--) {",
        "        crc ^= *p++;",
        "        for (int k = 0; k < 8; k++)",
        "            crc = (crc >> 1) ^ (0xEDB88320u & -(crc & 1u));",
        "    }",
        "    return ~crc;",
        "}"
      ],
      "highlight": [
        6
      ],
      "output": [
        "crc32(\"123456789\") = 0xCBF43926"
      ],
      "note": "Each data bit is XORed into the register, then the register shifts as if dividing by the generator polynomial."
    },
    "computer-networks--stop-and-wait-arq": {
      "type": "sequence",
      "title": "stop-and-wait with one lost frame",
      "actors": [
        "sender",
        "receiver"
      ],
      "steps": [
        {
          "from": 0,
          "to": 1,
          "label": "frame 0 (seq = 0)"
        },
        {
          "from": 1,
          "to": 0,
          "label": "ACK 1 (next expected = 1)"
        },
        {
          "from": 0,
          "to": 1,
          "label": "frame 1 lost in transit"
        },
        {
          "from": 0,
          "to": 1,
          "label": "timeout: frame 1 retransmitted"
        },
        {
          "from": 1,
          "to": 0,
          "label": "ACK 0"
        }
      ],
      "note": "The sender keeps one copy until its ACK arrives, so a single sequence bit is enough to discard a duplicate."
    },
    "computer-networks--count-to-infinity-problem": {
      "type": "table",
      "title": "count to infinity after link A-B fails",
      "headers": [
        "update round",
        "B: cost to A",
        "C: cost to A"
      ],
      "rows": [
        [
          "0, before failure",
          "1 direct",
          "2 via B"
        ],
        [
          "1",
          "3 via C",
          "2 via B"
        ],
        [
          "2",
          "3 via C",
          "4 via B"
        ],
        [
          "3",
          "5 via C",
          "4 via B"
        ],
        [
          "4",
          "5 via C",
          "6 via B"
        ],
        [
          "converged",
          "16 = infinity",
          "16 = infinity"
        ]
      ],
      "highlight": 2,
      "note": "B believes C's stale route to A, so every round adds 2 to the cost instead of declaring the link down."
    },
