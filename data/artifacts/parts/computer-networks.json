    "computer-networks--dhcp": {
      "type": "sequence",
      "title": "DHCP lease acquisition (DORA)",
      "actors": [
        "client",
        "server"
      ],
      "steps": [
        {
          "from": 0,
          "to": 1,
          "label": "DHCPDISCOVER broadcast from 0.0.0.0"
        },
        {
          "from": 1,
          "to": 0,
          "label": "DHCPOFFER: 192.168.1.50, mask, gateway"
        },
        {
          "from": 0,
          "to": 1,
          "label": "DHCPREQUEST for the offered address"
        },
        {
          "from": 1,
          "to": 0,
          "label": "DHCPACK: 24 h lease, DNS servers"
        },
        {
          "from": 0,
          "to": 1,
          "label": "renewal request at half the lease"
        },
        {
          "from": 1,
          "to": 0,
          "label": "DHCPACK with a fresh lease"
        }
      ],
      "note": "The client owns nothing until the ACK, so the request repeats the offer to tell other servers to withdraw theirs."
    },
