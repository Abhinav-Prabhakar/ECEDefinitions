    "software-defined-radio--direct-digital-synthesis": {
      "type": "derivation",
      "title": "control word to output frequency",
      "steps": [
        "\\Delta\\phi=\\frac{2\\pi\\,\\text{FCW}}{2^{N}}\\ \\text{rad per reference clock}",
        "\\text{one period}=\\frac{2\\pi}{\\Delta\\phi}=\\frac{2^{N}}{\\text{FCW}}\\ \\text{clocks}",
        "f_{\\text{out}}=\\frac{\\text{FCW}}{2^{N}}f_{c}",
        "N=32,\\ f_{c}=100\\ \\text{MHz}\\;\\Rightarrow\\;\\Delta f=\\frac{10^{8}}{2^{32}}=0.0233\\ \\text{Hz}"
      ],
      "symbols": [
        [
          "FCW",
          "frequency control word"
        ],
        [
          "N",
          "phase accumulator width in bits"
        ],
        [
          "f_{c}",
          "reference clock frequency"
        ],
        [
          "\\Delta f",
          "tuning step"
        ]
      ],
      "note": "The accumulator wraps at 2^32, so the output frequency is simply the fraction of full scale selected by the control word."
    },
    "software-defined-radio--dynamic-range": {
      "type": "derivation",
      "title": "dynamic range from converter bits",
      "steps": [
        "P_{\\text{FS}}=\\frac{(V_{\\text{FS}}/2)^{2}}{2R}=\\frac{V_{\\text{FS}}^{2}}{8R}",
        "P_{q}=\\frac{\\Delta^{2}}{12R},\\quad \\Delta=\\frac{V_{\\text{FS}}}{2^{M}}",
        "\\text{DR}=10\\log_{10}\\frac{P_{\\text{FS}}}{P_{q}}=10\\log_{10}\\left(\\frac{3}{2}\\,2^{2M}\\right)",
        "\\text{DR}=6.02M+1.76\\ \\text{dB}"
      ],
      "symbols": [
        [
          "V_{\\text{FS}}",
          "full-scale voltage"
        ],
        [
          "\\Delta",
          "one least significant bit"
        ],
        [
          "M",
          "converter resolution in bits"
        ],
        [
          "R",
          "load resistance"
        ]
      ],
      "note": "Each extra bit halves the step and adds 6.02 dB; the 1.76 dB offset comes from the 3/2 ratio of full-scale sine power to quantisation noise."
    },
    "software-defined-radio--aliasing": {
      "type": "derivation",
      "title": "undersampling GPS L1 at 100 MS/s",
      "steps": [
        "f_{a}=\\left|f_{0}-kf_{s}\\right|,\\quad k=\\operatorname{round}\\frac{f_{0}}{f_{s}}=16",
        "f_{0}=1575.42\\ \\text{MHz},\\quad f_{s}=100\\ \\text{MHz}",
        "f_{a}=\\left|1575.42-1600\\right|=24.58\\ \\text{MHz}<\\frac{f_{s}}{2}",
        "\\text{band }1575.42\\pm1.023\\ \\text{MHz folds to }24.58\\pm1.023\\ \\text{MHz}"
      ],
      "symbols": [
        [
          "f_{0}",
          "RF carrier frequency"
        ],
        [
          "f_{s}",
          "sampling rate"
        ],
        [
          "k",
          "integer number of folds"
        ],
        [
          "f_{a}",
          "alias frequency in the first Nyquist zone"
        ]
      ],
      "note": "Sampling at 100 MHz folds the 1575.42 MHz carrier to 24.58 MHz, so a digital down-converter can tune a band far above Nyquist."
    }
  }
