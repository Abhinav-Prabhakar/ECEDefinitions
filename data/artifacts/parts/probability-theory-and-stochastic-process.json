    "probability-theory-and-stochastic-process--bayes-theorem": {
      "type": "derivation",
      "title": "a 99 % test on a 1 % prevalence",
      "steps": [
        "P(D)=0.01,\\quad P(+|D)=0.99,\\quad P(+|D^{c})=0.01",
        "P(+)=P(+|D)P(D)+P(+|D^{c})P(D^{c})=0.0099+0.0099=0.0198",
        "P(D|+)=\\frac{P(+|D)P(D)}{P(+)}=\\frac{0.0099}{0.0198}=0.50"
      ],
      "symbols": [
        [
          "D",
          "the subject has the condition"
        ],
        [
          "+",
          "the test reports positive"
        ],
        [
          "P(+|D)",
          "sensitivity"
        ],
        [
          "P(+|D^{c})",
          "false-positive rate"
        ]
      ],
      "note": "With equal error rates at 1 % prevalence, true and false positives are equally numerous, so a positive result is only 50 % conclusive."
    },
    "probability-theory-and-stochastic-process--central-limit-theorem": {
      "type": "derivation",
      "title": "normal approximation for 30 dice",
      "steps": [
        "\\mu=\\frac{1+6}{2}=3.5,\\quad \\sigma^{2}=\\frac{6^{2}-1}{12}=\\frac{35}{12}",
        "n=30:\\quad E[S_{n}]=105,\\quad \\operatorname{sd}(S_{n})=\\sqrt{30\\cdot35/12}=9.35",
        "P(S_{n}>120)=P\\left(Z>\\frac{120.5-105}{9.35}\\right)=P(Z>1.66)",
        "=1-\\Phi(1.66)\\approx0.048"
      ],
      "symbols": [
        [
          "S_{n}",
          "sum of n independent rolls"
        ],
        [
          "\\mu,\\ \\sigma^{2}",
          "mean and variance of one roll"
        ],
        [
          "Z",
          "standard normal variable"
        ],
        [
          "\\Phi",
          "standard normal CDF"
        ]
      ],
      "note": "The sum is standardised, not the average, and the 120.5 continuity correction keeps the normal approximation accurate at n = 30."
    },
    "probability-theory-and-stochastic-process--poisson-distribution": {
      "type": "derivation",
      "title": "Poisson as a limit of the binomial",
      "steps": [
        "\\binom{n}{k}p^{k}(1-p)^{n-k},\\quad p=\\frac{\\lambda}{n}",
        "=\\frac{n(n-1)\\cdots(n-k+1)}{k!}\\left(\\frac{\\lambda}{n}\\right)^{k}\\left(1-\\frac{\\lambda}{n}\\right)^{n-k}",
        "\\frac{n(n-1)\\cdots(n-k+1)}{n^{k}}\\to1,\\quad\\left(1-\\frac{\\lambda}{n}\\right)^{n}\\to e^{-\\lambda},\\quad\\left(1-\\frac{\\lambda}{n}\\right)^{-k}\\to1",
        "P(X=k)\\to\\frac{\\lambda^{k}e^{-\\lambda}}{k!}"
      ],
      "symbols": [
        [
          "n",
          "number of Bernoulli trials"
        ],
        [
          "p",
          "per-trial success probability"
        ],
        [
          "\\lambda",
          "fixed mean np"
        ],
        [
          "k",
          "observed count"
        ]
      ],
      "note": "Hold the mean lambda = np fixed while n grows and p shrinks as 1/n; the binomial count then converges to the Poisson law."
    },
