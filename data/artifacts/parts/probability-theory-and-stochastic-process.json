    "probability-theory-and-stochastic-process--lti-response": {
      "type": "derivation",
      "title": "output PSD of a filtered process",
      "steps": [
        "Y(t)=\\int_{-\\infty}^{\\infty}h(\\alpha)X(t-\\alpha)\\,d\\alpha",
        "R_{YY}(\\tau)=\\int\\!\\!\\int h(\\alpha)h(\\beta)R_{XX}(\\tau+\\alpha-\\beta)\\,d\\alpha\\,d\\beta",
        "S_{YY}(\\omega)=H(\\omega)H^{*}(\\omega)S_{XX}(\\omega)=\\left|H(\\omega)\\right|^{2}S_{XX}(\\omega)",
        "\\text{RC low-pass}:\\quad S_{YY}(\\omega)=\\frac{S_{XX}(\\omega)}{1+(\\omega RC)^{2}}"
      ],
      "symbols": [
        [
          "h",
          "impulse response"
        ],
        [
          "H",
          "transfer function"
        ],
        [
          "S_{XX}",
          "input power spectral density"
        ],
        [
          "S_{YY}",
          "output power spectral density"
        ]
      ],
      "note": "The output spectrum is the input spectrum weighted by |H|^2, so the filter never creates frequencies, only rescales the ones present."
    },
    "probability-theory-and-stochastic-process--correlation-coefficient": {
      "type": "derivation",
      "title": "why the correlation coefficient is bounded by one",
      "steps": [
        "\\tilde{X}=X-\\mu_{X},\\quad\\tilde{Y}=Y-\\mu_{Y}",
        "0\\le E\\left[(\\tilde{X}-a\\tilde{Y})^{2}\\right]=\\sigma_{X}^{2}-2a\\operatorname{Cov}(X,Y)+a^{2}\\sigma_{Y}^{2}",
        "a=\\frac{\\operatorname{Cov}(X,Y)}{\\sigma_{Y}^{2}}\\;\\Rightarrow\\;\\sigma_{X}^{2}-\\frac{\\operatorname{Cov}^{2}(X,Y)}{\\sigma_{Y}^{2}}\\ge0",
        "\\rho_{XY}^{2}=\\frac{\\operatorname{Cov}^{2}(X,Y)}{\\sigma_{X}^{2}\\sigma_{Y}^{2}}\\le1"
      ],
      "symbols": [
        [
          "a",
          "any real multiplier"
        ],
        [
          "\\operatorname{Cov}(X,Y)",
          "covariance"
        ],
        [
          "\\sigma_{X},\\ \\sigma_{Y}",
          "standard deviations"
        ],
        [
          "\\rho_{XY}",
          "correlation coefficient"
        ]
      ],
      "note": "The multiplier that minimises the mean-square error gives the tightest bound, so |rho| = 1 exactly when Y is an affine function of X."
    },
