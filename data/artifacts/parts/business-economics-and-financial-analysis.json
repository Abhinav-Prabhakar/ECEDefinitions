    "business-economics-and-financial-analysis--law-of-variable-proportions": {
      "type": "table",
      "title": "three stages of the law of variable proportions",
      "headers": [
        "stage",
        "total product",
        "marginal product",
        "average product"
      ],
      "rows": [
        [
          "I - increasing returns",
          "rises at an increasing rate",
          "rises, then peaks",
          "rises"
        ],
        [
          "II - diminishing returns",
          "rises at a decreasing rate",
          "falls, stays positive",
          "peaks where AP = MP, then falls"
        ],
        [
          "III - negative returns",
          "falls",
          "negative",
          "keeps falling, above MP"
        ]
      ],
      "highlight": 2,
      "note": "A rational producer stops at the end of stage II: past zero marginal product, extra labour actually reduces total output."
    },
    "business-economics-and-financial-analysis--break-even-point": {
      "type": "derivation",
      "title": "break-even point from total revenue = total cost",
      "steps": [
        "\\text{TR}=P Q,\\qquad \\text{TC}=\\text{FC}+\\text{AVC}\\cdot Q",
        "P Q=\\text{FC}+\\text{AVC}\\,Q",
        "(P-\\text{AVC})\\,Q=\\text{FC}",
        "Q_{\\text{BEP}}=\\frac{\\text{FC}}{P-\\text{AVC}}=\\frac{40000}{50-30}=2000\\ \\text{units}",
        "S_{\\text{BEP}}=Q_{\\text{BEP}}P=2000\\times 50=100000"
      ],
      "symbols": [
        [
          "P",
          "selling price per unit"
        ],
        [
          "\\text{AVC}",
          "variable cost per unit"
        ],
        [
          "\\text{FC}",
          "total fixed cost"
        ],
        [
          "Q_{\\text{BEP}}",
          "break-even quantity"
        ],
        [
          "S_{\\text{BEP}}",
          "break-even sales value"
        ]
      ],
      "note": "With fixed cost 40,000 and 20 of contribution per unit, 2,000 units - sales of 1,00,000 - is the no-profit, no-loss point."
    },
