    "problem-solving-using-c--fopen": {
      "type": "code",
      "lang": "c",
      "title": "opening a file and checking for failure",
      "lines": [
        "FILE *fp = fopen(\"data.txt\", \"r\");",
        "if (fp == NULL) {",
        "    perror(\"data.txt\");",
        "    exit(1);",
        "}",
        "char buf[64];",
        "fgets(buf, sizeof buf, fp);",
        "fclose(fp);"
      ],
      "highlight": [
        1
      ],
      "note": "Mode \"r\" opens for reading; fopen returns NULL on failure, so the check must come before any read."
    }
