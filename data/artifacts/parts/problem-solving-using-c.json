      "lang": "c",
      "title": "pointer arithmetic",
      "lines": [
        "int x = 42;",
        "int *p = &x;",
        "printf(\"%d\\n\", *p);"
      ],
      "highlight": [
        2
      ],
      "output": [
        "42"
      ],
      "note": "p stores the address of x; *p reads the value at that address."
