        ]
      ],
      "highlight": 8,
      "note": "The delay factor e^(-as) in the last row is why Laplace handles dead time and switched inputs so cleanly."
    },
    "advanced-calculus--separation-of-variables": {
      "type": "derivation",
      "title": "solving the heat equation by separation",
      "steps": [
        "u(x,t)=X(x)T(t)\\;\\Rightarrow\\;XT^{\\prime}=\\alpha X^{\\prime\\prime}T",
        "\\frac{T^{\\prime}}{\\alpha T}=\\frac{X^{\\prime\\prime}}{X}=-\\lambda^{2}",
        "X_{n}=\\sin\\frac{n\\pi x}{L},\\quad T_{n}=e^{-\\alpha n^{2}\\pi^{2}t/L^{2}}",
        "u(x,t)=\\sum_{n=1}^{\\infty}B_{n}\\sin\\frac{n\\pi x}{L}\\,e^{-\\alpha n^{2}\\pi^{2}t/L^{2}}"
      ],
      "symbols": [
        [
          "u",
          "temperature"
        ],
        [
          "\\alpha",
          "thermal diffusivity"
        ],
        [
          "L",
          "rod length"
        ],
        [
          "\\lambda",
          "separation constant"
        ],
        [
          "B_{n}",
          "coefficient fixed by the initial profile"
        ]
      ],
      "note": "The zero-endpoint conditions quantise lambda to n pi / L, and each mode then decays at its own rate, so high harmonics die first."
    },
    "advanced-calculus--jacobian": {
      "type": "derivation",
      "title": "why the polar area element is r dr dtheta",
      "steps": [
        "x=r\\cos\\theta,\\quad y=r\\sin\\theta",
        "\\frac{\\partial(x,y)}{\\partial(r,\\theta)}=\\cos\\theta\\,(r\\cos\\theta)-(-r\\sin\\theta)(\\sin\\theta)",
        "=r\\left(\\cos^{2}\\theta+\\sin^{2}\\theta\\right)=r",
        "dx\\,dy=\\left|\\frac{\\partial(x,y)}{\\partial(r,\\theta)}\\right|dr\\,d\\theta=r\\,dr\\,d\\theta"
      ],
      "symbols": [
        [
          "r",
          "radial distance"
        ],
        [
          "\\theta",
          "polar angle"
        ],
        [
          "J",
          "Jacobian determinant"
        ]
      ],
      "note": "The factor r is the local stretching of a small rectangle at radius r; without it the area element is wrong away from the origin."
    }
  }
