    "artificial-neural-networks--artificial-neuron": {
      "type": "code",
      "lang": "python",
      "title": "one artificial neuron",
      "lines": [
        "import math",
        "",
        "def neuron(x, w, b):",
        "    z = sum(wi * xi for wi, xi in zip(w, x)) + b",
        "    return 1 / (1 + math.exp(-z))",
        "",
        "print(round(neuron([1.0, 2.0], [0.5, -0.5], 0.1), 4))"
      ],
      "highlight": [
        4
      ],
      "output": [
        "0.4013"
      ],
      "note": "The dot product plus bias is the unit's total input z; the sigmoid is the nonlinearity that turns z into the output a."
    },
    "artificial-neural-networks--activation-function": {
      "type": "table",
      "title": "activation functions",
      "headers": [
        "function",
        "f(z)",
        "range",
        "f'(z)",
        "usual role"
      ],
      "rows": [
        [
          "step",
          "1 if z >= 0 else 0",
          "{0, 1}",
          "0 almost everywhere",
          "perceptron output"
        ],
        [
          "sign",
          "-1 if z < 0 else +1",
          "{-1, +1}",
          "0 almost everywhere",
          "ADALINE output"
        ],
        [
          "sigmoid",
          "1 / (1 + e^(-z))",
          "(0, 1)",
          "f(1 - f)",
          "probabilistic output"
        ],
        [
          "tanh",
          "(e^z - e^(-z)) / (e^z + e^(-z))",
          "(-1, 1)",
          "1 - f^2",
          "hidden units"
        ],
        [
          "ReLU",
          "max(0, z)",
          "[0, inf)",
          "1 if z > 0 else 0",
          "deep hidden units"
        ],
        [
          "softmax",
          "e^(z_k) / sum_j e^(z_j)",
          "(0, 1), sums to 1",
          "f_k(δ_kj - f_j)",
          "multiclass output"
        ]
      ],
      "highlight": 4,
      "note": "Sigmoid and tanh saturate at both ends, so their slopes shrink toward zero; ReLU keeps a constant slope for positive inputs."
    },
    "artificial-neural-networks--hebb-s-law": {
      "type": "table",
      "title": "learning rules compared",
      "headers": [
        "rule",
