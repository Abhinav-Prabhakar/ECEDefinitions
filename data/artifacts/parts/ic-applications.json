      "highlight": 2,
      "note": "The comparators fire at 1/3 and 2/3 V_CC, so every timing formula contains ln 2 = 0.69 or ln 3 = 1.1."
    },
    "ic-applications--phase-locked-loop": {
      "type": "sequence",
      "title": "PLL lock acquisition",
      "actors": [
        "reference",
        "phase detector",
        "loop filter",
        "VCO"
      ],
      "steps": [
        {
          "from": 0,
          "to": 1,
          "label": "reference edge arrives"
        },
        {
          "from": 1,
          "to": 2,
          "label": "error voltage follows the phase difference"
        },
        {
          "from": 2,
          "to": 3,
          "label": "filtered DC sets the VCO frequency"
        },
        {
          "from": 3,
          "to": 1,
          "label": "VCO output returns to the detector"
        },
        {
          "from": 1,
          "to": 2,
          "label": "phase error narrows, control settles"
        },
        {
          "from": 2,
          "to": 3,
          "label": "VCO frequency equals reference: locked"
        }
      ],
      "note": "Lock is declared when the phase error stops changing, which is stricter than the two frequencies merely matching."
    },
