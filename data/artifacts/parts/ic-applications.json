    "ic-applications--dac-resolution": {
      "type": "derivation",
      "title": "DAC step size and resolution",
      "steps": [
        "\\text{LSB}=\\frac{V_{FS}}{2^{n}-1}",
        "V_{o}=V_{FS}\\frac{D}{2^{n}-1},\\quad D=\\sum_{i=0}^{n-1}b_{i}2^{i}",
        "\\text{fractional resolution}=\\frac{1}{2^{n}-1}",
        "n=8,\\ V_{FS}=5\\,\\text{V}:\\ \\text{LSB}=\\frac{5}{255}=19.6\\,\\text{mV}"
      ],
      "symbols": [
        [
          "n",
          "number of bits"
        ],
        [
          "V_{FS}",
          "full-scale voltage"
        ],
        [
          "D",
          "digital input code"
        ],
        [
          "b_{i}",
          "bit i of the input"
        ]
      ],
      "note": "Each extra bit halves the step, so resolution in volts improves by 6 dB per bit."
    },
