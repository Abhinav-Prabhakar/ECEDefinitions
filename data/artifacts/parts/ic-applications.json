    "ic-applications--butterworth-filter": {
      "type": "derivation",
      "title": "order needed for a Butterworth response",
      "steps": [
        "|H|^{2}=\\frac{1}{1+\\left(\\omega/\\omega_{c}\\right)^{2n}}",
        "A(\\omega)=-10\\log_{10}\\left[1+\\left(\\omega/\\omega_{c}\\right)^{2n}\\right]",
        "\\frac{10^{A_{s}/10}-1}{10^{A_{p}/10}-1}=\\left(\\frac{\\omega_{s}}{\\omega_{p}}\\right)^{2n}",
        "n\\ge\\frac{\\log_{10}\\left[\\left(10^{A_{s}/10}-1\\right)/\\left(10^{A_{p}/10}-1\\right)\\right]}{2\\log_{10}\\left(\\omega_{s}/\\omega_{p}\\right)}"
      ],
      "symbols": [
        [
          "n",
          "filter order"
        ],
        [
          "A_{p}",
          "passband attenuation in dB"
        ],
        [
          "A_{s}",
          "stopband attenuation in dB"
        ],
        [
          "\\omega_{p}",
          "passband edge"
        ],
        [
          "\\omega_{s}",
          "stopband edge"
        ]
      ],
      "note": "With 3 dB at ω_p and 40 dB at 2ω_p the bound gives n ≥ 6.6, so a seventh-order section is required."
    },
    "ic-applications--schmitt-trigger": {
      "type": "derivation",
      "title": "hysteresis of an inverting Schmitt trigger",
      "steps": [
        "V_{+}=V_{o}\\frac{R_{1}}{R_{1}+R_{2}}+V_{\\text{ref}}\\frac{R_{2}}{R_{1}+R_{2}}",
        "V_{UT}=+V_{\\text{sat}}\\frac{R_{1}}{R_{1}+R_{2}}",
        "V_{LT}=-V_{\\text{sat}}\\frac{R_{1}}{R_{1}+R_{2}}",
        "V_{H}=V_{UT}-V_{LT}=\\frac{2V_{\\text{sat}}R_{1}}{R_{1}+R_{2}}"
      ],
      "symbols": [
        [
          "R_{1}",
          "divider resistor to ground"
        ],
        [
          "R_{2}",
          "feedback resistor"
        ],
        [
          "V_{\\text{sat}}",
          "output saturation voltage"
        ],
        [
          "V_{H}",
          "hysteresis width"
        ],
        [
          "V_{\\text{ref}}",
          "optional offset reference"
        ]
      ],
      "note": "Hysteresis depends only on the divider ratio, and the two trip points sit symmetrically about V_ref."
    }
  }
