    "ic-applications--instrumentation-amplifier": {
      "type": "derivation",
      "title": "three-op-amp instrumentation gain",
      "steps": [
        "i_{G}=\\frac{V_{2}-V_{1}}{R_{G}}",
        "v_{o1}=V_{1}-i_{G}R,\\quad v_{o2}=V_{2}+i_{G}R",
        "v_{o2}-v_{o1}=\\left(V_{2}-V_{1}\\right)\\left(1+\\frac{2R}{R_{G}}\\right)",
        "V_{o}=v_{o2}-v_{o1}"
      ],
      "symbols": [
        [
          "R_{G}",
          "gain-setting resistor"
        ],
        [
          "R",
          "input-stage feedback resistor"
        ],
        [
          "v_{o1},v_{o2}",
          "first-stage outputs"
        ],
        [
          "V_{o}",
          "final single-ended output"
        ]
      ],
      "note": "Only R_G sets the gain, so one resistor or a switch changes range without unbalancing the CMRR."
    },
