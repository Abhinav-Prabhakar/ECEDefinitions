    "cyber-security--dos-attack": {
      "type": "sequence",
      "title": "SYN-flood denial of service",
      "actors": [
        "attacker",
        "victim",
        "backlog"
      ],
      "steps": [
        {
          "from": 0,
          "to": 1,
          "label": "SYN with a spoofed source address"
        },
        {
          "from": 1,
          "to": 0,
          "label": "SYN-ACK sent to the forged address"
        },
        {
          "from": 0,
          "to": 1,
          "label": "no ACK is returned"
        },
        {
          "from": 1,
          "to": 2,
          "label": "half-open entry held until timeout"
        },
        {
          "from": 2,
          "to": 1,
          "label": "backlog table fills"
        },
        {
          "from": 0,
          "to": 1,
          "label": "fresh SYNs; legitimate clients refused"
        }
      ],
      "note": "Each spoofed SYN occupies a backlog slot until it times out; once full, valid clients are refused before their handshake completes."
    },
    "cyber-security--non-repudiation": {
      "type": "sequence",
      "title": "signature and verification",
      "actors": [
        "CA",
        "signer",
        "verifier"
      ],
      "steps": [
        {
          "from": 0,
          "to": 1,
          "label": "certificate binds identity to PK_A"
        },
        {
          "from": 1,
          "to": 2,
          "label": "m and sigma = Sign(SK_A, H(m))"
        },
        {
          "from": 2,
          "to": 0,
          "label": "check certificate revocation"
        },
        {
          "from": 0,
          "to": 2,
          "label": "PK_A valid"
        },
        {
          "from": 2,
          "to": 1,
          "label": "accept if Verify(PK_A, m, sigma) = 1"
        }
      ],
      "note": "Only the signer holds SK_A, so a valid signature cannot be forged by the verifier and the signer cannot deny signing."
    },
    "cyber-security--integrity": {
      "type": "code",
      "lang": "python",
      "title": "SHA-256 integrity check",
      "lines": [
        "import hashlib",
        "",
        "def digest(data):",
        "    return hashlib.sha256(data).hexdigest()",
        "",
        "sent = b\"transfer 100 to account 42\"",
        "received = b\"transfer 900 to account 42\"",
        "print(digest(sent) == digest(received))"
      ],
      "highlight": [
        8
      ],
      "output": [
        "False"
      ],
      "note": "Recomputing the digest of the received bytes and comparing it with the sender digest exposes any modification."
    },
