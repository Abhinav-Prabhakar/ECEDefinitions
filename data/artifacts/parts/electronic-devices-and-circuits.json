    "electronic-devices-and-circuits--ripple-factor": {
      "type": "derivation",
      "title": "ripple factor of a half-wave rectifier",
      "steps": [
        "V_{\\text{dc}}=\\frac{1}{2\\pi}\\int_{0}^{\\pi}V_{m}\\sin\\theta\\,d\\theta=\\frac{V_{m}}{\\pi}",
        "V_{\\text{rms}}=\\sqrt{\\frac{1}{2\\pi}\\int_{0}^{\\pi}V_{m}^{2}\\sin^{2}\\theta\\,d\\theta}=\\frac{V_{m}}{2}",
        "r=\\sqrt{\\left(\\frac{V_{\\text{rms}}}{V_{\\text{dc}}}\\right)^{2}-1}=\\sqrt{\\left(\\frac{\\pi}{2}\\right)^{2}-1}",
        "r=\\sqrt{2.467-1}=1.21"
      ],
      "symbols": [
        [
          "V_{m}",
          "peak secondary voltage"
        ],
        [
          "V_{\\text{dc}}",
          "average output voltage"
        ],
        [
          "V_{\\text{rms}}",
          "rms output voltage"
        ],
        [
          "r",
          "ripple factor"
        ]
      ],
      "note": "Repeating the integral with period π/2 for a full-wave output gives r = 0.48 instead of 1.21."
    },
