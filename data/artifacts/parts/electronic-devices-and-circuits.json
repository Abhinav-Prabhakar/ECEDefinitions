    "electronic-devices-and-circuits--multistage-amplifier": {
      "type": "derivation",
      "title": "cascaded gain and bandwidth",
      "steps": [
        "A_{v}=A_{v1}A_{v2}\\cdots A_{vn}",
        "A_{v}(\\text{dB})=20\\log_{10}|A_{v}|=\\sum_{k=1}^{n}20\\log_{10}|A_{vk}|",
        "f_{H}=f_{H1}\\sqrt{2^{1/n}-1},\\quad f_{L}=\\frac{f_{L1}}{\\sqrt{2^{1/n}-1}}",
        "BW=f_{H}-f_{L}\\approx f_{H1}\\sqrt{2^{1/n}-1}"
      ],
      "symbols": [
        [
          "A_{vk}",
          "gain of stage k"
        ],
        [
          "f_{H1}",
          "single-stage upper cut-off"
        ],
        [
          "n",
          "number of stages"
        ],
        [
          "BW",
          "overall bandwidth"
        ]
      ],
      "note": "Two identical stages put the overall -3 dB point at 0.64 f_H1, so cascading trades bandwidth for gain."
    },
    "electronic-devices-and-circuits--zener-diode": {
      "type": "derivation",
      "title": "sizing the zener series resistor",
      "steps": [
        "V_{S}=I_{S}R_{S}+V_{Z},\\quad I_{S}=I_{Z}+I_{L}",
        "I_{Z}=\\frac{V_{S}-V_{Z}}{R_{S}}-I_{L}",
        "R_{S}=\\frac{V_{S,\\min}-V_{Z}}{I_{Z,\\min}+I_{L,\\max}}",
        "P_{R_{S}}=\\frac{\\left(V_{S,\\max}-V_{Z}\\right)^{2}}{R_{S}}"
      ],
      "symbols": [
        [
          "V_{S}",
          "unregulated input"
        ],
        [
          "V_{Z}",
          "zener voltage"
        ],
        [
          "R_{S}",
          "series resistor"
        ],
        [
          "I_{Z,\\min}",
          "minimum zener current for regulation"
        ],
        [
          "I_{L,\\max}",
          "maximum load current"
        ]
      ],
      "note": "The worst case for R_S is minimum input with full load; the worst case for its power is maximum input with no load."
    }
