    "electronic-devices-and-circuits--hybrid-pi-model": {
      "type": "derivation",
      "title": "hybrid-pi parameters at the bias point",
      "steps": [
        "g_{m}=\\frac{\\partial I_{C}}{\\partial V_{BE}}=\\frac{I_{S}}{V_{T}}e^{V_{BE}/V_{T}}=\\frac{I_{C}}{V_{T}}",
        "r_{\\pi}=\\frac{v_{be}}{i_{b}}=\\frac{v_{be}}{i_{c}/\\beta}=\\frac{\\beta}{g_{m}}",
        "r_{\\pi}=\\frac{\\beta V_{T}}{I_{C}}=\\frac{\\beta\\,(26\\,\\text{mV})}{I_{C}}",
        "r_{o}=\\frac{V_{A}+V_{CE}}{I_{C}}\\approx\\frac{V_{A}}{I_{C}}"
      ],
      "symbols": [
        [
          "g_{m}",
          "transconductance"
        ],
        [
          "r_{\\pi}",
          "base-emitter resistance"
        ],
        [
          "r_{o}",
          "output resistance"
        ],
        [
          "V_{A}",
          "Early voltage"
        ],
        [
          "V_{T}",
          "thermal voltage, 26 mV at 300 K"
        ]
      ],
      "note": "At I_C = 1 mA and β = 100, g_m = 38.5 mS and r_pi ≈ 2.6 kΩ, both set by the bias current alone."
    },
