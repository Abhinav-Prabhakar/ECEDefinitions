{
  "subject": "satellite-communication",
  "artifacts": {
    "satellite-communication--kepler-s-third-law": {
      "type": "derivation",
      "title": "period from the circular force balance",
      "steps": [
        "\\frac{\\mu m}{r^{2}}=\\frac{mv^{2}}{r}\\;\\Rightarrow\\;v^{2}=\\frac{\\mu}{r}",
        "T=\\frac{2\\pi r}{v}=2\\pi\\sqrt{\\frac{r^{3}}{\\mu}}",
        "T^{2}=\\frac{4\\pi^{2}}{\\mu}r^{3}\\;\\Rightarrow\\;T^{2}=\\frac{4\\pi^{2}}{\\mu}a^{3}\\ \\text{for an ellipse}",
        "a=42{,}164\\ \\text{km},\\ \\mu=3.986\\times10^{5}\\ \\text{km}^{3}/\\text{s}^{2}\\;\\Rightarrow\\;T=86{,}164\\ \\text{s}"
      ],
      "symbols": [
        [
          "\\mu",
          "gravitational parameter of the primary"
        ],
        [
          "a",
          "semi-major axis"
        ],
        [
          "r",
          "radius of the circular orbit"
        ],
        [
          "T",
          "orbital period"
        ]
      ],
      "note": "The pull supplies the centripetal force; squaring the circular result gives the general ellipse law, and a = 42,164 km returns one sidereal day."
    },
    "satellite-communication--geostationary-transfer-orbit": {
      "type": "derivation",
      "title": "two Hohmann burns into GEO",
      "steps": [
        "a_{t}=\\frac{r_{p}+r_{a}}{2},\\quad v_{p}=\\sqrt{\\mu\\left(\\frac{2}{r_{p}}-\\frac{1}{a_{t}}\\right)}=10.15\\ \\text{km/s}",
        "v_{c,p}=\\sqrt{\\frac{\\mu}{r_{p}}}=7.73\\ \\text{km/s}\\;\\Rightarrow\\;\\Delta v_{1}=10.15-7.73=2.43\\ \\text{km/s}",
        "v_{a}=\\sqrt{\\mu\\left(\\frac{2}{r_{a}}-\\frac{1}{a_{t}}\\right)}=1.61\\ \\text{km/s},\\quad v_{c,a}=\\sqrt{\\frac{\\mu}{r_{a}}}=3.07\\ \\text{km/s}",
        "\\Delta v_{2}=3.07-1.61=1.47\\ \\text{km/s},\\quad \\Delta v_{\\text{tot}}=3.90\\ \\text{km/s}"
      ],
      "symbols": [
        [
          "r_{p}",
          "perigee radius, 6,678 km here"
        ],
        [
          "r_{a}",
          "apogee radius, 42,164 km here"
        ],
        [
          "a_{t}",
          "transfer-orbit semi-major axis"
        ],
        [
          "\\mu",
          "Earth gravitational parameter"
        ]
      ],
      "note": "The first burn raises apogee from a 300 km parking orbit and the second circularises at GEO; the two burns together cost 3.90 km/s."
    },
    "satellite-communication--link-budget": {
      "type": "derivation",
      "title": "worked Ku-band downlink carrier-to-noise",
      "steps": [
        "P_{T}=20\\ \\text{dBW},\\ G_{T}=40\\ \\text{dBi}\\;\\Rightarrow\\;\\text{EIRP}=60\\ \\text{dBW}",
        "L_{\\text{fs}}=20\\log_{10}\\frac{4\\pi d}{\\lambda},\\quad d=3.8\\times10^{7}\\ \\text{m},\\ \\lambda=0.025\\ \\text{m}",
        "L_{\\text{fs}}=20\\log_{10}\\left(1.91\\times10^{10}\\right)=205.6\\ \\text{dB}",
        "C/N_{0}=\\text{EIRP}-L_{\\text{fs}}+G/T-k=60-205.6+30+228.6=113.0\\ \\text{dBHz}"
      ],
      "symbols": [
        [
          "EIRP",
          "transmit power plus antenna gain"
        ],
        [
          "L_{\\text{fs}}",
          "free-space path loss"
        ],
        [
          "G/T",
          "receive antenna gain over system noise temperature, 30 dB/K"
        ],
        [
          "k",
          "Boltzmann constant, -228.6 dBW/K/Hz"
        ],
        [
          "C/N_{0}",
          "carrier power over noise density"
        ]
      ],
      "note": "Across a 36 MHz transponder the 113 dBHz density becomes C/N = 113 - 75.4 = 37.6 dB, far above the roughly 10 dB a QPSK link needs."
    },
    "satellite-communication--parabolic-antenna": {
      "type": "derivation",
      "title": "gain and beamwidth of a dish",
      "steps": [
        "A=\\frac{\\pi D^{2}}{4},\\quad G=\\eta\\frac{4\\pi A}{\\lambda^{2}}=\\eta\\left(\\frac{\\pi D}{\\lambda}\\right)^{2}",
        "D=3\\ \\text{m},\\ \\lambda=0.025\\ \\text{m}\\;\\Rightarrow\\;\\frac{\\pi D}{\\lambda}=377",
        "G=0.65\\times377^{2}=9.24\\times10^{4}\\;\\Rightarrow\\;49.7\\ \\text{dBi}",
        "\\theta_{3\\,\\text{dB}}\\approx\\frac{70^{\\circ}\\lambda}{D}=\\frac{70^{\\circ}\\times0.025}{3}=0.58^{\\circ}"
      ],
      "symbols": [
        [
          "D",
          "dish diameter"
        ],
        [
          "\\lambda",
          "wavelength"
        ],
        [
          "\\eta",
          "aperture efficiency"
        ],
        [
          "\\theta_{3\\,\\text{dB}}",
          "half-power beamwidth"
        ]
      ],
      "note": "At Ku band a 3 m dish gives about 50 dBi in a 0.58 degree beam; the same dish at 4 GHz loses roughly 10 dB and spreads three times wider."
    },
