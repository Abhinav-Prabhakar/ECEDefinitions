    "satellite-communication--position-location": {
      "type": "derivation",
      "title": "linearising the pseudorange equations",
      "steps": [
        "\\rho_{i}=\\sqrt{(x-x_{i})^{2}+(y-y_{i})^{2}+(z-z_{i})^{2}}+b,\\quad i=1,\\dots,n",
        "\\Delta\\rho_{i}=\\frac{x-x_{i}}{r_{i}}\\Delta x+\\frac{y-y_{i}}{r_{i}}\\Delta y+\\frac{z-z_{i}}{r_{i}}\\Delta z+\\Delta b",
        "H\\,\\Delta\\mathbf{x}=\\Delta\\boldsymbol{\\rho},\\quad \\text{row }i\\text{ of }H=\\left[\\mathbf{u}_{i}^{\\mathsf{T}}\\ 1\\right]",
        "\\Delta\\mathbf{x}=\\left(H^{\\mathsf{T}}H\\right)^{-1}H^{\\mathsf{T}}\\Delta\\boldsymbol{\\rho},\\quad n\\ge4"
      ],
      "symbols": [
        [
          "\\rho_{i}",
          "measured pseudorange to satellite i"
        ],
        [
          "r_{i}",
          "true geometric range"
        ],
        [
          "b",
          "receiver clock bias c dt_r"
        ],
        [
          "H",
          "geometry matrix of line-of-sight vectors"
        ],
        [
          "\\mathbf{u}_{i}",
          "unit line-of-sight vector"
        ]
      ],
      "note": "Each satellite gives one equation in four unknowns x, y, z and b; four make the linearised system square and extra satellites overdetermine it."
    },
