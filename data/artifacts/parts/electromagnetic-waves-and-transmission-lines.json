{
  "subject": "electromagnetic-waves-and-transmission-lines",
  "artifacts": {
    "electromagnetic-waves-and-transmission-lines--parallel-plate-capacitor": {
      "type": "derivation",
      "title": "capacitance from Gauss's law",
      "steps": [
        "\\mathbf{E}=\\frac{\\rho_{s}}{\\varepsilon}\\hat{\\mathbf{z}}=\\frac{Q}{\\varepsilon A}\\hat{\\mathbf{z}}",
        "V=-\\int_{0}^{d}\\mathbf{E}\\cdot d\\mathbf{l}=\\frac{Qd}{\\varepsilon A}",
        "C=\\frac{Q}{V}=\\frac{\\varepsilon A}{d}"
      ],
      "symbols": [
        [
          "\\rho_{s}",
          "surface charge density"
        ],
        [
          "A",
          "plate area"
        ],
        [
          "d",
          "plate separation"
        ],
        [
          "\\varepsilon",
          "permittivity of the dielectric"
        ]
      ],
      "note": "Fringing is ignored, so the result holds only while d stays much smaller than the plate dimensions."
    },
    "electromagnetic-waves-and-transmission-lines--relaxation-time": {
      "type": "derivation",
      "title": "charge decay from continuity and Ohm's law",
      "steps": [
        "\\nabla\\cdot\\mathbf{J}=-\\frac{\\partial\\rho}{\\partial t},\\qquad \\mathbf{J}=\\sigma\\mathbf{E}",
        "\\nabla\\cdot\\mathbf{E}=\\frac{\\rho}{\\varepsilon}\\ \\Rightarrow\\ \\nabla\\cdot\\mathbf{J}=\\frac{\\sigma\\rho}{\\varepsilon}",
        "\\frac{\\partial\\rho}{\\partial t}=-\\frac{\\sigma}{\\varepsilon}\\rho\\ \\Rightarrow\\ \\rho(t)=\\rho_{0}e^{-t/\\tau}",
        "\\tau=\\frac{\\varepsilon}{\\sigma}"
      ],
      "symbols": [
        [
          "\\rho",
          "volume charge density"
        ],
        [
          "\\sigma",
          "conductivity"
        ],
        [
          "\\varepsilon",
          "permittivity"
        ],
        [
          "\\tau",
          "relaxation time"
        ]
      ],
      "note": "In copper τ is about 1.5×10⁻¹⁹ s, which is why excess charge sits on the surface of a good conductor rather than inside it."
    },
    "electromagnetic-waves-and-transmission-lines--wave-impedance": {
      "type": "derivation",
      "title": "intrinsic impedance from the curl equations",
      "steps": [
        "\\nabla\\times\\mathbf{E}=-j\\omega\\mu\\mathbf{H},\\qquad \\nabla\\times\\mathbf{H}=(\\sigma+j\\omega\\varepsilon)\\mathbf{E}",
        "\\gamma^{2}=j\\omega\\mu(\\sigma+j\\omega\\varepsilon),\\qquad \\gamma=\\alpha+j\\beta",
        "\\eta=\\frac{E}{H}=\\frac{j\\omega\\mu}{\\gamma}=\\sqrt{\\frac{j\\omega\\mu}{\\sigma+j\\omega\\varepsilon}}",
        "\\eta=\\sqrt{\\frac{\\mu}{\\varepsilon}}\\ \\text{(lossless)},\\qquad \\eta_{0}=120\\pi\\approx 377\\ \\Omega"
      ],
      "symbols": [
        [
          "\\gamma",
          "propagation constant"
        ],
        [
          "\\eta",
          "intrinsic impedance of the medium"
        ],
        [
          "\\mu,\\ \\varepsilon",
          "medium constants"
        ],
        [
          "\\omega",
          "angular frequency"
        ]
      ],
      "note": "Both fields share the same γ, so their ratio is fixed by the medium alone and not by the source that launched the wave."
    },
    "electromagnetic-waves-and-transmission-lines--poynting-vector": {
      "type": "derivation",
      "title": "average power density of a plane wave",
      "steps": [
        "\\mathbf{S}(t)=\\mathbf{E}(t)\\times\\mathbf{H}(t)",
        "\\langle\\mathbf{S}\\rangle=\\frac{1}{2}\\operatorname{Re}\\left\\{\\mathbf{E}\\times\\mathbf{H}^{*}\\right\\}",
        "\\langle\\mathbf{S}\\rangle=\\frac{E_{0}^{2}}{2\\eta}\\hat{\\mathbf{k}}=\\frac{1}{2}\\eta H_{0}^{2}\\hat{\\mathbf{k}}"
      ],
      "symbols": [
        [
          "\\mathbf{S}",
          "instantaneous Poynting vector"
        ],
        [
          "\\langle\\mathbf{S}\\rangle",
          "time-average power density, W/m²"
        ],
        [
          "E_{0},\\ H_{0}",
          "peak field amplitudes"
        ],
        [
          "\\hat{\\mathbf{k}}",
          "direction of propagation"
        ]
      ],
      "note": "The factor 1/2 comes from averaging the sinusoid: a 1 V/m peak wave in free space carries 1.33 mW/m²."
    },
    "electromagnetic-waves-and-transmission-lines--vswr": {
      "type": "derivation",
      "title": "from reflection coefficient to VSWR and return loss",
      "steps": [
        "\\Gamma=\\frac{Z_{L}-Z_{0}}{Z_{L}+Z_{0}},\\qquad |\\Gamma|\\le 1",
        "V_{\\max}=|V^{+}|\\left(1+|\\Gamma|\\right),\\qquad V_{\\min}=|V^{+}|\\left(1-|\\Gamma|\\right)",
        "\\text{VSWR}=\\frac{V_{\\max}}{V_{\\min}}=\\frac{1+|\\Gamma|}{1-|\\Gamma|}",
        "|\\Gamma|=\\frac{\\text{VSWR}-1}{\\text{VSWR}+1},\\qquad \\text{RL}=-20\\log_{10}|\\Gamma|\\ \\text{dB}"
      ],
      "symbols": [
        [
          "\\Gamma",
          "load reflection coefficient"
        ],
        [
          "VSWR",
          "voltage standing-wave ratio"
        ],
        [
          "RL",
          "return loss"
        ],
        [
          "V^{+}",
          "forward travelling voltage amplitude"
        ]
      ],
      "note": "A VSWR of 2 means |Γ| = 1/3 and 11% of the incident power returns, which is why 2:1 is the usual acceptance limit."
    },
    "electromagnetic-waves-and-transmission-lines--characteristic-impedance": {
      "type": "derivation",
      "title": "Z0 from the telegrapher's equations",
      "steps": [
        "-\\frac{\\partial V}{\\partial z}=RI+L\\frac{\\partial I}{\\partial t},\\qquad -\\frac{\\partial I}{\\partial z}=GV+C\\frac{\\partial V}{\\partial t}",
        "V(z)=V^{+}e^{-\\gamma z}+V^{-}e^{\\gamma z},\\qquad I(z)=\\frac{V^{+}}{Z_{0}}e^{-\\gamma z}-\\frac{V^{-}}{Z_{0}}e^{\\gamma z}",
        "\\gamma=\\sqrt{(R+j\\omega L)(G+j\\omega C)},\\qquad Z_{0}=\\sqrt{\\frac{R+j\\omega L}{G+j\\omega C}}",
        "Z_{0}=\\sqrt{\\frac{L}{C}},\\qquad v_{p}=\\frac{1}{\\sqrt{LC}}\\ \\text{(lossless)}"
      ],
      "symbols": [
        [
          "R,L,G,C",
          "per-unit-length line parameters"
        ],
        [
          "\\gamma",
          "propagation constant"
        ],
        [
          "Z_{0}",
          "characteristic impedance"
        ],
        [
          "v_{p}",
          "phase velocity"
        ]
      ],
      "note": "Z0 is not the resistance of the wire: it is the fixed ratio a travelling wave settles at, set by the per-length inductance and capacitance."
    },
    "electromagnetic-waves-and-transmission-lines--matched-line": {
      "type": "table",
      "title": "load terminations on a lossless line",
      "headers": [
        "load",
        "Γ",
        "VSWR",
        "voltage pattern"
      ],
      "rows": [
        [
          "short, Z_L = 0",
          "-1",
          "infinite",
          "node at the load"
        ],
        [
          "open, Z_L = infinite",
          "+1",
          "infinite",
          "antinode at the load"
        ],
        [
          "matched, Z_L = Z_0",
          "0",
          "1",
          "flat, no standing wave"
        ],
        [
          "Z_L = 2Z_0",
          "+1/3",
          "2",
          "2:1 maximum at the load"
        ],
        [
          "Z_L = Z_0/2",
          "-1/3",
          "2",
          "2:1 minimum at the load"
        ]
      ],
      "highlight": 3,
      "note": "Only |Γ| sets the VSWR; its sign decides whether the load sits at a voltage maximum or a minimum."
    },
    "electromagnetic-waves-and-transmission-lines--maxwells-equations": {
      "type": "table",
      "title": "Maxwell's equations, differential and integral form",
      "headers": [
        "law",
        "differential",
        "integral",
        "statement"
      ],
      "rows": [
        [
          "Faraday",
          "∇×E = -∂B/∂t",
          "∮E·dl = -dΦ_B/dt",
          "changing flux drives an emf"
        ],
        [
          "Ampere-Maxwell",
          "∇×H = J + ∂D/∂t",
          "∮H·dl = I + dΨ_D/dt",
          "current and displacement current drive H"
        ],
        [
          "Gauss",
          "∇·D = ρ",
          "∮D·dS = Q_enc",
          "charge is the source of D"
        ],
        [
          "Gauss magnetism",
          "∇·B = 0",
          "∮B·dS = 0",
          "no magnetic monopoles"
        ]
      ],
      "highlight": 2,
      "note": "The displacement term is Maxwell's addition: without it a charging capacitor would break the continuity of current."
    }
  }
}
