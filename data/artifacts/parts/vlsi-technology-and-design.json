    "vlsi-technology-and-design--non-blocking-assignment": {
      "type": "code",
      "lang": "verilog",
      "title": "blocking vs non-blocking in a shift register",
      "lines": [
        "always @(posedge clk) begin",
        "  q1 <= d;      // scheduled for the end of the time step",
        "  q2 <= q1;     // samples the OLD q1",
        "end",
        "",
        "always @(posedge clk) begin",
        "  r1 = d;       // blocking: executes immediately",
        "  r2 = r1;      // r2 takes the NEW r1",
        "end"
      ],
      "highlight": [
        2,
        3
      ],
      "note": "With <= the two flops form a shift register; with = they collapse into one stage, and r2 simply follows d."
    },
    "vlsi-technology-and-design--cmos-inverter": {
      "type": "derivation",
      "title": "switching threshold from equal drain currents",
      "steps": [
        "I_{Dn}=I_{Dp},\\qquad V_{GSn}=V_{M},\\quad V_{SGp}=V_{DD}-V_{M}",
        "\\frac{\\mu_{n}C_{ox}}{2}\\frac{W_{n}}{L}(V_{M}-V_{tn})^{2}=\\frac{\\mu_{p}C_{ox}}{2}\\frac{W_{p}}{L}(V_{DD}-V_{M}-|V_{tp}|)^{2}",
        "\\sqrt{\\frac{\\mu_{n}W_{n}}{\\mu_{p}W_{p}}}\\left(V_{M}-V_{tn}\\right)=V_{DD}-V_{M}-|V_{tp}|",
        "V_{M}=\\frac{V_{DD}+V_{tn}+|V_{tp}|}{2}\\quad\\text{when}\\ \\mu_{n}W_{n}=\\mu_{p}W_{p}"
      ],
      "symbols": [
        [
          "V_{M}",
          "switching threshold"
        ],
        [
          "V_{tn},\\ V_{tp}",
          "nMOS and pMOS threshold voltages"
        ],
        [
          "W_{n},\\ W_{p}",
          "device widths, same L"
        ]
      ],
      "note": "Equal strengths put the trip point halfway; widening the NMOS pulls V_M down and makes the gate harder to switch low."
    },
