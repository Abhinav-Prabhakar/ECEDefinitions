    "vlsi-technology-and-design--oxidation": {
      "type": "derivation",
      "title": "Deal-Grove: linear then parabolic growth",
      "steps": [
        "F_{1}=h(C^{*}-C_{s}),\\quad F_{2}=\\frac{D_{ox}}{x_{ox}}(C_{s}-C_{i}),\\quad F_{3}=k_{s}C_{i}",
        "B=\\frac{2D_{ox}C^{*}}{N_{1}},\\qquad A=2D_{ox}\\left(\\frac{1}{k_{s}}+\\frac{1}{h}\\right)",
        "F_{1}=F_{2}=F_{3}=F\\ \\Rightarrow\\ \\frac{dx_{ox}}{dt}=\\frac{F}{N_{1}}=\\frac{B}{A+2x_{ox}}",
        "\\int_{0}^{x_{ox}}(A+2x)\\,dx=B\\,t\\ \\Rightarrow\\ x_{ox}^{2}+Ax_{ox}=B\\,t",
        "x_{ox}\\approx\\frac{B}{A}t\\ \\text{(thin)},\\qquad x_{ox}\\approx\\sqrt{Bt}\\ \\text{(thick)}"
      ],
      "symbols": [
        [
          "x_{ox}",
          "oxide thickness"
        ],
        [
          "C^{*}",
          "equilibrium oxidant concentration in the gas"
        ],
        [
          "D_{ox}",
          "oxidant diffusivity in the oxide"
        ],
        [
          "k_{s}",
          "surface reaction rate"
        ],
        [
          "N_{1}",
          "oxidant molecules per unit oxide volume"
        ]
      ],
      "note": "Thin oxides are reaction-limited and grow linearly; thick ones are diffusion-limited and grow as √t, so the same furnace gives both regimes."
    },
    "vlsi-technology-and-design--rc-delay": {
      "type": "derivation",
      "title": "0.69RC and the Elmore sum",
      "steps": [
        "V_{out}(t)=V_{DD}\\left(1-e^{-t/RC}\\right)",
        "V_{out}=V_{DD}/2\\ \\Rightarrow\\ e^{-t_{p}/RC}=\\tfrac{1}{2}",
        "t_{p}=RC\\ln 2\\approx 0.69\\,RC",
        "\\tau_{\\text{Elmore}}=\\sum_{i=1}^{N}R_{i}C_{i},\\qquad t_{p}\\approx 0.69\\,\\tau_{\\text{Elmore}}"
      ],
      "symbols": [
        [
          "R",
          "driver equivalent resistance"
        ],
        [
          "C",
          "total load capacitance"
        ],
        [
          "R_{i},\\ C_{i}",
          "resistance to node i, capacitance at node i"
        ]
      ],
      "note": "A single pole reaches 50% at 0.69τ; the Elmore sum generalises that to a whole RC ladder with one multiply."
    },
