    "cmos-analog-ic-design--subthreshold-slope": {
      "type": "derivation",
      "title": "where the 60 mV/decade comes from",
      "steps": [
        "I_{D}=I_{0}\\frac{W}{L}e^{(V_{GS}-V_{TH})/(nV_{T})}",
        "S=\\frac{dV_{GS}}{d\\log_{10}I_{D}}=\\ln(10)\\,nV_{T}",
        "n=1+\\frac{C_{dep}}{C_{ox}},\\qquad V_{T}=\\frac{kT}{q}",
        "S=\\frac{kT}{q}\\ln(10)\\left(1+\\frac{C_{dep}}{C_{ox}}\\right)\\approx 60\\ \\text{mV/dec}"
      ],
      "symbols": [
        [
          "S",
          "subthreshold swing"
        ],
        [
          "n",
          "body-effect coefficient"
        ],
        [
          "C_{dep}",
          "depletion capacitance under the channel"
        ],
        [
          "C_{ox}",
          "oxide capacitance per unit area"
        ],
        [
          "V_{T}",
          "thermal voltage kT/q"
        ]
      ],
      "note": "The floor is ln(10)·kT/q, about 60 mV per decade at 300 K; body effect (n > 1) is what pushes a real device above it."
    },
    "cmos-analog-ic-design--intrinsic-gain": {
      "type": "derivation",
      "title": "intrinsic gain eliminates the bias current",
      "steps": [
        "A_{v}=g_{m}r_{o}",
        "g_{m}=\\frac{\\partial I_{D}}{\\partial V_{GS}}=\\mu_{n}C_{ox}\\frac{W}{L}V_{OV}=\\frac{2I_{D}}{V_{OV}}",
        "r_{o}=\\frac{\\partial V_{DS}}{\\partial I_{D}}=\\frac{V_{A}}{I_{D}}",
        "A_{v}=\\frac{2I_{D}}{V_{OV}}\\cdot\\frac{V_{A}}{I_{D}}=\\frac{2V_{A}}{V_{OV}}"
      ],
      "symbols": [
        [
          "V_{A}",
          "Early voltage"
        ],
        [
          "V_{OV}",
          "overdrive V_GS − V_TH"
        ],
        [
          "I_{D}",
          "bias current"
        ]
      ],
      "note": "I_D cancels, so intrinsic gain is fixed by Early voltage and overdrive alone: more current buys speed, never more gain."
    },
    "cmos-analog-ic-design--thermal-noise": {
      "type": "derivation",
      "title": "thermal noise referred to the gate",
      "steps": [
        "\\overline{i_{n}^{2}}=4kT\\,G_{\\text{eff}}\\,\\Delta f",
        "G_{\\text{eff}}=\\gamma g_{m},\\qquad \\gamma=\\tfrac{2}{3}\\ \\text{(long channel)}",
        "\\overline{i_{n}^{2}}=4kT\\gamma g_{m}\\,\\Delta f",
        "\\overline{v_{n}^{2}}=\\frac{\\overline{i_{n}^{2}}}{g_{m}^{2}}=\\frac{4kT\\gamma}{g_{m}}\\Delta f"
      ],
      "symbols": [
        [
          "k",
          "Boltzmann constant"
        ],
        [
          "\\gamma",
          "channel thermal-noise coefficient"
        ],
        [
          "g_{m}",
          "transconductance"
        ],
        [
          "\\Delta f",
          "measurement bandwidth"
        ]
      ],
      "note": "Noise is a conductance effect, so referring it to the gate divides by g_m²: the input pair is made high-g_m to push the floor down."
    },
    "cmos-analog-ic-design--bandgap-voltage-reference": {
      "type": "derivation",
      "title": "CTAT plus PTAT cancels the temperature drift",
      "steps": [
        "V_{BE}(T)=V_{BE0}-\\alpha T,\\qquad \\frac{\\partial V_{BE}}{\\partial T}\\approx -2\\ \\text{mV/K}",
        "\\Delta V_{BE}=V_{BE1}-V_{BE2}=\\frac{kT}{q}\\ln N",
        "V_{ref}=V_{BE}+K\\Delta V_{BE}=V_{BE0}-\\alpha T+K\\frac{k}{q}\\ln N\\,T",
        "\\frac{\\partial V_{ref}}{\\partial T}=0\\ \\Rightarrow\\ K=\\frac{\\alpha q}{k\\ln N}",
        "V_{ref}=V_{BE0}\\approx 1.2\\ \\text{V}\\quad\\text{(band gap extrapolated to 0 K)}"
      ],
      "symbols": [
        [
          "K",
          "PTAT gain set by a resistor ratio"
        ],
        [
          "N",
          "current-density ratio of the two junctions"
        ],
        [
          "\\alpha",
          "CTAT slope ≈ 2 mV/K"
        ],
        [
          "V_{BE0}",
          "junction voltage extrapolated to 0 K"
        ]
      ],
      "note": "The junction voltage falls at about 2 mV/K and the scaled ΔV_BE rises at the same rate; their sum lands near the 1.2 V band gap."
    },
    "cmos-analog-ic-design--latched-comparator": {
      "type": "sequence",
      "title": "latched comparator decision cycle",
      "actors": [
        "clock",
        "input pair",
        "regenerative latch",
        "output"
      ],
      "steps": [
        {
          "from": 0,
          "to": 1,
          "label": "φ = 0: precharge, inputs still tracked"
        },
        {
          "from": 0,
          "to": 2,
          "label": "φ = 0: cross-coupled pair held balanced"
        },
        {
          "from": 0,
          "to": 1,
          "label": "φ rises: input pair samples V_in+ − V_in−"
        },
        {
          "from": 1,
          "to": 2,
          "label": "imbalance ΔI seeds the latch"
        },
        {
          "from": 2,
          "to": 3,
          "label": "regeneration: ΔV grows as e^(t/τ_reg)"
        },
        {
          "from": 0,
          "to": 3,
          "label": "φ falls: outputs reset for the next decision"
        }
      ],
      "note": "Resolution time is exponential in the seed, so a small input difference costs only a little extra regeneration time."
    }
  }
}
