        [
          "triode",
          "V_DS < V_OV",
          "µ_nC_ox(W/L)(V_OV − V_DS/2)V_DS",
          "µ_nC_ox(W/L)V_DS",
          "active resistor, closed switch"
        ],
        [
          "saturation",
          "V_DS ≥ V_OV",
          "½µ_nC_ox(W/L)V_OV²(1+λV_DS)",
          "µ_nC_ox(W/L)V_OV",
