    "advanced-entrepreneurship--customer-lifetime-value": {
      "type": "derivation",
      "title": "lifetime value and the LTV/CAC test",
      "steps": [
        "\\text{ARPU}=\\frac{\\text{monthly revenue}}{\\text{active customers}}",
        "\\text{average life}=\\frac{1}{c}",
        "\\text{LTV}=\\text{ARPU}\\times\\frac{1}{c}=\\frac{500}{0.02}",
        "\\text{LTV}=25000",
        "\\frac{\\text{LTV}}{\\text{CAC}}=\\frac{25000}{6000}\\approx 4.2"
      ],
      "symbols": [
        [
          "\\text{ARPU}",
          "revenue per active customer per month"
        ],
        [
          "c",
          "monthly churn rate, 0.02 here"
        ],
        [
          "\\text{LTV}",
          "revenue expected from one customer"
        ],
        [
          "\\text{CAC}",
          "cost of winning one customer"
        ]
      ],
      "note": "At 4.2:1 each rupee of acquisition spend returns about four over the customer's life; below 3:1 growth usually burns cash."
    },
    "advanced-entrepreneurship--economic-value-added": {
      "type": "table",
      "title": "six numbers an investor rechecks after the pitch",
      "headers": [
        "metric",
        "formula",
        "a bad reading means"
      ],
      "rows": [
        [
          "gross margin",
          "(revenue - COGS) / revenue",
          "pricing power too weak"
        ],
        [
          "EBIT margin",
          "EBIT / revenue",
          "overheads outgrowing sales"
        ],
        [
          "interest cover",
          "EBIT / interest",
          "one bad quarter from default"
        ],
        [
          "AR days",
          "receivables / revenue x 365",
          "sales booked but not collected"
        ],
        [
          "EVA",
          "NOPAT - WACC x capital employed",
          "growth that destroys value"
        ],
        [
          "net cash flow",
          "inflows - outflows",
          "profitable on paper, short of cash"
        ]
      ],
      "highlight": 5,
      "note": "EBIT ignores how the firm is financed and EVA does not, which is why a profitable firm can still destroy value."
    }
  }
