      "rows": [
        [
          "SaaS",
          "per-seat or tiered subscription",
          "MRR, net revenue retention",
          "churn after onboarding"
        ],
        [
          "freemium",
          "subscription from the paying minority",
          "free-to-paid conversion",
          "free tier costs outrun conversion"
        ],
        [
          "marketplace",
          "commission on each transaction",
          "GMV, take rate, liquidity",
          "cold-start chicken and egg"
        ],
