    },
    "antennas-and-wave-propagations--muf": {
      "type": "derivation",
      "title": "secant law, MUF and skip distance",
      "steps": [
        "f_{v}=f\\cos\\theta_{0}",
        "f_{v}=f_{c}\\ \\Rightarrow\\ f_{\\text{MUF}}=\\frac{f_{c}}{\\cos\\theta_{0}}=f_{c}\\sec\\theta_{0}",
        "d_{\\text{skip}}=2h\\tan\\theta_{0}",
        "d_{\\text{skip}}=2h\\sqrt{\\left(\\frac{f_{\\text{MUF}}}{f_{c}}\\right)^{2}-1}"
      ],
      "symbols": [
        [
          "\\theta_{0}",
          "elevation angle at the layer"
        ],
        [
          "f_{c}",
          "critical frequency"
        ],
        [
          "h",
          "virtual height of the reflecting layer"
        ],
        [
          "f_{\\text{MUF}}",
          "maximum usable frequency"
        ]
      ],
      "note": "Above the MUF the ray penetrates the layer instead of returning; below it the skip distance shortens until the ground wave takes over."
    }
  }
}
