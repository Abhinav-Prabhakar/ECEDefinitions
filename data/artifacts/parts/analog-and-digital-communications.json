        ],
        [
          "AMI",
          "B/2",
          "none",
          "poor on long runs of 0",
          "alternating ± pulses"
        ]
      ],
      "highlight": 4,
      "note": "Self-clocking codes spend bandwidth to guarantee transitions, which is why Manchester is used on short links and long-haul systems prefer a scrambler."
    },
    "analog-and-digital-communications--ber": {
      "type": "derivation",
      "title": "BPSK error rate from the decision distance",
      "steps": [
        "r=\\pm\\sqrt{E_{b}}+n,\\qquad n\\sim\\mathcal{N}\\!\\left(0,\\frac{N_{0}}{2}\\right)",
        "d_{\\min}=2\\sqrt{E_{b}},\\qquad \\sigma=\\sqrt{\\frac{N_{0}}{2}}",
        "P_{e}=Q\\!\\left(\\frac{d_{\\min}/2}{\\sigma}\\right)=Q\\!\\left(\\sqrt{\\frac{2E_{b}}{N_{0}}}\\right)",
        "P_{e}=\\frac{1}{2}\\operatorname{erfc}\\!\\left(\\sqrt{\\frac{E_{b}}{N_{0}}}\\right)"
      ],
      "symbols": [
        [
          "E_{b}",
          "energy per bit"
        ],
        [
          "N_{0}",
          "one-sided noise power density"
        ],
        [
          "d_{\\min}",
          "distance between the two symbols"
        ],
        [
          "Q",
          "Gaussian tail probability"
        ]
      ],
      "note": "Coherent BPSK reaches 10⁻⁵ at about 9.6 dB of E_b/N_0; each 3 dB more drops P_e by roughly two orders of magnitude."
    },
