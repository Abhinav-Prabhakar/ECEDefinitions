    "digital-logic-design--jk-flip-flop": {
      "type": "table",
      "title": "Next state and excitation of the four flip-flops",
      "headers": [
        "type",
        "Q(t+1)",
        "excite 0 → 1",
        "excite 1 → 0",
        "toggle"
      ],
      "rows": [
        [
          "SR",
          "S + R'Q",
          "S = 1, R = 0",
          "S = 0, R = 1",
          "not allowed"
        ],
        [
          "JK",
          "J Q' + K' Q",
          "J = 1, K = X",
          "J = X, K = 1",
          "J = K = 1"
        ],
        [
          "D",
          "D",
          "D = 1",
          "D = 0",
          "D = Q'"
        ],
        [
          "T",
          "T ⊕ Q",
          "T = 1",
          "T = 1",
          "T = 1"
        ]
      ],
      "highlight": 2,
      "note": "JK is the universal type: tie J and K for a T stage, or add an inverter ahead of J for a D stage."
    },
    "digital-logic-design--ripple-counter": {
      "type": "derivation",
      "title": "modulus and maximum clock of a ripple counter",
      "steps": [
        "M=2^{n}",
        "t_{\\text{pd}}=n\\,t_{\\text{pd,FF}}",
        "f_{\\max}=\\frac{1}{t_{\\text{pd}}}=\\frac{1}{n\\,t_{\\text{pd,FF}}}",
        "n=4,\\ t_{\\text{pd,FF}}=10\\,\\text{ns}:\\ f_{\\max}=\\frac{1}{40\\,\\text{ns}}=25\\,\\text{MHz}"
      ],
      "symbols": [
        [
          "n",
          "number of flip-flops"
        ],
        [
          "M",
          "modulus, states before repeat"
        ],
        [
          "t_{\\text{pd,FF}}",
          "delay of one flip-flop"
        ],
        [
          "f_{\\max}",
          "highest usable clock"
        ]
      ],
      "note": "Delay accumulates because each stage waits for the one before it, so f_max falls as 1/n."
    },
