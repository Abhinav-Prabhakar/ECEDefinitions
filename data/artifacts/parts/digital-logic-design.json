    "digital-logic-design--shift-register": {
      "type": "code",
      "lang": "verilog",
      "title": "4-bit serial-in serial-out shift register",
      "lines": [
        "module shift4 (input clk, rst, sin, output reg [3:0] q);",
        "  always @(posedge clk) begin",
        "    if (rst) q <= 4'b0000;",
        "    else     q <= {q[2:0], sin};",
        "  end",
        "endmodule"
      ],
      "highlight": 4,
      "note": "The concatenation shifts left by one bit and loads sin into the vacant LSB on every rising edge."
    },
