    "analog-circuits--intrinsic-standoff-ratio": {
      "type": "derivation",
      "title": "peak-point voltage of a UJT",
      "steps": [
        "V_{B1}=\\eta V_{BB}=\\frac{R_{B1}}{R_{B1}+R_{B2}}V_{BB}",
        "V_{P}=V_{B1}+V_{D}\\approx\\eta V_{BB}+0.7\\,\\text{V}",
        "\\eta=\\frac{V_{P}-V_{D}}{V_{BB}}",
        "\\Delta V_{P}=\\eta\\,\\Delta V_{BB}"
      ],
      "symbols": [
        [
          "\\eta",
          "intrinsic stand-off ratio, 0.5 to 0.8"
        ],
        [
          "R_{B1}",
          "base-1 resistance"
        ],
        [
          "V_{BB}",
          "interbase supply"
        ],
        [
          "V_{P}",
          "peak-point voltage"
        ],
        [
          "V_{D}",
          "emitter diode drop, about 0.7 V"
        ]
      ],
      "note": "Because η is fixed by doping, the firing voltage tracks the interbase supply rather than sitting at a fixed value."
    },
    "analog-circuits--desensitivity": {
      "type": "derivation",
      "title": "desensitivity from the closed-loop gain",
      "steps": [
        "A_{f}=\\frac{A}{1+A\\beta}",
        "\\frac{dA_{f}}{dA}=\\frac{1+A\\beta-A\\beta}{\\left(1+A\\beta\\right)^{2}}=\\frac{1}{\\left(1+A\\beta\\right)^{2}}",
        "\\frac{dA_{f}}{A_{f}}=\\frac{1}{1+A\\beta}\\cdot\\frac{dA}{A}",
        "\\frac{dA_{f}}{A_{f}}\\approx\\frac{1}{A\\beta}\\cdot\\frac{dA}{A}\\quad\\text{for }A\\beta\\gg1"
      ],
      "symbols": [
        [
          "A",
          "open-loop gain"
        ],
        [
          "\\beta",
          "feedback factor"
        ],
        [
          "A_{f}",
          "closed-loop gain"
        ],
        [
          "D=1+A\\beta",
          "desensitivity factor"
        ]
      ],
      "note": "A 20% change in open-loop gain becomes 0.2% at Aβ = 100, which is why feedback buys stability with gain."
    },
    "analog-circuits--astable-multivibrator": {
      "type": "derivation",
      "title": "period of a collector-coupled astable",
      "steps": [
        "V_{C}(t)=-V_{CC}+2V_{CC}\\left(1-e^{-t/(R_{B}C)}\\right)",
        "V_{C}=0\\ \\Rightarrow\\ e^{-t/(R_{B}C)}=\\tfrac{1}{2}\\ \\Rightarrow\\ t_{1/2}=R_{B}C\\ln 2",
        "T=2t_{1/2}=2R_{B}C\\ln 2\\approx1.4R_{B}C",
        "T=0.69\\left(R_{B1}C_{1}+R_{B2}C_{2}\\right),\\quad \\text{duty}=\\frac{R_{B1}}{R_{B1}+R_{B2}}"
      ],
      "symbols": [
        [
          "R_{B}",
          "base timing resistor"
        ],
        [
          "C",
          "coupling capacitor"
        ],
        [
          "t_{1/2}",
          "half period"
        ],
        [
          "V_{CC}",
          "supply rail"
        ]
      ],
      "note": "Each half cycle is one RC charge from −V_CC toward +V_CC, crossing zero after exactly ln 2 time constants."
    },
