  ],
  "definitions": [
    {
      "id": "civil-procedure",
      "term": "Civil procedure",
      "definition": "The body of rules that governs how courts conduct civil lawsuits, from filing through appeal.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Commencing a lawsuit",
      "aliases": [],
      "confusables": ["Discovery", "Pleading", "Removal"],
      "sources": ["usll-wex#sec.civil-procedure"]
    },
    {
      "id": "class-action",
      "term": "Class action",
      "definition": "A lawsuit in which one or more plaintiffs represent a larger group holding the same claim against a defendant.",
      "formula": "Fed. R. Civ. P. 23",
      "unit": 1,
      "unitTitle": "Commencing a lawsuit",
      "aliases": [],
      "confusables": ["Complaint", "Counterclaim", "Removal"],
      "sources": ["usll-wex#sec.class-action"]
    },
    {
      "id": "complaint",
      "term": "Complaint",
      "definition": "The pleading that starts a civil case by stating the plaintiff's claims and the relief sought.",
      "formula": "Fed. R. Civ. P. 3",
      "unit": 1,
      "unitTitle": "Commencing a lawsuit",
      "aliases": [],
      "confusables": ["Answer", "Motion", "Summons"],
      "sources": ["usll-frcp#cl.3"]
    },
    {
      "id": "removal",
      "term": "Removal",
      "definition": "A defendant's power to move a case filed in state court into federal court when federal jurisdiction exists.",
      "formula": "28 U.S.C. § 1441",
      "unit": 1,
      "unitTitle": "Commencing a lawsuit",
      "aliases": [],
      "confusables": ["Appeal", "Remand", "Service of process"],
      "sources": ["usll-wex#sec.removal"]
    },
    {
      "id": "service-of-process",
      "term": "Service of process",
      "definition": "The formal delivery of a summons and complaint that gives a court authority over the defendant.",
      "formula": "Fed. R. Civ. P. 4",
      "unit": 1,
      "unitTitle": "Commencing a lawsuit",
      "aliases": [],
      "confusables": ["Answer", "Summons", "Waiver of service"],
      "sources": ["usll-wex#sec.service-of-process"]
    },
    {
      "id": "summons",
      "term": "Summons",
      "definition": "A court-issued paper commanding a defendant to appear and defend within the time stated in it.",
      "formula": "Fed. R. Civ. P. 4(a)",
      "unit": 1,
      "unitTitle": "Commencing a lawsuit",
      "aliases": [],
      "confusables": ["Arrest warrant", "Complaint", "Service of process"],
      "sources": ["usll-frcp#cl.4"]
    },
    {
      "id": "waiver-of-service",
      "term": "Waiver of service",
      "definition": "A defendant's signed agreement to accept the summons and complaint, eliminating the need for formal service.",
      "formula": "Fed. R. Civ. P. 4(d)",
      "unit": 1,
      "unitTitle": "Commencing a lawsuit",
      "aliases": [],
      "confusables": ["Initial appearance", "Service of process", "Summons"],
      "sources": ["usll-frcp#cl.4"]
    },
    {
      "id": "affirmative-defense",
      "term": "Affirmative defense",
      "definition": "A defense pleaded by a defendant that, if proven, defeats liability even when the plaintiff's allegations are true.",
      "formula": "Fed. R. Civ. P. 8(c)",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Answer", "Counterclaim", "Motion to dismiss"],
      "sources": ["usll-frcp#cl.8"]
    },
    {
      "id": "answer",
      "term": "Answer",
      "definition": "The responsive pleading in which a defendant admits or denies each allegation and raises defenses.",
      "formula": "Fed. R. Civ. P. 8(b)",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Affirmative defense", "Complaint", "Counterclaim"],
      "sources": ["usll-frcp#cl.8"]
    },
    {
      "id": "counterclaim",
      "term": "Counterclaim",
      "definition": "A claim a defendant asserts against the plaintiff, compulsory when it arises from the same transaction.",
      "formula": "Fed. R. Civ. P. 13(a)",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Affirmative defense", "Answer", "Crossclaim"],
      "sources": ["usll-frcp#cl.13"]
    },
    {
      "id": "crossclaim",
      "term": "Crossclaim",
      "definition": "A claim one co-party makes against another co-party arising from the same transaction as the action.",
      "formula": "Fed. R. Civ. P. 13(g)",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Answer", "Complaint", "Counterclaim"],
      "sources": ["usll-frcp#cl.13"]
    },
    {
      "id": "motion",
      "term": "Motion",
      "definition": "A formal request asking the court for a ruling or order, stating its grounds and the relief sought.",
      "formula": "Fed. R. Civ. P. 7(b)",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Answer", "Complaint", "Pleading"],
      "sources": ["usll-frcp#cl.7"]
    },
    {
      "id": "motion-to-dismiss",
      "term": "Motion to dismiss",
      "definition": "A pre-answer motion asserting a defect such as lack of jurisdiction or failure to state a claim.",
      "formula": "Fed. R. Civ. P. 12(b)(6)",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Affirmative defense", "Answer", "Summary judgment"],
      "sources": ["usll-frcp#cl.12"]
    },
    {
      "id": "pleading",
      "term": "Pleading",
      "definition": "A formal written statement of claims or defenses allowed by the rules, such as a complaint or answer.",
      "formula": "Fed. R. Civ. P. 7(a)",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Discovery", "Motion", "Summons"],
      "sources": ["usll-frcp#cl.7"]
    },
    {
      "id": "summary-judgment",
      "term": "Summary judgment",
      "definition": "A judgment entered without a trial when no genuine dispute of material fact exists and the movant is entitled to judgment as a matter of law.",
      "formula": "Fed. R. Civ. P. 56",
      "unit": 2,
      "unitTitle": "Pleadings and motions",
      "aliases": [],
      "confusables": ["Default judgment", "Judgment as a matter of law", "Motion to dismiss"],
      "sources": ["usll-frcp#cl.56", "usll-wex#sec.summary-judgment"]
    },
    {
      "id": "deposition",
      "term": "Deposition",
      "definition": "Out-of-court testimony given under oath and recorded for use in the proceeding.",
      "formula": "Fed. R. Civ. P. 30",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Discovery", "Interrogatories", "Request for admission"],
      "sources": ["usll-frcp#cl.30"]
    },
    {
      "id": "discovery",
      "term": "Discovery",
      "definition": "The pretrial phase in which parties obtain relevant, nonprivileged information from each other to prepare for trial.",
      "formula": "Fed. R. Civ. P. 26(b)(1)",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Initial disclosures", "Pleading", "Deposition"],
      "sources": ["usll-frcp#cl.26", "usll-wex#sec.discovery"]
    },
    {
      "id": "initial-disclosures",
      "term": "Initial disclosures",
      "definition": "The exchange of witness names, documents, damages computations, and insurance that each party must make without a request.",
      "formula": "Fed. R. Civ. P. 26(a)(1)",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Discovery", "Interrogatories", "Request for production of documents"],
      "sources": ["usll-frcp#cl.26"]
    },
    {
      "id": "interrogatories",
      "term": "Interrogatories",
      "definition": "Written questions one party serves on another, answered separately and under oath within thirty days.",
      "formula": "Fed. R. Civ. P. 33",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Deposition", "Request for admission", "Request for production of documents"],
      "sources": ["usll-frcp#cl.33"]
    },
    {
      "id": "motion-to-compel",
      "term": "Motion to compel",
      "definition": "A motion asking the court to order a discovery response after a party fails to disclose or answer.",
      "formula": "Fed. R. Civ. P. 37(a)",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Discovery", "Motion to dismiss", "Protective order"],
      "sources": ["usll-frcp#cl.37"]
    },
    {
      "id": "protective-order",
      "term": "Protective order",
      "definition": "A court order limiting or forbidding discovery to protect a person from annoyance, oppression, or undue burden.",
      "formula": "Fed. R. Civ. P. 26(c)",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Discovery", "Initial disclosures", "Motion to compel"],
      "sources": ["usll-frcp#cl.26"]
    },
    {
      "id": "request-for-admission",
      "term": "Request for admission",
      "definition": "A written request that an opposing party admit facts or the genuineness of documents, deemed admitted if unanswered.",
      "formula": "Fed. R. Civ. P. 36",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Initial disclosures", "Interrogatories", "Request for production of documents"],
      "sources": ["usll-frcp#cl.36"]
    },
    {
      "id": "request-for-production-of-documents",
      "term": "Request for production of documents",
      "definition": "A request that a party produce documents, electronically stored information, or tangible items within its possession or control.",
      "formula": "Fed. R. Civ. P. 34",
      "unit": 3,
      "unitTitle": "Discovery",
      "aliases": [],
      "confusables": ["Initial disclosures", "Interrogatories", "Request for admission"],
      "sources": ["usll-frcp#cl.34"]
    },
    {
      "id": "default-judgment",
      "term": "Default judgment",
      "definition": "A judgment entered against a defendant who failed to plead or otherwise defend after being served.",
      "formula": "Fed. R. Civ. P. 55(b)",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": [],
      "confusables": ["Judgment as a matter of law", "Summary judgment", "Voluntary dismissal"],
      "sources": ["usll-frcp#cl.55", "usll-wex#sec.default-judgment"]
    },
    {
      "id": "judgment-as-a-matter-of-law",
      "term": "Judgment as a matter of law",
      "definition": "A court's resolution of an issue against a party whose evidence would not let a reasonable jury find for them.",
      "formula": "Fed. R. Civ. P. 50(a)",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": ["JMOL"],
      "confusables": ["Default judgment", "New trial", "Summary judgment"],
      "sources": ["usll-frcp#cl.50"]
    },
    {
      "id": "new-trial",
      "term": "New trial",
      "definition": "A retrial that the trial court may order on a motion filed within twenty-eight days after judgment.",
      "formula": "Fed. R. Civ. P. 59",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": [],
      "confusables": ["Appeal", "Judgment as a matter of law", "Summary judgment"],
      "sources": ["usll-frcp#cl.59"]
    },
    {
      "id": "preliminary-injunction",
      "term": "Preliminary injunction",
      "definition": "An injunction granted before final judgment, issued only on notice to the adverse party.",
      "formula": "Fed. R. Civ. P. 65(a)",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": [],
      "confusables": ["Default judgment", "Summary judgment", "Temporary restraining order"],
      "sources": ["usll-frcp#cl.65"]
    },
    {
      "id": "temporary-restraining-order",
      "term": "Temporary restraining order",
      "definition": "An emergency order issued without notice when specific facts show immediate and irreparable injury before an opportunity to respond.",
      "formula": "Fed. R. Civ. P. 65(b)",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": ["TRO"],
      "confusables": ["Default judgment", "Preliminary injunction", "Protective order"],
      "sources": ["usll-frcp#cl.65"]
    },
    {
      "id": "verdict",
      "term": "Verdict",
      "definition": "The jury's formal decision on the issues tried, which must be unanimous unless the parties stipulate otherwise.",
      "formula": "Fed. R. Civ. P. 48(b)",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": [],
      "confusables": ["Acquittal", "Judgment as a matter of law", "New trial"],
      "sources": ["usll-frcp#cl.48"]
    },
    {
      "id": "voir-dire",
      "term": "Voir dire",
      "definition": "The questioning of prospective jurors by a judge or lawyer to test their suitability for jury service.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": [],
      "confusables": ["Grand jury", "Summary judgment", "Verdict"],
      "sources": ["usll-wex#sec.voir-dire"]
    },
    {
      "id": "voluntary-dismissal",
      "term": "Voluntary dismissal",
      "definition": "A dismissal the plaintiff files without a court order, made by notice before an answer or summary judgment motion.",
      "formula": "Fed. R. Civ. P. 41(a)",
      "unit": 4,
      "unitTitle": "Trial and judgment",
      "aliases": [],
      "confusables": ["Answer", "Default judgment", "Summary judgment"],
      "sources": ["usll-frcp#cl.41"]
    },
    {
      "id": "appeal",
      "term": "Appeal",
      "definition": "A request that a higher court review a lower court's determination, taken as of right or by permission.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": [],
      "confusables": ["Interlocutory appeal", "Remand", "Removal"],
      "sources": ["usll-wex#sec.appeal"]
    },
    {
      "id": "certiorari",
      "term": "Certiorari",
      "definition": "A writ by which a higher court agrees to review a lower court's decision when review is discretionary.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": ["Writ of certiorari"],
      "confusables": ["Appeal", "Interlocutory appeal", "Remand"],
      "sources": ["usll-wex#sec.certiorari"]
    },
    {
      "id": "collateral-estoppel",
      "term": "Collateral estoppel",
      "definition": "A doctrine barring relitigation of an issue that a prior proceeding validly, finally, and necessarily decided.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": ["Issue preclusion"],
      "confusables": ["Harmless error", "Res judicata", "Standard of review"],
      "sources": ["usll-wex#sec.collateral-estoppel"]
    },
    {
      "id": "harmless-error",
      "term": "Harmless error",
      "definition": "A trial error that an appellate court refuses to reverse because it did not harm the party's right to a fair trial.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": [],
      "confusables": ["Collateral estoppel", "Remand", "Standard of review"],
      "sources": ["usll-wex#sec.harmless-error"]
    },
    {
      "id": "interlocutory-appeal",
      "term": "Interlocutory appeal",
      "definition": "An appeal from a non-final order entered while the case is still proceeding in the trial court.",
      "formula": "28 U.S.C. § 1292(b)",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": [],
      "confusables": ["Appeal", "Certiorari", "Remand"],
      "sources": ["usll-wex#sec.interlocutory-appeal"]
    },
    {
      "id": "remand",
      "term": "Remand",
      "definition": "An appellate court's return of a case to the lower court to reconsider or retry in light of its ruling.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": [],
      "confusables": ["Appeal", "Removal", "Res judicata"],
      "sources": ["usll-wex#sec.remand"]
    },
    {
      "id": "res-judicata",
      "term": "Res judicata",
      "definition": "A doctrine barring a second lawsuit over the same cause of action after a final judgment on the merits.",
      "formula": "Fed. R. Civ. P. 8(c)",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": ["Claim preclusion"],
      "confusables": ["Collateral estoppel", "Harmless error", "Standard of review"],
      "sources": ["usll-wex#sec.res-judicata"]
    },
    {
      "id": "standard-of-review",
      "term": "Standard of review",
      "definition": "The level of scrutiny an appellate court applies when reviewing a lower court's ruling.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Appeals and finality",
      "aliases": [],
      "confusables": ["Appeal", "Harmless error", "Res judicata"],
      "sources": ["usll-wex#sec.standard-of-review"]
    },
    {
      "id": "acquittal",
      "term": "Acquittal",
      "definition": "A resolution of the charged offense's factual elements in the defendant's favor, absolving the defendant from the accusation.",
      "formula": "Fed. R. Crim. P. 29",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": ["Judgment of acquittal"],
      "confusables": ["Appeal", "Plea agreement", "Verdict"],
      "sources": ["usll-wex#sec.acquittal", "usll-frcrmp#cl.29"]
    },
    {
      "id": "arraignment",
      "term": "Arraignment",
      "definition": "The open-court proceeding where the defendant receives the charging document and is asked to enter a plea.",
      "formula": "Fed. R. Crim. P. 10",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": [],
      "confusables": ["Initial appearance", "Plea agreement", "Preliminary hearing"],
      "sources": ["usll-frcrmp#cl.10", "usll-wex#sec.arraignment"]
    },
    {
      "id": "arrest-warrant",
      "term": "Arrest warrant",
      "definition": "A judge's order authorizing an arrest, issued when a complaint and its affidavits establish probable cause.",
      "formula": "Fed. R. Crim. P. 4(a)",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": [],
      "confusables": ["Initial appearance", "Indictment", "Summons"],
      "sources": ["usll-frcrmp#cl.4"]
    },
    {
      "id": "grand-jury",
      "term": "Grand jury",
      "definition": "A group of sixteen to twenty-three citizens who decide whether the prosecutor's evidence supports an indictment.",
      "formula": "Fed. R. Crim. P. 6",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": [],
      "confusables": ["Indictment", "Verdict", "Voir dire"],
      "sources": ["usll-frcrmp#cl.6", "usll-wex#sec.grand-jury"]
    },
    {
      "id": "indictment",
      "term": "Indictment",
      "definition": "A grand jury's written charge formally accusing a person of a crime, required for federal felonies.",
      "formula": "Fed. R. Crim. P. 7(a)",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": [],
      "confusables": ["Arraignment", "Grand jury", "Information"],
      "sources": ["usll-frcrmp#cl.7", "usll-wex#sec.indictment"]
    },
    {
      "id": "information",
      "term": "Information",
      "definition": "A prosecutor's written criminal charge filed without a grand jury after the defendant waives indictment.",
      "formula": "Fed. R. Crim. P. 7(b)",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": ["Criminal information"],
      "confusables": ["Arraignment", "Grand jury", "Indictment"],
      "sources": ["usll-frcrmp#cl.7"]
    },
    {
      "id": "initial-appearance",
      "term": "Initial appearance",
      "definition": "The defendant's first court appearance after arrest, when the court advises the defendant of rights and charges.",
      "formula": "Fed. R. Crim. P. 5",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": [],
      "confusables": ["Arraignment", "Plea agreement", "Preliminary hearing"],
      "sources": ["usll-frcrmp#cl.5", "usll-doj-justice-101#sec.initial-hearing"]
    },
    {
      "id": "plea-agreement",
      "term": "Plea agreement",
      "definition": "An agreement under which a defendant pleads guilty in exchange for the prosecutor's recommendation or a reduced charge.",
      "formula": "Fed. R. Crim. P. 11",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": [],
      "confusables": ["Acquittal", "Arraignment", "Information"],
      "sources": ["usll-doj-justice-101#sec.pleabargaining", "usll-frcrmp#cl.11"]
    },
    {
      "id": "preliminary-hearing",
      "term": "Preliminary hearing",
      "definition": "A hearing at which a magistrate judge decides whether probable cause supports the charge.",
      "formula": "Fed. R. Crim. P. 5.1",
      "unit": 6,
      "unitTitle": "Criminal process stages",
      "aliases": [],
      "confusables": ["Arraignment", "Grand jury", "Initial appearance"],
      "sources": ["usll-frcrmp#cl.5.1"]
    }
  ]
}
