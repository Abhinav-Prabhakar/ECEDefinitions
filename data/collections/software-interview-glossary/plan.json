{
  "version": 1,
  "topic": "Software interview glossary for mid-level software engineer candidates",
  "collectionId": "software-interview-glossary",
  "type": "professional field",
  "audience": "Mid-level software engineer interview candidates",
  "level": "intro",
  "jurisdiction": "global",
  "spelling": "US",
  "language": "en",
  "regulated": false,
  "volatile": false,
  "includes": [
    "programming fundamentals: types, scope, functions, closures, control flow, memory, paradigms",
    "data structures and algorithms: complexity, core structures, trees and graphs, hashing, sorting, design techniques",
    "system design: scalability, reliability, consistency, partitioning, caching, messaging, operations",
    "databases and SQL: relational model, keys, querying, transactions, indexes, NoSQL",
    "operating systems and networking: processes, scheduling, memory, storage, synchronization, network protocols and addressing",
    "web and browser: HTTP, rendering, DOM, security policies, storage, web APIs"
  ],
  "excludes": [
    "language-specific syntax and library APIs",
    "vendor product names and cloud service catalogues",
    "coding-puzzle solutions and worked interview questions",
    "machine learning, data engineering and LLM vocabulary (separate collections)",
    "hiring process, behavioural interview and career advice"
  ],
  "assumptions": [
    "Terms are defined at the level a mid-level engineer is expected to explain in an interview",
    "Definitions follow widely used, vendor-neutral meanings; language-specific senses are noted in the term when they differ",
    "Source ids in this collection are not prefixed with the collection id; they are unique within the collection",
    "US spelling",
    "Sources are free to read; the NIST Dictionary of Algorithms and Data Structures was unreachable during the access audit and is not used"
  ],
