    {
      "id": "plumbing-system",
      "term": "plumbing system",
      "definition": "The water distribution pipes, fixtures, traps, soil and vent pipes, drains, and appurtenances within a structure, including the water service and building sewer.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Code framework",
      "aliases": [],
      "confusables": [
        "plumbing code",
        "existing installation",
        "alternative engineered design"
      ],
