        "ipc-2021#sec.1.108.2"
      ]
    },
    {
      "id": "notice-of-approval",
      "term": "notice of approval",
      "definition": "A written notice the code official issues after tests and inspections show the work complies with the code.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Permits and inspection",
      "aliases": [],
      "confusables": [
        "stop work order",
        "final inspection",
        "permit"
      ],
      "sources": [
        "ipc-2021#sec.1.111.1"
      ]
    },
    {
      "id": "permit",
      "term": "permit",
      "definition": "Official authorization the code official issues before regulated plumbing work may begin.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Permits and inspection",
      "aliases": [],
      "confusables": [
        "annual permit",
        "stop work order",
        "notice of approval"
      ],
      "sources": [
        "ipc-2021#sec.1.106.1"
      ]
    },
    {
      "id": "rough-in-inspection",
      "term": "rough-in inspection",
      "definition": "An inspection made after framing and all sanitary, storm, and water piping are installed but before wall or ceiling membranes.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Permits and inspection",
      "aliases": [],
      "confusables": [
        "underground inspection",
        "final inspection",
        "notice of approval"
      ],
      "sources": [
        "ipc-2021#sec.1.108.2"
      ]
    },
    {
      "id": "stop-work-order",
      "term": "stop work order",
      "definition": "A written order halting work that is proceeding contrary to the code or in a dangerous manner.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Permits and inspection",
      "aliases": [],
      "confusables": [
        "notice of approval",
        "permit",
        "board of appeals"
      ],
      "sources": [
        "ipc-2021#sec.1.113.1"
      ]
    },
    {
      "id": "underground-inspection",
      "term": "underground inspection",
      "definition": "An inspection made after trenches are excavated and bedded and piping installed, but before backfill is placed.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Permits and inspection",
      "aliases": [],
      "confusables": [
        "rough-in inspection",
        "final inspection",
        "bedding"
