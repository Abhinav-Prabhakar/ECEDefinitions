    },
    {
      "id": "final-inspection",
      "term": "final inspection",
      "definition": "An inspection made when the building is complete, fixtures are connected, and the structure is ready for occupancy.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Permits and inspection",
      "aliases": [],
      "confusables": [
        "rough-in inspection",
        "underground inspection",
        "notice of approval"
      ],
