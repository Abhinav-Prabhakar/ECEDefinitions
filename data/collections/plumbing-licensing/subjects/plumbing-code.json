    {
      "id": "existing-installation",
      "term": "existing installation",
      "definition": "A plumbing system legally installed before the code took effect or covered by a permit to install that has already been issued.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Code framework",
      "aliases": [],
