      ]
    },
    {
      "id": "brazed-joint",
      "term": "brazed joint",
      "definition": "A copper joint made by heating cleaned surfaces and melting a filler metal that conforms to the applicable filler standard.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "solder joint",
        "solvent-cemented joint",
        "welded joint"
      ],
      "sources": [
        "ipc-2021#sec.6.605.13.1"
      ]
    },
    {
      "id": "dielectric-union",
      "term": "dielectric union",
      "definition": "A fitting that joins copper or copper-alloy tubing to steel pipe while preventing galvanic corrosion between the different metals.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "threaded joint",
        "brazed joint",
        "solder joint"
      ],
      "sources": [
        "ipc-2021#sec.6.605.23.1"
      ]
    },
    {
      "id": "prohibited-joint",
      "term": "prohibited joint",
      "definition": "A connection the code forbids, such as a cement joint, saddle fitting, or solvent-cement joint between different plastics.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "solvent-cemented joint",
        "solder joint",
        "brazed joint"
      ],
      "sources": [
        "ipc-2021#sec.7.707.1"
      ]
    },
    {
      "id": "solder-joint",
      "term": "solder joint",
      "definition": "A copper joint made by cleaning surfaces, applying flux, and melting lead-free solder to draw into the gap.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "brazed joint",
        "solvent-cemented joint",
        "welded joint"
      ],
      "sources": [
        "ipc-2021#sec.6.605.13.6"
      ]
    },
    {
      "id": "solvent-cement",
      "term": "solvent cement",
      "definition": "A plastic pipe adhesive that softens and fuses the mating surfaces of pipe and fitting as it cures.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "solvent-cemented joint",
        "solder joint",
        "brazed joint"
      ],
      "sources": [
        "ipc-2021#sec.6.605.10.2"
      ]
    },
    {
      "id": "solvent-cemented-joint",
      "term": "solvent-cemented joint",
      "definition": "A plastic pipe joint made by coating clean surfaces with solvent cement and assembling them while the cement remains wet.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "solder joint",
        "brazed joint",
        "solvent cement"
      ],
      "sources": [
        "ipc-2021#sec.6.605.10.2"
      ]
    },
    {
      "id": "threaded-joint",
      "term": "threaded joint",
      "definition": "A screwed connection in which tapered external pipe threads engage internal threads and seal with compound or tape.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "brazed joint",
        "solder joint",
        "solvent-cemented joint"
      ],
      "sources": [
        "ipc-2021#sec.605.3"
      ]
    },
    {
      "id": "welded-joint",
      "term": "welded joint",
      "definition": "A pipe connection formed by heating two ends until they fuse, with or without added filler metal.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Materials and joints",
      "aliases": [],
      "confusables": [
        "brazed joint",
        "solder joint",
        "solvent-cemented joint"
      ],
      "sources": [
        "ipc-2021#sec.605.3"
      ]
    },
    {
      "id": "bedding",
      "term": "bedding",
      "definition": "The prepared trench bottom or placed material that gives continuous load-bearing support along a buried pipe.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Support and protection",
      "aliases": [],
      "confusables": [
        "frost line",
        "pipe sleeve",
        "shield plate"
      ],
      "sources": [
        "ipc-2021#sec.3.306.2"
      ]
    },
    {
      "id": "frost-line",
      "term": "frost line",
      "definition": "The depth below grade to which soil freezes, used to set minimum burial depth for exterior water piping.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Support and protection",
      "aliases": [],
      "confusables": [
        "bedding",
        "pipe sleeve",
        "shield plate"
      ],
      "sources": [
        "ipc-2021#sec.3.305.4"
      ]
    },
    {
      "id": "hanger-spacing",
      "term": "hanger spacing",
      "definition": "The maximum distance allowed between supports for a given piping material, size, and orientation.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Support and protection",
      "aliases": [],
      "confusables": [
        "supports",
        "sway bracing",
        "shield plate"
      ],
      "sources": [
        "ipc-2021#sec.3.308.5"
      ]
    },
    {
      "id": "pipe-sleeve",
      "term": "pipe sleeve",
      "definition": "A larger pipe built into a foundation wall so the passing pipe can move without loading the wall.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Support and protection",
      "aliases": [],
      "confusables": [
        "shield plate",
        "bedding",
        "supports"
      ],
      "sources": [
        "ipc-2021#sec.3.305.3"
      ]
    },
    {
      "id": "shield-plate",
      "term": "shield plate",
      "definition": "A steel plate protecting pipe installed close to the edge of a bored or notched framing member.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Support and protection",
      "aliases": [],
      "confusables": [
        "pipe sleeve",
        "hanger spacing",
        "supports"
      ],
      "sources": [
        "ipc-2021#sec.3.305.6"
      ]
    },
    {
      "id": "supports",
      "term": "supports",
      "definition": "Devices that support and secure pipe, fixtures, and equipment in a plumbing system.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Support and protection",
      "aliases": [],
      "confusables": [
        "hanger spacing",
        "sway bracing",
        "pipe sleeve"
      ],
      "sources": [
        "ipc-2021#sec.2"
      ]
    },
    {
      "id": "sway-bracing",
      "term": "sway bracing",
      "definition": "Rigid bracing installed where flow direction changes in large horizontal drains to resist movement from flow forces.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Support and protection",
      "aliases": [],
      "confusables": [
        "supports",
        "hanger spacing",
        "pipe sleeve"
      ],
      "sources": [
        "ipc-2021#sec.3.308.6"
      ]
    },
    {
      "id": "air-test",
      "term": "air test",
      "definition": "A test that pressurizes nonplastic piping with air and holds the pressure to reveal leaks.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "water test",
        "smoke test",
        "competent person"
      ],
      "sources": [
        "ipc-2021#sec.3.312.3"
      ]
    },
    {
      "id": "competent-person",
      "term": "competent person",
      "definition": "A worker able to identify existing and predictable hazards and authorized to take prompt corrective action.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "protective system",
        "code official",
        "confined space"
      ],
      "sources": [
        "osha-1926-subpart-p#sec.1926.650"
      ]
    },
    {
      "id": "confined-space",
      "term": "confined space",
      "definition": "A space large enough to enter, with restricted entry or exit, that is not designed for continuous occupancy.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "permit-required confined space",
        "hazardous atmosphere",
        "protective system"
      ],
      "sources": [
        "osha-1910-146#sec.1910.146(b)"
      ]
    },
    {
      "id": "hazardous-atmosphere",
      "term": "hazardous atmosphere",
      "definition": "An atmosphere that may cause death, incapacitation, injury, or acute illness through fire or explosion, oxygen imbalance, or toxicity.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "confined space",
        "permit-required confined space",
        "air test"
      ],
      "sources": [
        "osha-1910-146#sec.1910.146(b)"
      ]
    },
    {
      "id": "permit-required-confined-space",
      "term": "permit-required confined space",
      "definition": "A confined space containing a hazardous atmosphere, engulfment potential, converging walls, or another serious safety hazard.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "confined space",
        "hazardous atmosphere",
        "protective system"
      ],
      "sources": [
        "osha-1910-146#sec.1910.146(b)"
      ]
    },
    {
      "id": "protective-system",
      "term": "protective system",
      "definition": "A method such as sloping, benching, shoring, or shielding that protects workers from cave-ins and falling material.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "competent person",
        "confined space",
        "permit-required confined space"
      ],
      "sources": [
        "osha-1926-subpart-p#sec.1926.650"
      ]
    },
    {
      "id": "smoke-test",
      "term": "smoke test",
      "definition": "A test that fills traps with water and introduces pungent smoke to find openings in the drainage system.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "water test",
        "air test",
        "final inspection"
      ],
      "sources": [
        "ipc-2021#sec.3.312.4"
      ]
    },
    {
      "id": "water-test",
      "term": "water test",
      "definition": "A test that fills drainage piping with water to a specified head and holds it to reveal leaks.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety and testing",
      "aliases": [],
      "confusables": [
        "air test",
        "smoke test",
        "notice of approval"
      ],
