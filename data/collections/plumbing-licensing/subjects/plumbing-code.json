    {
      "id": "plumbing-code",
      "term": "plumbing code",
      "definition": "A legally adopted set of minimum requirements governing the design, installation, and maintenance of plumbing systems.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Code framework",
      "aliases": [],
      "confusables": [
        "plumbing system",
