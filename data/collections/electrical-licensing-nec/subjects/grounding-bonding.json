  "definitions": [
    {
      "id": "grounding",
      "term": "Grounding",
      "definition": "The process of connecting electrical systems or equipment to earth or to a conductive body that serves in place of earth.",
      "aliases": [],
      "confusables": [
        "Bonding",
        "Grounded Conductor"
      ],
      "formula": "",
      "unit": 1,
      "unitTitle": "Grounding concepts",
      "sources": [
        "nec-article-100#art.100"
      ]
    },
    {
      "id": "grounded-conductor",
      "term": "Grounded Conductor",
      "definition": "A system or circuit conductor that is intentionally grounded.",
      "aliases": [
        "Neutral conductor"
      ],
      "confusables": [
        "Grounding Conductor",
        "Ungrounded Conductor"
      ],
      "formula": "",
      "unit": 1,
      "unitTitle": "Grounding concepts",
      "sources": [
        "nec-article-100#art.100"
      ]
    },
    {
      "id": "ungrounded-conductor",
