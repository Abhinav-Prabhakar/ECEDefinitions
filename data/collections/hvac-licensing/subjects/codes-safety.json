      "unit": 3,
      "unitTitle": "Electrical safety",
      "aliases": [
        "GFCI"
      ],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "nfpa-70#sec.art-100",
