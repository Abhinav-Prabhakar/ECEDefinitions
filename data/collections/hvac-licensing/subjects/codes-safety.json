    },
    {
      "id": "a2l-refrigerant",
      "term": "A2L refrigerant",
      "definition": "A refrigerant classified as mildly flammable under ASHRAE 34, requiring charge limits, ignition-source controls, and ventilation provisions during installation and service.",
      "formula": "A2L",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [
        "mildly flammable refrigerant"
      ],
      "confusables": [
        "Refrigerant asphyxiation hazard",
        "Refrigerant Safety Data Sheet"
      ],
      "sources": [
        "ashrae-15#sec.flammability"
      ]
    },
    {
      "id": "epa-section-608",
      "term": "EPA Section 608",
      "definition": "US EPA regulations under the Clean Air Act requiring certification for technicians who maintain, service, repair, or dispose of equipment that could release regulated refrigerants.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [
        "Section 608"
      ],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "epa-608#sec.overview"
      ]
    },
    {
      "id": "machinery-room",
      "term": "Machinery room",
      "definition": "A dedicated space that meets ASHRAE 15 construction and ventilation requirements for refrigerant-containing equipment whose charge exceeds defined limits.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [],
      "confusables": [
        "Mechanical ventilation",
        "Refrigerant detection system"
      ],
      "sources": [
        "ashrae-15#sec.machinery-room"
      ]
    },
    {
      "id": "refrigerant-safety-data-sheet",
      "term": "Refrigerant Safety Data Sheet",
      "definition": "A document providing hazard information, handling precautions, first aid, exposure limits, and spill response for a specific refrigerant.",
      "formula": "SDS",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [
        "SDS",
        "MSDS"
      ],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "osha-hazcom#sec.1910-1200",
        "ashrae-15#sec.safety"
      ]
    },
    {
      "id": "refrigerant-asphyxiation-hazard",
      "term": "Refrigerant asphyxiation hazard",
      "definition": "The risk that heavier-than-air refrigerants can displace oxygen in low or confined spaces, creating a suffocation hazard.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [
        "oxygen displacement"
      ],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "ashrae-15#sec.ventilation",
        "osha-1910.146#sec.definitions"
      ]
    },
    {
      "id": "refrigerant-detection-system",
      "term": "Refrigerant detection system",
      "definition": "Fixed sensors that monitor a machinery room or occupied space for refrigerant concentration and trigger alarms, ventilation, or equipment shutdown at set thresholds.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [
        "gas detection system"
      ],
      "confusables": [
        "Machinery room",
        "Refrigerant asphyxiation hazard"
      ],
      "sources": [
        "ashrae-15#sec.detection"
      ]
    },
    {
      "id": "refrigerant-reclaim",
      "term": "Refrigerant reclaim",
      "definition": "Processing used refrigerant to meet ARI-700 (or equivalent) purity specifications, usually performed by a EPA-certified reclaimer off-site.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "epa-608#sec.reclaim"
      ]
    },
    {
      "id": "refrigerant-recovery",
      "term": "Refrigerant recovery",
      "definition": "The process of removing refrigerant from a system and storing it in an approved recovery container without necessarily processing it.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "epa-608#sec.recovery"
      ]
    },
    {
      "id": "refrigerant-recycling",
      "term": "Refrigerant recycling",
      "definition": "Cleaning refrigerant for reuse by oil separation and single or multiple passes through filter-driers, typically done on-site with approved equipment.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "epa-608#sec.recycling"
      ]
    },
    {
      "id": "refrigerant-venting-prohibition",
      "term": "Refrigerant venting prohibition",
      "definition": "Under EPA Section 608, knowingly releasing regulated refrigerants into the atmosphere during service, maintenance, repair, or disposal is prohibited except in limited, allowable cases.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Refrigerant safety",
      "aliases": [
        "venting prohibition"
      ],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "epa-608#sec.venting"
      ]
    },
    {
      "id": "arc-flash",
      "term": "Arc flash",
      "definition": "A dangerous release of energy caused by an electric arc, producing intense heat, light, pressure, and risk of serious injury.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Electrical safety",
      "aliases": [],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "nfpa-70e#sec.130"
      ]
    },
    {
      "id": "arc-flash-boundary",
      "term": "Arc flash boundary",
      "definition": "The distance from energized equipment within which a person could receive a second-degree burn from an arc flash, set by an incident energy analysis.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Electrical safety",
      "aliases": [
        "AFB"
      ],
      "confusables": [
        "Arc flash",
        "Electrical working clearance"
