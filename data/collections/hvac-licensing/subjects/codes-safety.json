      "formula": "",
      "unit": 3,
      "unitTitle": "Electrical safety",
      "aliases": [
        "disconnect",
        "service disconnect"
      ],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "nfpa-70#sec.art-100",
        "nfpa-70#sec.art-440"
