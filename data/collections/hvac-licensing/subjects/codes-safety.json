      "unit": 3,
      "unitTitle": "Electrical safety",
      "aliases": [
        "working space"
      ],
      "confusables": [
        "Building code",
        "International Mechanical Code"
      ],
      "sources": [
        "nfpa-70#sec.art-110-26"
