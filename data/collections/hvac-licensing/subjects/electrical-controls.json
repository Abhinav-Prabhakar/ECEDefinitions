      "id": "ec-039",
      "term": "safety control",
      "definition": "A device designed to shut down or prevent operation of HVAC equipment when unsafe conditions are detected.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety controls",
      "aliases": [
        "protective control"
      ],
      "confusables": [
        "operating control",
        "circuit"
      ],
      "sources": [
        "hvac-glossary-acca#sec.p-39"
      ]
    },
    {
      "id": "ec-040",
      "term": "operating control",
      "definition": "A control device that regulates normal system operation based on conditions like temperature or pressure.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Safety controls",
      "aliases": [
        "normal control"
      ],
      "confusables": [
        "safety control",
        "circuit"
      ],
      "sources": [
