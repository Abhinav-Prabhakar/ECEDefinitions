  "definitions": [
    {
      "id": "de-broglie-hypothesis",
      "term": "de Broglie hypothesis",
      "definition": "Any moving particle is associated with a matter wave.",
      "formula": "\u03bb=h/mv",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.5"
      ]
    },
    {
      "id": "matter-wave",
      "term": "Matter wave",
      "definition": "A wave associated with a moving particle, whose wavelength is inversely proportional to its momentum.",
      "formula": "\u03bb=h/p",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.6"
      ]
    },
    {
      "id": "de-broglie-wavelength",
      "term": "de Broglie wavelength",
      "definition": "The wavelength associated with a particle equals Planck's constant divided by its momentum.",
      "formula": "\u03bb=h/p",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.6"
      ]
    },
    {
      "id": "heisenberg-uncertainty-principle",
      "term": "Heisenberg uncertainty principle",
      "definition": "It is impossible to simultaneously determine a particle's position and momentum with perfect accuracy.",
      "formula": "\u0394x \u0394p \u2265 h/4\u03c0",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.27"
      ]
    },
    {
      "id": "schrodinger-time-independent-wave-equation",
      "term": "Schr\u00f6dinger time-independent wave equation",
      "definition": "A differential equation describing a quantum particle's stationary state using its wave function and potential energy.",
      "formula": "(\u2212\u210f\u00b2/2m)\u2207\u00b2\u03c8+V\u03c8=E\u03c8",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.32"
      ]
    },
    {
      "id": "wave-function",
      "term": "Wave function",
      "definition": "A complex function whose squared magnitude gives the probability density of finding a particle.",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.33"
      ]
    },
    {
      "id": "normalization-condition",
      "term": "Normalization condition",
      "definition": "The integral of |\u03c8|\u00b2 over all space equals one, ensuring total probability is unity.",
      "formula": "\u222b|\u03c8|\u00b2 d\u03c4=1",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.34"
      ]
    },
    {
      "id": "particle-in-a-box",
      "term": "Particle in a box",
      "definition": "A particle confined to a one-dimensional infinite potential well has quantized energy levels.",
      "formula": "E_n=n\u00b2h\u00b2/(8mL\u00b2)",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.40"
      ]
    },
    {
      "id": "energy-eigenvalue",
      "term": "Energy eigenvalue",
      "definition": "A scalar value representing the measurable energy of a quantum state corresponding to an eigenfunction.",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.40"
      ]
    },
    {
      "id": "davisson-germer-experiment",
      "term": "Davisson-Germer experiment",
      "definition": "Electron diffraction from a nickel crystal verified the wave nature of moving particles.",
      "unit": 1,
      "unitTitle": "Quantum Mechanics",
      "sources": [
        "ep-unit-1-quantum-mechanics#p.12"
      ]
    },
