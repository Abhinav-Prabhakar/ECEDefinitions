{
  "version": 1,
  "id": "matrix-algebra-and-calculus",
  "semester": "1-1",
  "name": "Matrix Algebra and Calculus",
  "shortName": "MAC",
  "code": "9HC11",
  "courseType": "BS",
  "folderId": "1-mWpn3WSll2yrWeDpFkwxLV0Xbj7RCd7",
  "folderUrl": "https://drive.google.com/drive/folders/1-mWpn3WSll2yrWeDpFkwxLV0Xbj7RCd7",
  "status": "complete",
  "definitions": [
    {
      "id": "rolles-theorem",
      "term": "Rolle's theorem",
      "definition": "If a function is continuous on [a,b], differentiable on (a,b), and f(a)=f(b), then some c in (a,b) has f'(c)=0.",
      "formula": "f'(c)=0",
      "unit": 4,
      "unitTitle": "Single Variable Calculus",
      "sources": [
        "mac-unit-4-mac#slide.2"
      ]
    },
    {
      "id": "lagranges-mean-value-theorem",
      "term": "Lagrange's mean value theorem",
      "definition": "If a function is continuous on [a,b] and differentiable on (a,b), then some c in (a,b) satisfies f'(c)=(f(b)-f(a))/(b-a).",
      "formula": "f'(c)=(f(b)-f(a))/(b-a)",
      "unit": 4,
      "unitTitle": "Single Variable Calculus",
      "sources": [
        "mac-unit-4-mac#slide.3"
      ]
    },
    {
      "id": "cauchys-mean-value-theorem",
      "term": "Cauchy's mean value theorem",
      "definition": "If f and g are continuous on [a,b], differentiable on (a,b), and g'(x)≠0, then some c in (a,b) satisfies f'(c)/g'(c)=(f(b)-f(a))/(g(b)-g(a)).",
      "formula": "f'(c)/g'(c)=(f(b)-f(a))/(g(b)-g(a))",
      "unit": 4,
      "unitTitle": "Single Variable Calculus",
      "sources": [
        "mac-unit-4-mac#slide.4"
      ]
    },
    {
      "id": "taylors-series",
      "term": "Taylor's series",
      "definition": "Expansion of f(x) about x=x0 as the sum over n of f^(n)(x0)(x-x0)^n/n!, assuming successive derivatives exist.",
      "formula": "f(x)=Σ f⁽ⁿ⁾(x₀)(x-x₀)ⁿ/n!",
      "unit": 4,
      "unitTitle": "Single Variable Calculus",
      "sources": [
        "mac-unit-4-mac#slide.5"
      ]
    },
    {
      "id": "maclaurin-series",
      "term": "Maclaurin series",
      "definition": "Expansion of f(x) about 0 as the sum over n of f^(n)(0) x^n/n!, assuming successive derivatives exist.",
      "formula": "f(x)=Σ f⁽ⁿ⁾(0)xⁿ/n!",
      "unit": 4,
      "unitTitle": "Single Variable Calculus",
      "sources": [
        "mac-unit-4-mac#slide.5"
      ]
    },
    {
      "id": "row-echelon-form",
      "term": "Row echelon form",
      "definition": "Matrix shape in which all-zero rows lie at the bottom and the leading entry of each nonzero row sits strictly right of the one above.",
      "formula": "",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-row-echelon#row-echelon-form"
      ]
    },
    {
      "id": "elementary-row-operations",
      "term": "Elementary row operations",
      "definition": "Three reversible steps on a matrix: interchanging two rows, multiplying a row by a nonzero scalar, or adding a multiple of one row to another.",
      "formula": "",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-gaussian-elimination#gaussian-elimination"
      ]
    },
    {
      "id": "rank-of-a-matrix",
      "term": "Rank of a matrix",
      "definition": "Dimension of the space spanned by the columns, equal to the maximum number of linearly independent columns or rows.",
      "formula": "",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-rank#main-definitions"
      ]
    },
    {
      "id": "gauss-jordan-method",
      "term": "Gauss–Jordan method",
      "definition": "Elimination procedure that reduces an augmented matrix to reduced echelon form, yielding the inverse when the left block becomes the identity.",
      "formula": "[A | I] → [I | A⁻¹]",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-gaussian-elimination#gauss-jordan-elimination-for-the-inverse"
      ]
    },
    {
      "id": "gaussian-elimination",
      "term": "Gaussian elimination",
      "definition": "Algorithm that applies row operations to reach echelon form and then solves the unknowns in reverse order by back substitution.",
      "formula": "",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-gaussian-elimination#back-substitution"
      ]
    },
    {
      "id": "consistent-system",
      "term": "Consistent system",
      "definition": "Set of linear equations possessing at least one solution, which occurs exactly when coefficient and augmented matrices have equal rank.",
      "formula": "rank(A) = rank([A|b])",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-rouche-capelli#statement-of-consistency"
      ]
    },
    {
      "id": "homogeneous-system",
      "term": "Homogeneous system",
      "definition": "Set of linear equations whose right-hand sides are all zero, so the all-zero solution always exists.",
      "formula": "Ax = 0",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-rouche-capelli#statement-of-consistency"
      ]
    },
    {
      "id": "symmetric-matrix",
      "term": "Symmetric matrix",
      "definition": "Square array equal to its own transpose, so entries mirrored across the main diagonal are equal.",
      "formula": "Aᵀ = A",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-symmetric-matrix#symmetric-matrix"
      ]
    },
    {
      "id": "skew-symmetric-matrix",
      "term": "Skew-symmetric matrix",
      "definition": "Square array whose transpose equals its negative, forcing every main-diagonal entry to be zero.",
      "formula": "Aᵀ = −A",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-skew-symmetric#skew-symmetric-matrix"
      ]
    },
    {
      "id": "orthogonal-matrix",
      "term": "Orthogonal matrix",
      "definition": "Real square array whose columns and rows are orthonormal vectors, so its transpose equals its inverse.",
      "formula": "QᵀQ = QQᵀ = I",
      "unit": 1,
      "unitTitle": "System of Linear Equations",
      "sources": [
        "mac-wiki-orthogonal-matrix#overview"
      ]
    },
    {
      "id": "eigenvalue",
      "term": "Eigenvalue",
      "definition": "Scalar by which a square matrix stretches or reverses a nonzero vector without changing its line of direction.",
      "formula": "Av = λv",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-eigen#key-definitions"
      ]
    },
    {
      "id": "eigenvector",
      "term": "Eigenvector",
      "definition": "Nonzero vector whose direction is left unchanged or reversed by a linear transformation, which merely multiplies it by a constant factor.",
      "formula": "Av = λv",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-eigen#key-definitions"
      ]
    },
    {
      "id": "characteristic-equation",
      "term": "Characteristic equation",
      "definition": "Determinant condition whose roots are exactly the scalars that merely scale some nonzero vector under the matrix.",
      "formula": "det(A − λI) = 0",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-eigen#key-definitions"
      ]
    },
    {
      "id": "eigenspace",
      "term": "Eigenspace",
      "definition": "Set of all vectors scaled by one given factor under a matrix, together with the zero vector; it equals the null space of A − λI.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-eigen#key-definitions"
      ]
    },
    {
      "id": "cayley-hamilton-theorem",
      "term": "Cayley–Hamilton theorem",
      "definition": "Result stating that every square matrix over a commutative ring satisfies its own characteristic polynomial, enabling inverses and powers from low-order terms.",
      "formula": "p(A) = 0",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-cayley-hamilton#statement-of-the-theorem"
      ]
    },
    {
      "id": "diagonalization",
      "term": "Diagonalization",
      "definition": "Factorization A = PDP⁻¹ of a square matrix with D holding the scaling factors, possible when n independent eigenvectors exist.",
      "formula": "P⁻¹AP = D",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-diagonalizable#definition"
      ]
    },
    {
      "id": "hermitian-matrix",
      "term": "Hermitian matrix",
      "definition": "Complex square array equal to its own conjugate transpose, therefore having real diagonal entries and real eigenvalues.",
      "formula": "A = Aᴴ",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-hermitian#definition-of-hermitian-matrix"
      ]
    },
    {
      "id": "skew-hermitian-matrix",
      "term": "Skew-Hermitian matrix",
      "definition": "Complex square array whose conjugate transpose equals its negative.",
      "formula": "Aᴴ = −A",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-hermitian#skew-hermitian-matrix"
      ]
    },
    {
      "id": "unitary-matrix",
      "term": "Unitary matrix",
      "definition": "Complex square array whose inverse equals its conjugate transpose, so all its eigenvalues lie on the unit circle.",
      "formula": "U*U = UU* = I",
      "unit": 2,
      "unitTitle": "Eigenvalues and Eigenvectors",
      "sources": [
        "mac-wiki-unitary#definition"
      ]
    },
    {
      "id": "quadratic-form",
      "term": "Quadratic form",
      "definition": "Homogeneous polynomial of degree two in several variables, expressible as xᵀAx with a symmetric coefficient array A.",
      "formula": "q(x) = xᵀAx",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-quadratic-form#definition"
      ]
    },
    {
      "id": "positive-definite",
      "term": "Positive definite",
      "definition": "Property of a real quadratic form of taking values greater than zero for every nonzero input vector.",
      "formula": "q(v) > 0 for v ≠ 0",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-quadratic-form#definiteness-and-indefiniteness"
      ]
    },
    {
      "id": "negative-definite",
      "term": "Negative definite",
      "definition": "Property of a real quadratic form of taking values less than zero for every nonzero input vector.",
      "formula": "q(v) < 0 for v ≠ 0",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-quadratic-form#definiteness-and-indefiniteness"
      ]
    },
    {
      "id": "indefinite",
      "term": "Indefinite",
      "definition": "Property of a real quadratic form whose values include both signs depending on the input vector.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-quadratic-form#definiteness-and-indefiniteness"
      ]
    },
    {
      "id": "canonical-form",
      "term": "Canonical form",
      "definition": "Sum-of-squares expression λ₁y₁² + … + λₙyₙ² obtained from a quadratic polynomial by an orthogonal change of variables.",
      "formula": "λ₁y₁² + … + λₙyₙ²",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-quadratic-form#diagonalization-and-canonical-form"
      ]
    },
    {
      "id": "index",
      "term": "Index",
      "definition": "Number of positive terms in any diagonalized sum-of-squares expression, invariant under every invertible change of variables.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-sylvester#index-of-inertia"
      ]
    },
    {
      "id": "signature",
      "term": "Signature",
      "definition": "Difference between the counts of positive and negative terms in a diagonalized sum of squares, invariant under invertible variable changes.",
      "formula": "n₊ − n₋",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-sylvester#signature"
      ]
    },
    {
      "id": "rank-of-a-quadratic-form",
      "term": "Rank of a quadratic form",
      "definition": "Number of nonzero terms in a diagonalized sum of squares, equal to n minus the nullity of the symmetric coefficient matrix.",
      "formula": "n₊ + n₋ = n − n₀",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-sylvester#index-of-inertia"
      ]
    },
    {
      "id": "sylvester-s-law-of-inertia",
      "term": "Sylvester's law of inertia",
      "definition": "Result stating that the counts of positive, negative and zero coefficients in a diagonalized real quadratic form do not depend on the invertible change of variables used.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Quadratic Forms",
      "sources": [
        "mac-wiki-sylvester#statement"
      ]
    },
    {
      "id": "exact-differential-equation",
      "term": "Exact differential equation",
      "definition": "Relation M dx + N dy = 0 for which a potential function exists whose partial derivatives are M and N, tested by M_y = N_x.",
      "formula": "M_y = N_x",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-exact-de#exact-differential-equations"
      ]
    },
    {
      "id": "potential-function",
      "term": "Potential function",
      "definition": "Scalar field F(x, y) whose partial derivatives equal the coefficients M and N, so that F(x, y) = c defines the solutions.",
      "formula": "F(x, y) = c",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-exact-de#exact-differential-equations"
      ]
    },
    {
      "id": "integrating-factor",
      "term": "Integrating factor",
      "definition": "Multiplying function chosen so that a non-exact first-order relation becomes solvable; for y′ + P(x)y = Q(x) it equals e^(∫P(x)dx).",
      "formula": "μ = e^(∫P dx)",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-integrating-factor#first-order-linear-odes"
      ]
    },
    {
      "id": "first-order-linear-equation",
      "term": "First-order linear equation",
      "definition": "Relation of the form y′ + P(x)y = Q(x) in which the unknown and its derivative appear only to the first power.",
      "formula": "y′ + P(x)y = Q(x)",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-integrating-factor#first-order-linear-odes"
      ]
    },
    {
      "id": "bernoulli-equation",
      "term": "Bernoulli equation",
      "definition": "Nonlinear relation of the form y′ + P(x)y = Q(x)yⁿ that becomes linear under the substitution u = y^(1−n).",
      "formula": "y′ + Py = Qyⁿ",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-bernoulli-de#transformation-to-a-linear-equation"
      ]
    },
    {
      "id": "newton-s-law-of-cooling",
      "term": "Newton's law of cooling",
      "definition": "Principle that a body's rate of heat loss is proportional to the temperature difference from its surroundings, giving exponential decay of that difference.",
      "formula": "dT/dt = −r(T − T_env)",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-newton-cooling#statement-of-the-law"
      ]
    },
    {
      "id": "natural-growth",
      "term": "Natural growth",
      "definition": "Process in which a quantity increases at a rate proportional to its current value, producing exponential behavior with a positive rate constant.",
      "formula": "x(t) = x₀e^(kt), k > 0",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-exponential-growth#differential-equation"
      ]
    },
    {
      "id": "natural-decay",
      "term": "Natural decay",
      "definition": "Process in which a quantity diminishes at a rate proportional to its current value, producing exponential behavior with a negative rate constant.",
      "formula": "x(t) = x₀e^(kt), k < 0",
      "unit": 5,
      "unitTitle": "First Order ODE",
      "sources": [
        "mac-wiki-exponential-growth#differential-equation"
      ]
    },
    {
      "id": "constant-coefficient-linear-equation",
      "term": "Constant-coefficient linear equation",
      "definition": "Relation a₀y + a₁y′ + … + aₙy⁽ⁿ⁾ = f(x) in which the multipliers of y and its derivatives are fixed numbers.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Higher Order ODE",
      "sources": [
        "mac-wiki-linear-de#homogeneous-equations-with-constant-coefficients"
      ]
    },
    {
      "id": "homogeneous-linear-equation",
      "term": "Homogeneous linear equation",
      "definition": "Linear relation in the unknown function and its derivatives whose right-hand side equals zero.",
      "formula": "a₀y + … + aₙy⁽ⁿ⁾ = 0",
      "unit": 6,
      "unitTitle": "Higher Order ODE",
      "sources": [
        "mac-wiki-linear-de#homogeneous-equations-with-constant-coefficients"
      ]
    },
    {
      "id": "characteristic-polynomial",
      "term": "Characteristic polynomial",
      "definition": "Expression a₀ + a₁t + … + aₙtⁿ obtained by substituting e^(αx) into a homogeneous constant-coefficient relation, whose roots fix the basic solutions.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Higher Order ODE",
      "sources": [
        "mac-wiki-linear-de#characteristic-equation"
      ]
    },
    {
      "id": "complementary-function",
      "term": "Complementary function",
      "definition": "Solution of the associated homogeneous relation, carrying arbitrary constants, that is added to a particular solution to form the full answer.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Higher Order ODE",
      "sources": [
        "mac-wiki-linear-de#general-solution-complementary-plus-particular"
      ]
    },
    {
      "id": "particular-integral",
      "term": "Particular integral",
      "definition": "Any single solution of the full nonhomogeneous relation, containing no arbitrary constants, which is added to the homogeneous solution.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Higher Order ODE",
      "sources": [
        "mac-wiki-linear-de#general-solution-complementary-plus-particular"
      ]
    },
    {
      "id": "wronskian",
      "term": "Wronskian",
      "definition": "Determinant u₁u₂′ − u₂u₁′ of two solutions and their derivatives, whose being nonzero guarantees linear independence.",
      "formula": "W = u₁u₂′ − u₂u₁′",
      "unit": 6,
      "unitTitle": "Higher Order ODE",
      "sources": [
        "mac-wiki-variation-parameters#wronskian-formula"
      ]
    },
    {
      "id": "variation-of-parameters",
      "term": "Variation of parameters",
      "definition": "Method seeking a particular solution A(x)u₁ + B(x)u₂ whose unknown coefficient functions come from a 2×2 linear system involving the Wronskian.",
      "formula": "A′ = −u₂f/W, B′ = u₁f/W",
      "unit": 6,
      "unitTitle": "Higher Order ODE",
      "sources": [
        "mac-wiki-variation-parameters#method-for-second-order-equations"
      ]
    }
  ]
}
