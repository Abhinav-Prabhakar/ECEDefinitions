{
  "version": 1,
  "id": "analog-and-digital-communications",
  "semester": "2-2",
  "name": "Analog & Digital Communications",
  "shortName": "ADC",
  "code": "9CC06",
  "courseType": "PC",
  "folderId": "1-3M2IAu2BzU8JY6v1HYC96pxUT5lK7NE",
  "folderUrl": "https://drive.google.com/drive/folders/1-3M2IAu2BzU8JY6v1HYC96pxUT5lK7NE",
  "status": "complete",
  "definitions": [
    {
      "id": "modulation",
      "term": "Modulation",
      "definition": "Process of varying a carrier characteristic in accordance with the message signal.",
      "unit": 1,
      "unitTitle": "Amplitude Modulation",
      "sources": [
        "adc-adc-unit-i#slide.8"
      ],
      "formula": "s(t)=A(t)\\cos\\left[\\omega_{c}t+\\phi(t)\\right]"
    },
    {
      "id": "am",
      "term": "Amplitude modulation (AM)",
      "definition": "Carrier amplitude varies with instantaneous amplitude of the modulating signal.",
      "unit": 1,
      "unitTitle": "Amplitude Modulation",
      "sources": [
        "adc-adc-unit-i#slide.4"
      ],
      "formula": "s(t)=A_{c}\\left[1+\\mu\\,m(t)\\right]\\cos\\omega_{c}t",
      "diagram": "am-modulation"
    },
    {
      "id": "modulation-index-am",
      "term": "Modulation index (AM)",
      "definition": "Ratio of the message-signal amplitude to the amplitude of the unmodulated carrier wave.",
      "formula": "\\mu=\\frac{A_{m}}{A_{c}}",
      "unit": 1,
      "unitTitle": "Amplitude Modulation",
      "sources": [
        "adc-adc-unit-i#slide.8"
      ],
      "diagram": "am-modulation"
    },
    {
      "id": "dsbsc",
      "term": "DSBSC modulation",
      "definition": "Amplitude modulation with the carrier suppressed, transmitting only sidebands.",
      "unit": 1,
      "unitTitle": "Amplitude Modulation",
      "sources": [
        "adc-adc-unit-i#slide.8"
      ],
      "formula": "s(t)=A_{c}\\,m(t)\\cos\\omega_{c}t"
    },
    {
      "id": "ssb",
      "term": "SSB modulation",
      "definition": "Transmission of only one sideband to save bandwidth and power.",
      "unit": 1,
      "unitTitle": "Amplitude Modulation",
      "sources": [
        "adc-adc-unit-i#slide.8"
      ],
      "formula": "s(t)=\\frac{A_{c}}{2}\\left[m(t)\\cos\\omega_{c}t\\mp\\hat{m}(t)\\sin\\omega_{c}t\\right]"
    },
    {
      "id": "vsb",
      "term": "VSB modulation",
      "definition": "Transmits one sideband plus a vestige of the other for easier filtering.",
      "unit": 1,
      "unitTitle": "Amplitude Modulation",
      "sources": [
        "adc-adc-unit-i#slide.8"
      ],
      "formula": "B_{\\text{VSB}}=f_{m}+f_{v}"
    },
    {
      "id": "envelope-detector",
      "term": "Envelope detector",
      "definition": "Diode-RC circuit that recovers the envelope of an AM wave.",
      "unit": 1,
      "unitTitle": "Amplitude Modulation",
      "sources": [
        "adc-adc-unit-i#slide.9"
      ],
      "formula": "\\frac{1}{2\\pi f_{c}}\\ll RC\\ll\\frac{1}{2\\pi f_{m}}"
    },
    {
      "id": "fm",
      "term": "Frequency modulation (FM)",
      "definition": "Carrier frequency varies with instantaneous amplitude of the modulating signal.",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.2"
      ],
      "formula": "s(t)=A_{c}\\cos\\left(\\omega_{c}t+k_{f}\\int_{0}^{t}m(\\tau)\\,d\\tau\\right)",
      "diagram": "fm-modulation"
    },
    {
      "id": "pm",
      "term": "Phase modulation (PM)",
      "definition": "Carrier phase varies with instantaneous amplitude of the modulating signal.",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.2"
      ],
      "formula": "s(t)=A_{c}\\cos\\left(\\omega_{c}t+k_{p}\\,m(t)\\right)"
    },
    {
      "id": "freq-deviation",
      "term": "Frequency deviation",
      "definition": "Maximum change in carrier frequency from its unmodulated value.",
      "formula": "\\Delta f=k_{f}A_{m}",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.3"
      ]
    },
    {
      "id": "modulation-index-fm",
      "term": "Modulation index (FM)",
      "definition": "Ratio of the peak frequency deviation of the carrier to the frequency of the message signal.",
      "formula": "\\beta=\\frac{\\Delta f}{f_{m}}",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.2"
      ]
    },
    {
      "id": "nbfm",
      "term": "Narrowband FM",
      "definition": "Frequency modulation with modulation index less than one.",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.10"
      ],
      "formula": "B_{\\text{NBFM}}\\approx2f_{m}"
    },
    {
      "id": "wbfm",
      "term": "Wideband FM",
      "definition": "Frequency modulation with modulation index greater than one.",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.10"
      ],
      "formula": "n_{\\text{sb}}\\approx\\beta+1"
    },
    {
      "id": "carsons-rule",
      "term": "Carson's rule",
      "definition": "Rule of thumb estimating FM transmission bandwidth as approximately twice the sum of the frequency deviation and the modulating frequency.",
      "formula": "B_{T}\\approx2(\\Delta f+f_{m})=2f_{m}(\\beta+1)",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.47"
      ],
      "diagram": "fm-modulation"
    },
    {
      "id": "pre-emphasis",
      "term": "Pre-emphasis",
      "definition": "Boosting high audio frequencies at transmitter to improve SNR.",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.3"
      ],
      "formula": "H_{pe}(f)=1+j\\frac{f}{f_{1}}",
      "diagram": "bode"
    },
    {
      "id": "de-emphasis",
      "term": "De-emphasis",
      "definition": "Attenuating high frequencies at receiver to restore balance.",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.3"
      ],
      "formula": "H_{de}(f)=\\frac{1}{1+jf/f_{1}}"
    },
    {
      "id": "fdm",
      "term": "Frequency division multiplexing",
      "definition": "Multiple signals transmitted on separate non-overlapping frequency bands.",
      "unit": 2,
      "unitTitle": "Angle Modulation",
      "sources": [
        "adc-adc-unit-ii#slide.3"
      ],
      "formula": "B_{\\text{FDM}}=\\sum_{i=1}^{N}B_{i}+(N-1)B_{g}"
    },
    {
      "id": "superheterodyne",
      "term": "Superheterodyne receiver",
      "definition": "Receiver that converts RF signals to a fixed intermediate frequency.",
      "unit": 3,
      "unitTitle": "Transmitters and Receivers",
      "sources": [
        "adc-adc-unit-iii#slide.2"
      ],
      "formula": "f_{IF}=|f_{LO}-f_{RF}|",
      "diagram": "superhet"
    },
    {
      "id": "if",
      "term": "Intermediate frequency (IF)",
      "definition": "Fixed frequency to which received RF is converted for amplification.",
      "unit": 3,
      "unitTitle": "Transmitters and Receivers",
      "sources": [
        "adc-adc-unit-iii#slide.3"
      ],
      "formula": "f_{IF}=\\frac{1}{2}\\left(f_{\\text{img}}-f_{RF}\\right)",
      "diagram": "if-filter"
    },
    {
      "id": "image-frequency",
      "term": "Image frequency",
      "definition": "Unwanted frequency that also produces the same intermediate frequency.",
      "unit": 3,
      "unitTitle": "Transmitters and Receivers",
      "sources": [
        "adc-adc-unit-iii#slide.3"
      ],
      "formula": "f_{\\text{img}}=f_{RF}+2f_{IF}",
      "diagram": "if-filter"
    },
    {
      "id": "selectivity",
      "term": "Selectivity",
      "definition": "Ability to select desired band and reject unwanted signals.",
      "unit": 3,
      "unitTitle": "Transmitters and Receivers",
      "sources": [
        "adc-adc-unit-iii#slide.23"
      ],
      "formula": "Q=\\frac{f_{c}}{B}"
    },
    {
      "id": "sensitivity",
      "term": "Sensitivity",
      "definition": "Minimum input signal level detectable by a receiver.",
      "unit": 3,
      "unitTitle": "Transmitters and Receivers",
      "sources": [
        "adc-adc-unit-iii#slide.23"
      ],
      "formula": "P_{\\min}=kTB\\,F\\,(S/N)_{\\min}"
    },
    {
      "id": "agc",
      "term": "Automatic gain control",
      "definition": "Automatically varies receiver gain to maintain constant output level.",
      "unit": 3,
      "unitTitle": "Transmitters and Receivers",
      "sources": [
        "adc-adc-unit-iii#slide.25"
      ],
      "formula": "\\overline{V}_{\\text{out}}=V_{\\text{ref}}"
    },
    {
      "id": "amplitude-limiting",
      "term": "Amplitude limiting",
      "definition": "Removal of unwanted amplitude variations from an FM signal using a limiter stage before demodulation, since noise produces amplitude changes.",
      "unit": 3,
      "unitTitle": "Transmitters and Receivers",
      "sources": [
        "adc-adc-unit-iii#slide.3"
      ],
      "formula": "v_{o}=V_{L}\\,\\text{sgn}(v_{i})"
    },
    {
      "id": "sampling-theorem",
      "term": "Sampling theorem",
      "definition": "Bandlimited signal recoverable if sampled at least twice its max frequency.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.27"
      ],
      "formula": "x(t)=\\sum_{n=-\\infty}^{\\infty}x(nT_{s})\\,\\text{sinc}\\!\\left(\\frac{t-nT_{s}}{T_{s}}\\right)",
      "diagram": "sampling"
    },
    {
      "id": "nyquist-rate",
      "term": "Nyquist rate",
      "definition": "Minimum sampling rate equal to twice the signal bandwidth.",
      "formula": "f_{s,\\min}=2f_{m}",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.6"
      ],
      "diagram": "sampling"
    },
    {
      "id": "pcm",
      "term": "Pulse code modulation (PCM)",
      "definition": "Analog signal sampled, quantized, and encoded into digital bits.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.2"
      ],
      "formula": "R_{b}=f_{s}\\log_{2}L=f_{s}n",
      "diagram": "pcm"
    },
    {
      "id": "quantization",
      "term": "Quantization",
      "definition": "Mapping continuous amplitude values to a finite set of levels.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.3"
      ],
      "formula": "\\Delta=\\frac{V_{\\text{FS}}}{L}=\\frac{V_{\\text{FS}}}{2^{n}}",
      "diagram": "quantization"
    },
    {
      "id": "quantization-error",
      "term": "Quantization error",
      "definition": "Difference between quantized value and original sample value.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.3"
      ],
      "formula": "e=x_{q}-x,\\quad|e|\\le\\frac{\\Delta}{2}"
    },
    {
      "id": "companding",
      "term": "Companding",
      "definition": "Compression at transmitter and expansion at receiver for nonuniform quantization.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.3"
      ],
      "formula": "y=\\frac{\\ln(1+\\mu|x|)}{\\ln(1+\\mu)}\\,\\text{sgn}(x)"
    },
    {
      "id": "dpcm",
      "term": "Differential PCM (DPCM)",
      "definition": "Transmits difference between successive samples to reduce redundancy.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.3"
      ],
      "formula": "e[n]=x[n]-\\hat{x}[n-1]"
    },
    {
      "id": "delta-modulation",
      "term": "Delta modulation",
      "definition": "One-bit PCM transmitting whether sample increased or decreased.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.2"
      ],
      "formula": "y[n]=y[n-1]+\\Delta\\,\\text{sgn}\\left(x[n]-y[n-1]\\right)"
    },
    {
      "id": "slope-overload",
      "term": "Slope overload",
      "definition": "Delta modulation distortion when signal changes faster than step size tracks.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.92"
      ],
      "formula": "\\left|\\frac{dx}{dt}\\right|_{\\max}>\\frac{\\Delta}{T_{s}}"
    },
    {
      "id": "granular-noise",
      "term": "Granular noise",
      "definition": "Delta modulation noise for slowly varying signal amplitudes.",
      "unit": 4,
      "unitTitle": "Pulse Modulation",
      "sources": [
        "adc-adc-unit-iv#slide.3"
      ],
      "formula": "\\overline{e^{2}}=\\frac{\\Delta^{2}}{3}"
    },
    {
      "id": "line-coding",
      "term": "Line coding",
      "definition": "Process of converting a sequence of binary data bits into a specific digital waveform suitable for transmission over a channel.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.2"
      ],
      "formula": "c(t)=\\sum_{n}a_{n}\\,p(t-nT_{b})",
      "diagram": "line-coding"
    },
    {
      "id": "isi",
      "term": "Inter-symbol interference",
      "definition": "Interference from previous symbols in a digital transmission.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.14"
      ],
      "formula": "y(t_{k})=a_{k}h(0)+\\sum_{n\\neq k}a_{n}\\,h(t_{k}-nT_{s})",
      "diagram": "eye-diagram"
    },
    {
      "id": "eye-diagram",
      "term": "Eye diagram",
      "definition": "Oscilloscope display used to assess digital signal quality.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.2"
      ],
      "formula": "",
      "diagram": "eye-diagram"
    },
    {
      "id": "matched-filter",
      "term": "Matched filter",
      "definition": "Filter that maximizes SNR for a known pulse shape.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.14"
      ],
      "formula": "h(t)=s(T_{0}-t)"
    },
    {
      "id": "ask",
      "term": "Amplitude shift keying (ASK)",
      "definition": "Digital modulation scheme in which the amplitude of a sinusoidal carrier is varied in accordance with the binary data.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.7"
      ],
      "formula": "s(t)=A\\,b_{n}\\cos\\omega_{c}t,\\quad b_{n}\\in\\{0,1\\}",
      "diagram": "ask-fsk-psk"
    },
    {
      "id": "fsk",
      "term": "Frequency shift keying (FSK)",
      "definition": "Digital modulation scheme in which the frequency of a sinusoidal carrier is varied in accordance with the binary data.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.4"
      ],
      "formula": "s(t)=A\\cos\\left(2\\pi f_{i}t\\right),\\quad f_{i}=f_{c}\\pm\\Delta f",
      "diagram": "ask-fsk-psk"
    },
    {
      "id": "psk",
      "term": "Phase shift keying (PSK)",
      "definition": "Digital modulation scheme in which the phase of a sinusoidal carrier is varied in accordance with the binary data.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.10"
      ],
      "formula": "s(t)=A\\cos\\left(\\omega_{c}t+\\phi_{n}\\right)",
      "diagram": "ask-fsk-psk"
    },
    {
      "id": "qpsk",
      "term": "Quadrature PSK (QPSK)",
      "definition": "Four phase states encoding two bits per symbol.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.2"
      ],
      "formula": "s(t)=A\\cos\\left(\\omega_{c}t+\\frac{(2n-1)\\pi}{4}\\right)",
      "diagram": "qam"
    },
    {
      "id": "dpsk",
      "term": "Differential PSK (DPSK)",
      "definition": "Encodes data in phase difference, avoiding coherent carrier.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.2"
      ],
      "formula": "\\Delta\\phi_{n}=\\phi_{n}-\\phi_{n-1}\\in\\{0,\\pi\\}"
    },
    {
      "id": "ber",
      "term": "Bit error rate (BER)",
      "definition": "Number of bit errors divided by total bits transmitted.",
      "unit": 5,
      "unitTitle": "Digital Modulation Techniques",
      "sources": [
        "adc-adc-unit-v#slide.2"
      ],
      "formula": "P_{e}=\\frac{N_{e}}{N}"
    },
    {
      "id": "entropy",
      "term": "Entropy",
      "definition": "Average amount of information conveyed per symbol by a source, given by the expectation of the self-information of its symbols.",
      "formula": "H=-\\sum_{i}p_{i}\\log_{2}p_{i}",
      "unit": 6,
      "unitTitle": "Information Theory & Coding",
      "sources": [
        "adc-adc-unit-vi#slide.7"
      ]
    },
    {
      "id": "channel-capacity",
      "term": "Channel capacity",
      "definition": "Maximum rate of information transmissible over a channel.",
      "unit": 6,
      "unitTitle": "Information Theory & Coding",
      "sources": [
        "adc-adc-unit-vi#slide.2"
      ],
      "formula": "C=\\max_{p(x)}I(X;Y)"
    },
    {
      "id": "shannon-hartley",
      "term": "Shannon-Hartley theorem",
      "definition": "Theorem giving channel capacity C = B log₂(1 + S/N) for a channel corrupted by additive white Gaussian noise.",
      "formula": "C=B\\log_{2}\\left(1+\\frac{S}{N}\\right)",
      "unit": 6,
      "unitTitle": "Information Theory & Coding",
      "sources": [
        "adc-adc-unit-vi#slide.2"
      ]
    },
    {
      "id": "huffman-coding",
      "term": "Huffman coding",
      "definition": "Variable-length coding assigning shorter codes to frequent messages.",
      "unit": 6,
      "unitTitle": "Information Theory & Coding",
      "sources": [
        "adc-adc-unit-vi#slide.2"
      ],
      "formula": "\\bar{L}=\\sum_{i}p_{i}l_{i},\\quad H\\le\\bar{L}<H+1"
    },
    {
      "id": "hamming-distance",
      "term": "Hamming distance",
      "definition": "Number of differing bit positions between two codewords.",
      "unit": 6,
      "unitTitle": "Information Theory & Coding",
      "sources": [
        "adc-adc-unit-vi#slide.2"
      ],
      "formula": "d(\\mathbf{x},\\mathbf{y})=\\sum_{i}x_{i}\\oplus y_{i}"
    },
    {
      "id": "crc",
      "term": "Cyclic redundancy check",
      "definition": "Error detection technique that appends a remainder obtained by polynomial division of the data to the transmitted frame.",
      "unit": 6,
      "unitTitle": "Information Theory & Coding",
      "sources": [
        "adc-adc-unit-vi#slide.2"
      ],
      "formula": "r(x)=\\text{rem}\\left[\\frac{x^{n-k}m(x)}{g(x)}\\right]"
    }
  ]
}
