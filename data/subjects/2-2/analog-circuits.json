  "definitions": [
    {
      "id": "amplifier",
      "term": "Amplifier",
      "definition": "A device that increases the amplitude of a signal without changing its frequency.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "faithful-amplification",
      "term": "Faithful amplification",
      "definition": "Amplification in which the output waveform is an exact replica of the input waveform.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "distortion",
      "term": "Distortion",
      "definition": "Any change in the shape of the signal waveform during amplification.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "nonlinear-distortion",
      "term": "Nonlinear distortion",
      "definition": "Distortion that introduces new frequency components not present in the input.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "class-a-amplifier",
      "term": "Class A amplifier",
      "definition": "An amplifier in which the transistor conducts for the full 360 degrees of the input cycle.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "class-b-amplifier",
      "term": "Class B amplifier",
      "definition": "An amplifier in which the transistor conducts for 180 degrees of the input cycle.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "class-c-amplifier",
      "term": "Class C amplifier",
      "definition": "An amplifier in which the transistor conducts for less than 180 degrees of the input cycle.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "small-signal-amplifier",
      "term": "Small-signal amplifier",
      "definition": "Circuit that boosts low-amplitude alternating waveforms with the transistor kept in its active region.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "power-amplifier",
      "term": "Power amplifier",
      "definition": "Circuit designed to deliver a large amount of energy per unit time to a load.",
      "unit": 1,
      "unitTitle": "Transistor Amplifiers and Biasing",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "rc-coupling",
      "term": "RC coupling",
      "definition": "Interstage connection using a capacitor and resistor between amplifier stages.",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "transformer-coupling",
      "term": "Transformer coupling",
      "definition": "Interstage connection using a magnetic component for impedance matching.",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "multistage-amplifier",
      "term": "Multistage amplifier",
      "definition": "A cascade of single-stage amplifiers to achieve higher overall gain.",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "overall-gain",
      "term": "Overall gain",
      "definition": "The product of the voltage gains of individual amplifier stages.",
      "formula": "A_v = A_v1 * A_v2 * ...",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ]
    },
    {
      "id": "tuned-amplifier",
      "term": "Tuned amplifier",
      "definition": "An amplifier using a resonant LC circuit to select a narrow band of frequencies.",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-single-tuned-amplifier-analysis#p.1"
      ],
      "formula": ""
    },
    {
      "id": "resonant-frequency",
      "term": "Resonant frequency",
      "definition": "The frequency at which an LC circuit's inductive and capacitive reactances cancel.",
      "formula": "f_r = 1/(2*pi*sqrt(L*C))",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-single-tuned-amplifier-analysis#p.1"
      ]
    },
    {
      "id": "quality-factor",
      "term": "Quality factor (Q)",
      "definition": "Ratio of resonant frequency to the -3 dB bandwidth of a tuned circuit.",
      "formula": "Q = f_r / BW",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-single-tuned-amplifier-analysis#p.1"
      ]
    },
    {
      "id": "bandwidth",
      "term": "Bandwidth",
      "definition": "Frequency range over which amplifier gain is at least 70.7% of its maximum.",
      "unit": 2,
      "unitTitle": "Multistage Amplifiers",
      "sources": [
        "ac-single-tuned-amplifier-analysis#p.1"
      ],
      "formula": ""
    },
    {
      "id": "feedback",
      "term": "Feedback",
      "definition": "Returning a portion of the output signal to the input of an amplifier.",
      "unit": 3,
      "unitTitle": "Feedback Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "negative-feedback",
      "term": "Negative feedback",
      "definition": "Feedback that opposes the input, reducing gain but improving stability and bandwidth.",
      "unit": 3,
      "unitTitle": "Feedback Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "positive-feedback",
      "term": "Positive feedback",
      "definition": "Feedback that aids the input and can lead to oscillation.",
      "unit": 3,
      "unitTitle": "Feedback Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "feedback-factor",
      "term": "Feedback factor",
      "definition": "The fraction of the output signal that is fed back to the input.",
      "formula": "beta",
      "unit": 3,
      "unitTitle": "Feedback Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ]
    },
    {
      "id": "closed-loop-gain",
      "term": "Closed-loop gain",
      "definition": "The overall gain of an amplifier operating with feedback applied, given by Af = A/(1+Aβ) and far less sensitive to parameter variations.",
      "formula": "A_f = A/(1 + A*beta)",
      "unit": 3,
      "unitTitle": "Feedback Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ]
    },
    {
      "id": "desensitivity",
      "term": "Desensitivity",
      "definition": "Reduction in amplifier sensitivity to component and parameter variations due to feedback.",
      "unit": 3,
      "unitTitle": "Feedback Amplifiers",
      "sources": [
        "ac-unit-1-2-and-3#p.1"
      ],
      "formula": ""
    },
    {
      "id": "oscillator",
      "term": "Oscillator",
      "definition": "A circuit that generates a periodic output waveform without an external input signal.",
      "unit": 4,
      "unitTitle": "Oscillators and Multivibrators",
      "sources": [
        "ac-iv-multivibrator#p.1"
      ],
      "formula": ""
    },
    {
      "id": "barkhausen-criterion",
      "term": "Barkhausen criterion",
      "definition": "Condition for sustained oscillation: loop gain magnitude at least 1 and total phase shift 0 or 360 degrees.",
      "unit": 4,
      "unitTitle": "Oscillators and Multivibrators",
      "sources": [
        "ac-iv-multivibrator#p.1"
      ],
      "formula": ""
    },
    {
      "id": "multivibrator",
      "term": "Multivibrator",
      "definition": "A two-stage regenerative circuit that produces rectangular or square waveforms.",
      "unit": 4,
      "unitTitle": "Oscillators and Multivibrators",
      "sources": [
        "ac-iv-multivibrator#p.1"
      ],
      "formula": ""
    },
    {
      "id": "astable-multivibrator",
      "term": "Astable multivibrator",
      "definition": "A multivibrator with no stable state that oscillates continuously between two quasi-stable states.",
      "unit": 4,
      "unitTitle": "Oscillators and Multivibrators",
      "sources": [
        "ac-iv-multivibrator#p.2"
      ],
      "formula": ""
    },
    {
      "id": "monostable-multivibrator",
      "term": "Monostable multivibrator",
