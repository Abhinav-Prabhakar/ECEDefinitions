      "unit": 4,
      "unitTitle": "Oscillators and Multivibrators",
      "sources": [
        "ac-iv-multivibrator#p.1"
      ],
      "formula": ""
    },
    {
      "id": "bistable-multivibrator",
      "term": "Bistable multivibrator",
