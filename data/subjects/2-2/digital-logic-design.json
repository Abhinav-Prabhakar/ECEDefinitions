  "status": "complete",
  "definitions": [
    {
      "id": "binary-number-system",
      "term": "Binary number system",
      "definition": "A base-2 number system that uses only the digits 0 and 1.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.15"
      ],
      "formula": "N=\\sum_{i=0}^{n-1}b_{i}\\,2^{i},\\quad b_{i}\\in\\{0,1\\}"
    },
    {
      "id": "decimal-number-system",
      "term": "Decimal number system",
      "definition": "A base-10 number system using digits 0 through 9.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.17"
      ],
      "formula": ""
    },
    {
      "id": "octal-number-system",
      "term": "Octal number system",
      "definition": "A base-8 number system using digits 0 through 7.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.18"
      ],
      "formula": "(d)_{8}=(b_{2}b_{1}b_{0})_{2},\\quad d\\in\\{0,\\dots,7\\}"
    },
    {
      "id": "hexadecimal-number-system",
      "term": "Hexadecimal number system",
      "definition": "A base-16 number system using digits 0-9 and letters A-F.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.19"
      ],
      "formula": "(d)_{16}=(b_{3}b_{2}b_{1}b_{0})_{2},\\quad d\\in\\{0,\\dots,F\\}"
    },
    {
      "id": "gray-code",
      "term": "Gray code",
      "definition": "An unweighted code where adjacent values differ in only one bit.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.33"
      ],
      "formula": "g_{i}=b_{i}\\oplus b_{i+1},\\quad g_{n-1}=b_{n-1}",
      "artifact": "digital-logic-design--gray-code"
    },
    {
      "id": "excess-3-code",
      "term": "Excess-3 code",
      "definition": "A self-complementing code obtained by adding 3 to each decimal digit.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.37"
      ],
      "formula": "N_{\\text{XS3}}=N+3,\\quad 0\\le N\\le 9"
    },
    {
      "id": "ones-complement",
      "term": "1's complement",
      "definition": "A binary number formed by toggling every bit of the original number.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.50"
      ],
      "formula": "N_{1}=(2^{n}-1)-N"
    },
    {
      "id": "boolean-algebra",
      "term": "Boolean algebra",
      "definition": "An algebra of logic in which variables take only values 0 or 1.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.39"
      ],
      "formula": "x+\\overline{x}=1,\\quad x\\cdot\\overline{x}=0,\\quad x\\in\\{0,1\\}",
      "artifact": "digital-logic-design--boolean-algebra"
    },
    {
      "id": "maxterm",
      "term": "Maxterm",
      "definition": "A sum term containing all literals of a Boolean function.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.66"
      ],
      "formula": "M_{j}=\\overline{m_{j}},\\quad m_{j}=\\prod_{k=1}^{n}l_{k}"
    },
    {
      "id": "pos-form",
      "term": "POS form",
      "definition": "A Boolean expression formed by ANDing sum terms.",
      "unit": 1,
      "unitTitle": "Number Systems and Boolean Algebra",
      "sources": [
        "dld-dld-unit-1#slide.60"
      ],
      "formula": "F=\\bigwedge_{j=1}^{k}\\left(l_{j1}+l_{j2}+\\cdots+l_{jn}\\right)"
    },
    {
      "id": "logic-gate",
      "term": "Logic gate",
      "definition": "A device that performs a basic logical function in digital circuits.",
      "unit": 2,
      "unitTitle": "Logic Gates and Minimization",
      "sources": [
        "dld-dld-unit-2#slide.3"
      ],
      "formula": "Y=f(A,B,\\dots),\\quad Y\\in\\{0,1\\}",
      "diagram": "logic-gates"
    },
    {
      "id": "universal-gate",
      "term": "Universal gate",
      "definition": "A gate (NAND or NOR) that can implement any logic function.",
      "unit": 2,
      "unitTitle": "Logic Gates and Minimization",
      "sources": [
        "dld-dld-unit-2#slide.17"
      ],
      "formula": "\\overline{A\\cdot B}=\\overline{A}+\\overline{B},\\quad \\overline{A+B}=\\overline{A}\\cdot\\overline{B}"
    },
    {
      "id": "karnaugh-map",
      "term": "Karnaugh map",
      "definition": "A graphical method for simplifying Boolean functions by grouping adjacent cells containing 1s in powers of two.",
      "unit": 2,
      "unitTitle": "Logic Gates and Minimization",
      "sources": [
        "dld-dld-unit-2#slide.21"
      ],
      "formula": "x\\,y+x\\,\\overline{y}=x",
      "diagram": "kmap",
      "artifact": "digital-logic-design--karnaugh-map"
    },
    {
      "id": "prime-implicant",
      "term": "Prime implicant",
      "definition": "A product or sum term that cannot be further reduced.",
      "unit": 2,
      "unitTitle": "Logic Gates and Minimization",
      "sources": [
        "dld-dld-unit-2#slide.32"
      ],
      "formula": "P\\Rightarrow F,\\ \\nexists\\,P'\\subsetneq P:\\ P'\\Rightarrow F"
    },
    {
      "id": "essential-prime-implicant",
      "term": "Essential prime implicant",
      "definition": "A prime implicant covering a minterm no other implicant covers.",
      "unit": 2,
      "unitTitle": "Logic Gates and Minimization",
      "sources": [
        "dld-dld-unit-2#slide.32"
      ],
      "formula": "\\exists\\,m_{i}\\in P:\\ m_{i}\\notin\\bigcup_{P'\\neq P}P'"
    },
    {
      "id": "dont-care",
      "term": "Don't care",
      "definition": "An undefined output for some inputs, usable as 0 or 1 in minimization.",
      "unit": 2,
      "unitTitle": "Logic Gates and Minimization",
      "sources": [
        "dld-dld-unit-2#slide.33"
      ],
      "formula": "F=\\sum_{i}m_{i}+\\sum_{j}x_{j}\\,d_{j},\\quad x_{j}\\in\\{0,1\\}",
      "diagram": "kmap"
    },
    {
      "id": "quine-mccluskey",
      "term": "Quine-McCluskey method",
      "definition": "A tabular method for minimizing Boolean functions using prime implicants.",
      "unit": 2,
      "unitTitle": "Logic Gates and Minimization",
      "sources": [
        "dld-dld-unit-2#slide.45"
      ],
      "formula": "A\\,B\\,C+A\\,B\\,\\overline{C}=A\\,B"
    },
    {
      "id": "combinational-circuit",
      "term": "Combinational circuit",
      "definition": "A circuit whose outputs depend only on present inputs.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.2"
      ],
      "formula": "Y(t)=f\\bigl(X(t)\\bigr)",
      "diagram": "logic-gates"
    },
    {
      "id": "half-adder",
      "term": "Half adder",
      "definition": "A circuit that adds two bits and produces sum and carry.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.21"
      ],
      "formula": "S=A\\oplus B,\\quad C=A\\cdot B"
    },
    {
      "id": "full-adder",
      "term": "Full adder",
      "definition": "A circuit that adds three binary bits producing sum and carry.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.25"
      ],
      "formula": "S=A\\oplus B\\oplus C_{\\text{in}},\\quad C_{\\text{out}}=A\\,B+C_{\\text{in}}(A\\oplus B)",
      "artifact": "digital-logic-design--full-adder"
    },
    {
      "id": "half-subtractor",
      "term": "Half subtractor",
      "definition": "A circuit that subtracts two bits producing difference and borrow.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.33"
      ],
      "formula": "D=A\\oplus B,\\quad B_{\\text{out}}=\\overline{A}\\,B"
    },
    {
      "id": "full-subtractor",
      "term": "Full subtractor",
      "definition": "A circuit that subtracts three bits producing difference and borrow.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.37"
      ],
      "formula": "D=A\\oplus B\\oplus B_{\\text{in}},\\quad B_{\\text{out}}=\\overline{A}\\,B+B_{\\text{in}}\\,\\overline{A\\oplus B}"
    },
    {
      "id": "multiplexer",
      "term": "Multiplexer",
      "definition": "A circuit that selects one of many inputs to a single output.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.61"
      ],
      "formula": "Y=\\sum_{i=0}^{2^{n}-1}m_{i}\\,D_{i}"
    },
    {
      "id": "demultiplexer",
      "term": "Demultiplexer",
      "definition": "A circuit that routes a single input to one of many outputs.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.83"
      ],
      "formula": "D_{i}=Y\\cdot m_{i},\\quad i\\in\\{0,\\dots,2^{n}-1\\}"
    },
    {
      "id": "encoder",
      "term": "Encoder",
      "definition": "A circuit converting 2^n inputs into an n-bit binary code.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.49"
      ],
      "formula": "n=\\lceil\\log_{2}N\\rceil"
    },
    {
      "id": "decoder",
      "term": "Decoder",
      "definition": "A circuit converting an n-bit code into 2^n outputs.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.53"
      ],
      "formula": "N_{\\text{out}}=2^{n}"
    },
    {
      "id": "parity-bit",
      "term": "Parity bit",
      "definition": "A bit added to data for detecting transmission errors.",
      "unit": 3,
      "unitTitle": "Combinational Logic Design",
      "sources": [
        "dld-dld-unit-3#slide.97"
      ],
      "formula": "P=b_{1}\\oplus b_{2}\\oplus\\cdots\\oplus b_{n}"
    },
    {
      "id": "sequential-circuit",
      "term": "Sequential circuit",
      "definition": "A circuit whose outputs depend on present inputs and state.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.3"
      ],
      "formula": "Y(t)=f\\bigl(X(t),Q(t)\\bigr),\\quad Q(t+1)=g\\bigl(X(t),Q(t)\\bigr)"
    },
    {
      "id": "synchronous-circuit",
      "term": "Synchronous circuit",
      "definition": "A sequential circuit whose memory elements are clocked.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.1"
      ],
      "formula": "Q(t+1)=\\left.f\\bigl(X(t),Q(t)\\bigr)\\right|_{\\text{clk}\\uparrow}"
    },
    {
      "id": "asynchronous-circuit",
      "term": "Asynchronous circuit",
      "definition": "A sequential circuit using unclocked memory elements whose outputs change as soon as the inputs change.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.1"
      ],
      "formula": ""
    },
    {
      "id": "latch",
      "term": "Latch",
      "definition": "A level-sensitive memory element storing one bit, whose output responds to input changes while enabled.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.16"
      ],
      "formula": "Q(t+1)=E\\,D+\\overline{E}\\,Q(t)"
    },
    {
      "id": "flip-flop",
      "term": "Flip-flop",
      "definition": "A clocked bistable memory device storing one bit.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.16"
      ],
      "formula": "",
      "diagram": "d-flipflop"
    },
    {
      "id": "sr-flip-flop",
      "term": "SR flip-flop",
      "definition": "Bistable device with two control inputs that drive its output to either state.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.20"
      ],
      "formula": "Q(t+1)=S+\\overline{R}\\,Q(t),\\quad S\\,R=0"
    },
    {
      "id": "jk-flip-flop",
      "term": "JK flip-flop",
      "definition": "Universal bistable device with no invalid state that supports toggling.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.2"
      ],
      "formula": "Q(t+1)=J\\,\\overline{Q(t)}+\\overline{K}\\,Q(t)",
      "diagram": "d-flipflop",
      "artifact": "digital-logic-design--jk-flip-flop"
    },
    {
      "id": "d-flip-flop",
      "term": "D flip-flop",
      "definition": "Bistable device that stores the data input on the clock edge.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.2"
      ],
      "formula": "Q(t+1)=D",
      "diagram": "d-flipflop"
    },
    {
      "id": "t-flip-flop",
      "term": "T flip-flop",
      "definition": "Bistable device that toggles its state when the control input is high.",
      "unit": 4,
      "unitTitle": "Sequential Circuits and Flip-Flops",
      "sources": [
        "dld-dld-unit-4#slide.2"
      ],
      "formula": "Q(t+1)=T\\oplus Q(t)"
    },
    {
      "id": "counter",
      "term": "Counter",
      "definition": "A circuit that counts applied clock pulses, built from flip-flops driven in a regular sequence.",
      "unit": 5,
      "unitTitle": "Registers and Counters",
      "sources": [
        "dld-dld-unit-5#slide.6"
      ],
      "formula": "M=2^{n},\\quad f_{\\text{MSB}}=\\frac{f_{\\text{clk}}}{2^{n}}",
      "diagram": "counter-timing"
    },
    {
      "id": "ripple-counter",
      "term": "Ripple counter",
      "definition": "An asynchronous counter where each flip-flop clocks the next.",
      "unit": 5,
      "unitTitle": "Registers and Counters",
      "sources": [
        "dld-dld-unit-5#slide.7"
      ],
      "formula": "t_{\\text{pd}}=n\\,t_{\\text{pd,FF}}",
      "diagram": "counter-timing",
      "artifact": "digital-logic-design--ripple-counter"
    },
    {
      "id": "synchronous-counter",
      "term": "Synchronous counter",
      "definition": "A counter in which all flip-flops share a common clock and are triggered simultaneously.",
      "unit": 5,
      "unitTitle": "Registers and Counters",
      "sources": [
        "dld-dld-unit-5#slide.4"
      ],
      "formula": "f_{\\max}=\\frac{1}{t_{\\text{pd}}+t_{\\text{setup}}+t_{\\text{skew}}}",
      "diagram": "counter-timing"
    },
    {
      "id": "ring-counter",
      "term": "Ring counter",
      "definition": "A shift register with feedback forming a ring of states.",
      "unit": 5,
      "unitTitle": "Registers and Counters",
      "sources": [
        "dld-dld-unit-5#slide.20"
      ],
      "formula": "M=n",
      "diagram": "shift-register"
    },
    {
      "id": "johnson-counter",
      "term": "Johnson counter",
      "definition": "A twisted ring counter with inverted feedback from the last flip-flop, producing 2n distinct states.",
      "unit": 5,
      "unitTitle": "Registers and Counters",
      "sources": [
        "dld-dld-unit-5#slide.22"
      ],
      "formula": "M=2n",
      "diagram": "shift-register",
      "artifact": "digital-logic-design--johnson-counter"
    },
    {
      "id": "shift-register",
      "term": "Shift register",
      "definition": "A sequential circuit that stores and shifts data.",
      "unit": 5,
      "unitTitle": "Registers and Counters",
      "sources": [
        "dld-dld-unit-5#slide.25"
      ],
      "formula": "Q_{i}(t+1)=Q_{i-1}(t)",
      "diagram": "shift-register",
      "artifact": "digital-logic-design--shift-register"
    },
    {
      "id": "programmable-logic-device",
      "term": "Programmable logic device",
      "definition": "An IC with programmable AND/OR arrays implementing logic.",
      "unit": 6,
      "unitTitle": "Programmable Logic Devices",
      "sources": [
        "dld-dld-unit-6#slide.3"
      ],
      "formula": ""
    },
    {
      "id": "rom",
      "term": "ROM",
      "definition": "A non-volatile read-only memory storing fixed data that remains intact even when power is removed.",
      "unit": 6,
      "unitTitle": "Programmable Logic Devices",
      "sources": [
        "dld-dld-unit-6#slide.7"
      ],
      "formula": "N_{\\text{bits}}=2^{n}\\cdot m"
    },
    {
      "id": "prom",
      "term": "PROM",
      "definition": "A read-only memory programmable once by the user.",
      "unit": 6,
      "unitTitle": "Programmable Logic Devices",
      "sources": [
        "dld-dld-unit-6#slide.9"
      ],
      "formula": "N_{\\text{fuses}}=2^{n}\\cdot m"
    },
    {
      "id": "pla",
      "term": "PLA",
      "definition": "A device with programmable AND and OR arrays implementing SOP.",
      "unit": 6,
      "unitTitle": "Programmable Logic Devices",
      "sources": [
        "dld-dld-unit-6#slide.20"
      ],
      "formula": "F_{j}=\\sum_{i}P_{i}\\,c_{ij},\\quad c_{ij}\\in\\{0,1\\}",
      "artifact": "digital-logic-design--pla"
    },
    {
      "id": "asm-chart",
      "term": "ASM chart",
      "definition": "A flowchart-like representation of digital hardware algorithms describing events, states and timing relationships.",
      "unit": 6,
      "unitTitle": "Programmable Logic Devices",
      "sources": [
        "dld-dld-unit-6#slide.33"
      ],
      "formula": ""
    }
  ]
}
