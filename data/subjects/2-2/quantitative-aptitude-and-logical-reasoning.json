      "unitTitle": "Number System",
      "sources": [
        "qalr-qalr-unit-1#slide.31"
      ],
      "formula": "\\text{HCF}(a,b)\\cdot\\text{LCM}(a,b)=a\\,b"
    },
    {
      "id": "lcm",
      "term": "Least common multiple (LCM)",
      "definition": "The smallest number that is a multiple of two or more numbers.",
