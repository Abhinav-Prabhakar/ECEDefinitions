      "unitTitle": "Number System",
      "sources": [
        "qalr-qalr-unit-1#slide.8"
      ],
      "formula": "\\gcd(a,b)=1"
    },
    {
      "id": "hcf",
      "term": "Highest common factor (HCF)",
      "definition": "The largest number that divides two or more numbers exactly.",
