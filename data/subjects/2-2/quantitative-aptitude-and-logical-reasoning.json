      "unitTitle": "Number System",
      "sources": [
        "qalr-qalr-unit-1#slide.34"
      ],
      "formula": "\\text{LCM}(a,b)=\\frac{a\\,b}{\\text{HCF}(a,b)}",
      "diagram": "number-line"
    },
    {
      "id": "place-value",
