      "unitTitle": "Number System",
      "sources": [
        "qalr-qalr-unit-1#slide.4"
      ],
      "formula": "\\mathbb{N}=\\{1,2,3,\\dots\\}"
    },
    {
      "id": "whole-number",
      "term": "Whole number",
      "definition": "A counting number including zero: 0, 1, 2, ...",
      "unit": 1,
      "unitTitle": "Number System",
      "sources": [
        "qalr-qalr-unit-1#slide.4"
      ],
      "formula": "\\mathbb{W}=\\{0,1,2,3,\\dots\\}=\\mathbb{N}\\cup\\{0\\}"
    },
    {
      "id": "integer",
      "term": "Integer",
      "definition": "A whole number or its negative: ..., -1, 0, 1, ...",
      "unit": 1,
      "unitTitle": "Number System",
      "sources": [
        "qalr-qalr-unit-1#slide.4"
      ],
      "formula": "\\mathbb{Z}=\\{\\dots,-2,-1,0,1,2,\\dots\\}"
    },
    {
      "id": "composite-number",
      "term": "Composite number",
      "definition": "A positive integer with a divisor other than 1 and itself.",
      "unit": 1,
      "unitTitle": "Number System",
      "sources": [
        "qalr-qalr-unit-1#slide.8"
      ],
      "formula": "n=a\\,b,\\;a,b\\in\\mathbb{N},\\;1<a,b<n"
    },
    {
      "id": "co-prime-numbers",
      "term": "Co-prime numbers",
      "definition": "Two natural numbers whose highest common factor is 1.",
