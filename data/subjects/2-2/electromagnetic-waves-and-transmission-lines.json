  "status": "complete",
  "definitions": [
    {
      "id": "electrostatic-field",
      "term": "Electrostatic field",
      "definition": "The region around a stationary charge in which the charge's electric effect is felt.",
      "formula": "\\mathbf{E}=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q}{r^2}\\hat{\\mathbf{r}}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.4"
      ]
    },
    {
      "id": "coulombs-law",
      "term": "Coulomb's law",
      "definition": "The force between two point charges is along their joining line, proportional to the product of charges and inversely proportional to the square of their separation.",
      "formula": "\\mathbf{F}=\\frac{1}{4\\pi\\varepsilon_0}\\frac{q_1q_2}{r^2}\\hat{\\mathbf{r}}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.6"
      ]
    },
    {
      "id": "electric-field",
      "term": "Electric field",
      "definition": "The force per unit positive charge exerted on a test charge placed at a point.",
      "formula": "\\mathbf{E}=\\frac{\\mathbf{F}}{q}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.19"
      ]
    },
    {
      "id": "gauss-law",
      "term": "Gauss's law",
      "definition": "The total electric flux through a closed surface equals the enclosed charge divided by the permittivity.",
      "formula": "\\oint_S\\mathbf{D}\\cdot d\\mathbf{S}=Q_{\\text{enc}}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.19"
      ]
    },
    {
      "id": "capacitance",
      "term": "Capacitance",
      "definition": "The ratio of charge stored on a conductor to the potential difference applied across it.",
      "formula": "C=\\frac{Q}{V}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.29"
      ]
    },
    {
      "id": "parallel-plate-capacitor",
      "term": "Parallel plate capacitor",
      "definition": "A capacitor formed by two parallel conducting plates separated by a dielectric.",
      "formula": "C=\\frac{\\varepsilon A}{d}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.30"
      ],
      "artifact": "electromagnetic-waves-and-transmission-lines--parallel-plate-capacitor"
    },
    {
      "id": "coaxial-capacitor",
      "term": "Coaxial capacitor",
      "definition": "Component formed by two concentric cylindrical conductors separated by a dielectric.",
      "formula": "C=\\frac{2\\pi\\varepsilon L}{\\ln(b/a)}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.31"
      ]
    },
    {
      "id": "spherical-capacitor",
      "term": "Spherical capacitor",
      "definition": "Component formed by two nested conducting shells separated by a dielectric.",
      "formula": "C=\\frac{4\\pi\\varepsilon ab}{b-a}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.33"
      ]
    },
    {
      "id": "continuity-equation",
      "term": "Continuity equation",
      "definition": "The time rate of decrease of charge in a volume equals the outward current through its surface.",
      "formula": "\\nabla\\cdot\\mathbf{J}=-\\frac{\\partial\\rho}{\\partial t}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.38"
      ]
    },
    {
      "id": "relaxation-time",
      "term": "Relaxation time",
      "definition": "The time for charge placed inside a material to fall to 1/e of its initial value.",
      "formula": "\\tau=\\frac{\\varepsilon}{\\sigma}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.41"
      ],
      "artifact": "electromagnetic-waves-and-transmission-lines--relaxation-time"
    },
    {
      "id": "poisson-equation",
      "term": "Poisson's equation",
      "definition": "Relates the Laplacian of electric potential to the volume charge density.",
      "formula": "\\nabla^2V=-\\frac{\\rho}{\\varepsilon}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.50"
      ]
    },
    {
      "id": "laplace-equation",
      "term": "Laplace's equation",
      "definition": "States that the Laplacian of potential is zero in charge-free regions.",
      "formula": "\\nabla^2V=0",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.50"
      ]
    },
    {
      "id": "maxwell-electrostatic",
      "term": "Maxwell equations (electrostatic)",
      "definition": "Gauss's law plus the conservative, irrotational nature of the electric field for static charges.",
      "formula": "\\nabla\\cdot\\mathbf{D}=\\rho,\\quad\\nabla\\times\\mathbf{E}=0",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-1-electrostatics#slide.52"
      ]
    },
    {
      "id": "magnetostatic-field",
      "term": "Magnetostatic field",
      "definition": "The magnetic field produced by steady (DC) currents or charges in uniform motion.",
      "formula": "\\nabla\\times\\mathbf{H}=\\mathbf{J}",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.3"
      ]
    },
    {
      "id": "biot-savart-law",
      "term": "Biot-Savart law",
      "definition": "The magnetic field due to a current element is proportional to the element and sine of the angle, and inversely proportional to the square of distance.",
      "formula": "d\\mathbf{B}=\\frac{\\mu_0}{4\\pi}\\frac{I\\,d\\mathbf{l}\\times\\hat{\\mathbf{r}}}{r^2}",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.6"
      ]
    },
    {
      "id": "amperes-circuital-law",
      "term": "Ampere's circuital law",
      "definition": "The line integral of magnetic field around a closed path equals the enclosed current.",
      "formula": "\\oint_L\\mathbf{H}\\cdot d\\mathbf{l}=I_{\\text{enc}}",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.8"
      ]
    },
    {
      "id": "lorentz-force",
      "term": "Lorentz force",
      "definition": "The force on a charge moving in electric and magnetic fields.",
      "formula": "\\mathbf{F}=q(\\mathbf{E}+\\mathbf{v}\\times\\mathbf{B})",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.31"
      ]
    },
    {
      "id": "inductance",
      "term": "Inductance",
      "definition": "The ratio of magnetic flux linkage to the current producing it.",
      "formula": "L=\\frac{\\lambda}{I}",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.37"
      ]
    },
    {
      "id": "magnetic-scalar-potential",
      "term": "Magnetic scalar potential",
      "definition": "Single-valued quantity whose negative gradient gives the field intensity H in current-free regions.",
      "formula": "\\mathbf{H}=-\\nabla V_m",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.46"
      ]
    },
    {
      "id": "magnetic-vector-potential",
      "term": "Magnetic vector potential",
      "definition": "Quantity whose curl gives flux density in current-carrying regions.",
      "formula": "\\mathbf{B}=\\nabla\\times\\mathbf{A}",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.48"
      ]
    },
    {
      "id": "maxwell-magnetostatic",
      "term": "Maxwell equations (magnetostatic)",
      "definition": "Ampere's law plus zero divergence of magnetic flux density.",
      "formula": "\\nabla\\times\\mathbf{H}=\\mathbf{J},\\quad\\nabla\\cdot\\mathbf{B}=0",
      "unit": 2,
      "unitTitle": "Magnetostatics",
      "sources": [
        "emtl-u-2-magnetostatics#slide.50"
      ]
    },
    {
      "id": "faradays-law",
      "term": "Faraday's law",
      "definition": "The emf induced in a closed loop equals the time rate of change of magnetic flux through it.",
      "formula": "\\mathcal{E}=-\\frac{d\\Phi}{dt}",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.7"
      ]
    },
    {
      "id": "transformer-emf",
      "term": "Transformer emf",
      "definition": "Emf induced in a stationary loop by a time-varying magnetic field.",
      "formula": "\\mathcal{E}=-N\\frac{d\\Phi}{dt}",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.11"
      ]
    },
    {
      "id": "motional-emf",
      "term": "Motional emf",
      "definition": "Emf induced in a loop moving through a static magnetic field.",
      "formula": "\\mathcal{E}=\\oint_L(\\mathbf{v}\\times\\mathbf{B})\\cdot d\\mathbf{l}",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.13"
      ]
    },
    {
      "id": "displacement-current",
      "term": "Displacement current",
      "definition": "Flow due to time variation of the electric flux density.",
      "formula": "\\mathbf{J}_d=\\frac{\\partial\\mathbf{D}}{\\partial t}",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.18"
      ]
    },
    {
      "id": "modified-amperes-law",
      "term": "Modified Ampere's law",
      "definition": "Magnetomotive force equals conduction current plus displacement current.",
      "formula": "\\oint_L\\mathbf{H}\\cdot d\\mathbf{l}=I_c+\\int_S\\frac{\\partial\\mathbf{D}}{\\partial t}\\cdot d\\mathbf{S}",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.18"
      ]
    },
    {
      "id": "maxwells-equations",
      "term": "Maxwell's equations",
      "definition": "Four equations relating electric and magnetic fields to charges and currents.",
      "formula": "\\nabla\\times\\mathbf{E}=-\\frac{\\partial\\mathbf{B}}{\\partial t},\\quad\\nabla\\times\\mathbf{H}=\\mathbf{J}+\\frac{\\partial\\mathbf{D}}{\\partial t}",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.22"
      ],
      "diagram": "vector-field",
      "artifact": "electromagnetic-waves-and-transmission-lines--maxwells-equations"
    },
    {
      "id": "tangential-e-continuity",
      "term": "Tangential E continuity",
      "definition": "Tangential component of electric field is continuous across any boundary.",
      "formula": "\\hat{\\mathbf{n}}\\times(\\mathbf{E}_1-\\mathbf{E}_2)=0",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.34"
      ]
    },
    {
      "id": "normal-d-continuity",
      "term": "Normal D continuity",
      "definition": "Normal component of electric flux density is continuous across a boundary except at a conductor surface.",
      "formula": "\\hat{\\mathbf{n}}\\cdot(\\mathbf{D}_1-\\mathbf{D}_2)=\\rho_s",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.34"
      ]
    },
    {
      "id": "tangential-h-continuity",
      "term": "Tangential H continuity",
      "definition": "Tangential component of magnetic field is continuous across a boundary except at a conductor surface.",
      "formula": "\\hat{\\mathbf{n}}\\times(\\mathbf{H}_1-\\mathbf{H}_2)=\\mathbf{J}_s",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.35"
      ]
    },
    {
      "id": "normal-b-continuity",
      "term": "Normal B continuity",
      "definition": "Normal component of magnetic flux density is continuous across any boundary.",
      "formula": "\\hat{\\mathbf{n}}\\cdot(\\mathbf{B}_1-\\mathbf{B}_2)=0",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.35"
      ]
    },
    {
      "id": "tem-wave",
      "term": "TEM wave",
      "definition": "An electromagnetic wave with both electric and magnetic fields transverse to the direction of propagation.",
      "formula": "E_z=H_z=0,\\quad\\beta=\\omega\\sqrt{\\mu\\varepsilon}",
      "unit": 3,
      "unitTitle": "Time-varying fields",
      "sources": [
        "emtl-u-3-timevarying-fields#slide.55"
      ],
      "diagram": "em-wave"
    },
    {
      "id": "propagation-constant",
      "term": "Propagation constant",
      "definition": "Complex constant describing attenuation and phase change per unit length of a wave.",
      "formula": "\\gamma=\\alpha+j\\beta",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.10"
      ],
      "diagram": "phasor"
    },
    {
      "id": "attenuation-constant",
      "term": "Attenuation constant",
      "definition": "Real part of propagation constant representing amplitude decay per unit length.",
      "formula": "\\alpha=\\operatorname{Re}\\{\\gamma\\}",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.11"
      ]
    },
    {
      "id": "phase-constant",
      "term": "Phase constant",
      "definition": "Imaginary part of the propagation coefficient representing change in angle per unit length.",
      "formula": "\\beta=\\operatorname{Im}\\{\\gamma\\}=\\frac{2\\pi}{\\lambda}",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.11"
      ],
      "diagram": "phasor"
    },
    {
      "id": "wave-impedance",
      "term": "Wave impedance",
      "definition": "Ratio of electric field to magnetic field in an electromagnetic wave.",
      "formula": "\\eta=\\frac{E}{H}=\\sqrt{\\frac{j\\omega\\mu}{\\sigma+j\\omega\\varepsilon}}",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.11"
      ],
      "diagram": "em-wave",
      "artifact": "electromagnetic-waves-and-transmission-lines--wave-impedance"
    },
    {
      "id": "phase-velocity",
      "term": "Phase velocity",
      "definition": "Speed at which a point of constant phase propagates.",
      "formula": "v_p=\\frac{\\omega}{\\beta}=\\frac{1}{\\sqrt{\\mu\\varepsilon}}",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.11"
      ]
    },
    {
      "id": "poynting-vector",
      "term": "Poynting vector",
      "definition": "Vector representing power radiated per unit area in an electromagnetic field.",
      "formula": "\\mathbf{S}=\\mathbf{E}\\times\\mathbf{H}",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.19"
      ],
      "diagram": "em-wave",
      "artifact": "electromagnetic-waves-and-transmission-lines--poynting-vector"
    },
    {
      "id": "poynting-theorem",
      "term": "Poynting theorem",
      "definition": "Net power leaving a volume equals rate of decrease of stored energy plus ohmic losses.",
      "formula": "-\\oint_S\\mathbf{S}\\cdot d\\mathbf{S}=\\frac{d}{dt}\\int_V\\left(\\frac{\\varepsilon E^2}{2}+\\frac{\\mu H^2}{2}\\right)dV+P_{\\text{loss}}",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.20"
      ],
      "diagram": "em-wave"
    },
    {
      "id": "normal-incidence",
      "term": "Normal incidence",
      "definition": "Incidence of a wave perpendicular to the boundary interface.",
      "formula": "\\Gamma=\\frac{\\eta_2-\\eta_1}{\\eta_2+\\eta_1}",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.27"
      ],
      "diagram": "s-parameters"
    },
    {
      "id": "oblique-incidence",
      "term": "Oblique incidence",
      "definition": "Incidence of a wave at an angle to the normal of the boundary interface.",
      "formula": "n_1\\sin\\theta_i=n_2\\sin\\theta_t",
      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.28"
      ]
    },
    {
      "id": "transmission-line",
      "term": "Transmission line",
      "definition": "Two parallel conductors used to connect a source to a load.",
      "formula": "\\frac{\\partial^2V}{\\partial z^2}=LC\\,\\frac{\\partial^2V}{\\partial t^2}",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.1"
      ],
      "diagram": "tx-line"
    },
    {
      "id": "characteristic-impedance",
      "term": "Characteristic impedance",
      "definition": "Ratio of voltage to current for a wave travelling on a transmission line.",
      "formula": "Z_0=\\sqrt{\\frac{R+j\\omega L}{G+j\\omega C}}",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.3"
      ],
      "diagram": "tx-line",
      "artifact": "electromagnetic-waves-and-transmission-lines--characteristic-impedance"
    },
    {
      "id": "reflection-coefficient",
      "term": "Reflection coefficient",
      "definition": "Ratio of reflected voltage to incident voltage at a load.",
      "formula": "\\Gamma=\\frac{Z_L-Z_0}{Z_L+Z_0}",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.5"
      ],
      "diagram": "tx-line"
    },
    {
      "id": "vswr",
      "term": "VSWR",
      "definition": "Ratio of maximum to minimum voltage on a transmission line.",
      "formula": "\\text{VSWR}=\\frac{1+|\\Gamma|}{1-|\\Gamma|}",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.6"
      ],
      "diagram": "tx-line",
      "artifact": "electromagnetic-waves-and-transmission-lines--vswr"
    },
    {
      "id": "distortionless-line",
      "term": "Distortionless line",
      "definition": "A line in which attenuation constant is frequency independent and phase velocity is constant.",
      "formula": "\\frac{R}{L}=\\frac{G}{C}",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.6"
      ]
    },
    {
      "id": "matched-line",
      "term": "Matched line",
      "definition": "A transmission line whose load impedance equals its characteristic impedance.",
      "formula": "Z_L=Z_0\\;\\Rightarrow\\;\\Gamma=0",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.6"
      ],
      "artifact": "electromagnetic-waves-and-transmission-lines--matched-line"
    },
    {
      "id": "smith-chart",
      "term": "Smith chart",
      "definition": "Graphical tool for solving transmission line impedance matching problems.",
      "formula": "z=\\frac{Z}{Z_0}=\\frac{1+\\Gamma}{1-\\Gamma}",
      "unit": 6,
      "unitTitle": "HF transmission lines",
      "sources": [
        "emtl-u-6-hf-tx-ion-lines#p.1"
      ]
    },
    {
      "id": "reflection-loss",
      "term": "Reflection loss",
      "definition": "Power lost due to reflection at a mismatched load.",
      "formula": "\\frac{P_{\\text{ref}}}{P_{\\text{inc}}}=|\\Gamma|^2",
      "unit": 6,
      "unitTitle": "HF transmission lines",
      "sources": [
        "emtl-u-6-hf-tx-ion-lines#p.6"
      ],
      "diagram": "s-parameters"
    },
    {
      "id": "stub-matching",
      "term": "Stub matching",
      "definition": "Technique of using a short-circuited or open-circuited branch to match a load.",
      "formula": "B_{\\text{stub}}=-B_L",
      "unit": 6,
      "unitTitle": "HF transmission lines",
      "sources": [
        "emtl-u-6-hf-tx-ion-lines#p.6"
      ]
    },
    {
      "id": "gradient",
      "term": "Gradient",
      "definition": "Vector giving maximum rate of change of a scalar field with direction.",
      "formula": "\\nabla V=\\left(\\frac{\\partial V}{\\partial x},\\frac{\\partial V}{\\partial y},\\frac{\\partial V}{\\partial z}\\right)",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-ireview-of-vectors-coordinate-system#slide.2"
      ]
    },
    {
      "id": "divergence",
      "term": "Divergence",
      "definition": "Scalar measure of net outflow of a vector field from a point.",
      "formula": "\\nabla\\cdot\\mathbf{A}=\\frac{\\partial A_x}{\\partial x}+\\frac{\\partial A_y}{\\partial y}+\\frac{\\partial A_z}{\\partial z}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-ireview-of-vectors-coordinate-system#slide.2"
      ],
      "diagram": "vector-field"
    },
    {
      "id": "curl",
      "term": "Curl",
      "definition": "Vector measure of rotation or twisting of a vector field at a point.",
      "formula": "(\\nabla\\times\\mathbf{A})\\cdot\\hat{\\mathbf{n}}=\\lim_{\\Delta s\\to0}\\frac{\\oint_L\\mathbf{A}\\cdot d\\mathbf{l}}{\\Delta s}",
      "unit": 1,
      "unitTitle": "Electrostatics",
      "sources": [
        "emtl-u-ireview-of-vectors-coordinate-system#slide.2"
      ],
      "diagram": "vector-field"
    }
  ]
}
