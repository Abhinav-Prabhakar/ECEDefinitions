      "unit": 4,
      "unitTitle": "Reflection/refraction of EM waves",
      "sources": [
        "emtl-u-4-reflection-refraction-of-em-waves#slide.28"
      ]
    },
    {
      "id": "transmission-line",
      "term": "Transmission line",
      "definition": "Two parallel conductors used to connect a source to a load.",
      "formula": "",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.1"
      ]
    },
    {
      "id": "characteristic-impedance",
      "term": "Characteristic impedance",
      "definition": "Ratio of voltage to current for a wave travelling on a transmission line.",
      "formula": "Z0 = sqrt((R+jωL)/(G+jωC))",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.3"
      ]
    },
    {
      "id": "reflection-coefficient",
      "term": "Reflection coefficient",
      "definition": "Ratio of reflected voltage to incident voltage at a load.",
      "formula": "Γ = (ZL-Z0)/(ZL+Z0)",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.5"
      ]
    },
    {
      "id": "vswr",
      "term": "VSWR",
      "definition": "Ratio of maximum to minimum voltage on a transmission line.",
      "formula": "",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.6"
      ]
    },
    {
      "id": "distortionless-line",
      "term": "Distortionless line",
      "definition": "A line in which attenuation constant is frequency independent and phase velocity is constant.",
      "formula": "",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.6"
      ]
    },
    {
      "id": "matched-line",
      "term": "Matched line",
      "definition": "A transmission line whose load impedance equals its characteristic impedance.",
      "formula": "",
      "unit": 5,
      "unitTitle": "LF transmission lines",
      "sources": [
        "emtl-u-5-lf-tx-ion-lines#p.6"
      ]
    },
    {
      "id": "smith-chart",
      "term": "Smith chart",
