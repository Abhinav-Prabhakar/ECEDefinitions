  "definitions": [
    {
      "id": "artificial-intelligence",
      "term": "Artificial Intelligence",
      "definition": "Design of thinking power in a man-made device; a manufactured cognitive capability.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.7"
      ]
    },
    {
      "id": "rational-agent",
      "term": "Rational agent",
      "definition": "An agent that acts to achieve the best outcome or best expected outcome.",
      "formula": "a^{*}=\\arg\\max_{a}\\sum_{s'}P(s'\\mid s,a)\\,U(s')",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.18"
      ]
    },
    {
      "id": "agent",
      "term": "Agent",
      "definition": "An entity that perceives its environment through sensors and acts through actuators.",
      "formula": "f:\\mathcal{P}^{*}\\to\\mathcal{A}",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.20"
      ]
    },
    {
      "id": "sensor",
      "term": "Sensor",
      "definition": "A device that detects changes in the environment and sends information to the agent.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.23"
      ]
    },
    {
      "id": "actuator",
      "term": "Actuator",
      "definition": "A component that converts energy into motion to perform actions.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.23"
      ]
    },
    {
      "id": "simple-reflex-agent",
      "term": "Simple reflex agent",
      "definition": "An agent that selects actions using condition-action rules on the current percept only.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.30"
      ],
      "diagram": "state-machine"
    },
    {
      "id": "model-based-reflex-agent",
      "term": "Model-based reflex agent",
      "definition": "An agent that uses an internal world model to handle partially observable environments.",
      "formula": "\\hat{s}_{t+1}=\\text{Update}(\\hat{s}_t,a_t,o_{t+1})",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.31"
      ]
    },
    {
      "id": "goal-based-agent",
      "term": "Goal-based agent",
      "definition": "An agent that chooses actions to achieve a specified goal.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.32"
      ]
    },
    {
      "id": "utility-based-agent",
      "term": "Utility-based agent",
      "definition": "An agent that chooses the action with the highest utility among alternatives.",
      "formula": "a^{*}=\\arg\\max_{a\\in A}U(a)",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.33"
      ]
    },
    {
      "id": "breadth-first-search",
      "term": "Breadth-first search",
      "definition": "A search that expands all nodes at the current depth before moving to the next level.",
      "formula": "T_{\\text{BFS}}=O(b^{d})",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.45"
      ],
      "diagram": "graph-search"
    },
    {
      "id": "depth-first-search",
      "term": "Depth-first search",
      "definition": "A search that follows each path to its greatest depth before backtracking.",
      "formula": "T_{\\text{DFS}}=O(b^{m})",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.50"
      ],
      "diagram": "graph-search"
    },
    {
      "id": "hill-climbing",
      "term": "Hill climbing",
      "definition": "A local search that iteratively moves to the neighboring state with highest value.",
      "formula": "s_{t+1}=\\arg\\max_{s\\in N(s_t)}f(s)",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.61"
      ]
    },
    {
      "id": "simulated-annealing",
      "term": "Simulated annealing",
      "definition": "A local search combining hill climbing with random moves to escape local maxima.",
      "formula": "P_{\\text{accept}}=e^{-\\Delta E/T}",
      "unit": 1,
      "unitTitle": "Introduction to AI and Agents",
      "sources": [
        "ai-ai-unit-i#slide.70"
      ]
    },
    {
      "id": "zero-sum-game",
      "term": "Zero-sum game",
      "definition": "A game where one agent's gain is exactly balanced by the other's loss.",
      "formula": "u_1(s)+u_2(s)=0",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.8"
      ]
    },
    {
      "id": "game-tree",
      "term": "Game tree",
      "definition": "Structure whose nodes are positions in a contest and edges are moves by players.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.10"
      ]
    },
    {
      "id": "utility-function",
      "term": "Utility function",
      "definition": "A function giving the final numeric value of a terminal game state.",
      "formula": "U:\\mathcal{S}\\to\\mathbb{R}",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.11"
      ]
    },
    {
      "id": "minimax-algorithm",
      "term": "Minimax algorithm",
      "definition": "A recursive algorithm that chooses the optimal move assuming the opponent plays optimally.",
      "formula": "V(s)=\\max_{a}\\min_{a^{\\prime}}V\\!\\left(\\text{Result}(\\text{Result}(s,a),a^{\\prime})\\right)",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.14"
      ],
      "diagram": "recursion-tree"
    },
    {
      "id": "alpha-beta-pruning",
      "term": "Alpha-beta pruning",
      "definition": "A technique that prunes game-tree branches without changing the minimax result.",
      "formula": "\\alpha\\ge\\beta\\Rightarrow\\text{prune}",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.18"
      ]
    },
    {
      "id": "constraint-satisfaction-problem",
      "term": "Constraint satisfaction problem",
      "definition": "A problem of finding values for variables that satisfy all given constraints.",
      "formula": "\\langle X,D,C\\rangle",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.28"
      ]
    },
    {
      "id": "horn-clause",
      "term": "Horn clause",
      "definition": "A disjunction of literals with at most one positive literal.",
      "formula": "\\neg p_1\\lor\\cdots\\lor\\neg p_n\\lor q",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.2"
      ]
    },
    {
      "id": "forward-chaining",
      "term": "Forward chaining",
      "definition": "A data-driven inference that starts from known facts and derives new facts until the goal.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.74"
      ]
    },
    {
      "id": "backward-chaining",
      "term": "Backward chaining",
      "definition": "A goal-driven inference that starts from the goal and works back to known facts.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.9"
      ]
    },
    {
      "id": "unification",
      "term": "Unification",
      "definition": "An algorithm to find substitutions that make two logical expressions identical.",
      "formula": "\\sigma=\\text{mgu}(L_1,L_2)",
      "unit": 2,
      "unitTitle": "Problem Solving and Search",
      "sources": [
        "ai-ai-unit-ii#slide.112"
      ]
    },
    {
      "id": "knowledge-representation",
      "term": "Knowledge representation",
      "definition": "Representing real-world information in a formal language for reasoning.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Knowledge Representation and Logic",
      "sources": [
        "ai-ai-unit-iii#slide.3"
      ]
    },
    {
      "id": "propositional-logic",
      "term": "Propositional logic",
      "definition": "A declarative logic representing facts as true or false using connectives.",
      "formula": "\\phi::=p\\mid\\neg\\phi\\mid\\phi\\land\\psi\\mid\\phi\\lor\\psi",
      "unit": 3,
      "unitTitle": "Knowledge Representation and Logic",
      "sources": [
        "ai-ai-unit-iii#slide.5"
      ]
    },
    {
      "id": "first-order-logic",
      "term": "First-order logic",
