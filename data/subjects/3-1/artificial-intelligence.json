      "diagram": "state-machine"
    },
    {
      "id": "bayesian-network",
      "term": "Bayesian network",
      "definition": "A directed acyclic graph annotated with conditional probability distributions.",
      "formula": "P(X_1,\\ldots,X_n)=\\prod_{i=1}^{n}P(X_i\\mid\\mathrm{Pa}(X_i))",
      "unit": 5,
      "unitTitle": "Probabilistic Reasoning",
      "sources": [
        "ai-ai-unit-v#slide.48"
      ]
    },
