      "id": "direct-evaluation",
      "term": "Direct evaluation",
      "definition": "Brute-force computation straight from the defining sum of the transform, requiring N terms for each of N outputs, about N² operations.",
      "formula": "O(N^{2})",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
