      ]
    },
    {
      "id": "bit-reversal",
      "term": "Bit reversal",
      "definition": "Permutation that swaps each index with the one whose binary digits are written in opposite order, restoring natural output order of in-place radix-2 algorithms.",
      "formula": "n=\\sum_{i=0}^{m-1}b_{i}2^{i}\\ \\mapsto\\ \\sum_{i=0}^{m-1}b_{i}2^{m-1-i}",
