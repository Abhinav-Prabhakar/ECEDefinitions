    {
      "id": "radix-2-fft",
      "term": "Radix-2 FFT",
      "definition": "Divide-and-conquer scheme for power-of-two lengths that splits each transform into two half-length transforms, needing (N/2)log₂N complex multiplications.",
      "formula": "\\frac{N}{2}\\log_{2}N\\ \\text{complex multiplications}",
      "unit": 3,
      "unitTitle": "Fast Fourier Transform",
      "sources": [
        "dsp-wiki-fft#radix-2-cooley-tukey"
