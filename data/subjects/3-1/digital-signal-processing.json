  "status": "complete",
  "definitions": [
    {
      "id": "butterworth-filter",
      "term": "Butterworth filter",
      "definition": "IIR filter whose magnitude response decreases monotonically with frequency and approximates the ideal response as order increases; poles lie on a circle.",
      "formula": "|H(j\\Omega)|=\\frac{1}{\\sqrt{1+(\\Omega/\\Omega_{c})^{2N}}}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.1"
      ],
      "diagram": "bode",
      "artifact": "digital-signal-processing--butterworth-filter"
    },
    {
      "id": "chebyshev-filter",
      "term": "Chebyshev filter",
      "definition": "IIR filter whose magnitude response exhibits ripple in the passband or stopband; poles lie on an ellipse.",
      "formula": "T_{N}(\\cos\\theta)=\\cos(N\\theta)",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.1"
      ]
    },
    {
      "id": "chebyshev-type-i-filter",
      "term": "Chebyshev type I filter",
      "definition": "All-pole Chebyshev filter with equiripple behaviour in the passband and monotonic behaviour in the stopband.",
      "formula": "|H(j\\Omega)|^{2}=\\frac{1}{1+\\varepsilon^{2}T_{N}^{2}(\\Omega/\\Omega_{p})}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.2"
      ]
    },
    {
      "id": "chebyshev-type-ii-filter",
      "term": "Chebyshev type II filter",
      "definition": "Chebyshev filter with both poles and zeros, monotonic in the passband and equiripple in the stopband.",
      "formula": "|H(j\\Omega)|^{2}=\\frac{T_{N}^{2}(\\Omega_{s}/\\Omega)}{T_{N}^{2}(\\Omega_{s}/\\Omega)+\\varepsilon^{2}}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.2"
      ]
    },
    {
      "id": "iir-filter",
      "term": "IIR filter",
      "definition": "Recursive digital filter whose present output depends on present and past inputs and past outputs.",
      "formula": "H(z)=\\frac{\\sum_{k=0}^{M}b_{k}z^{-k}}{1+\\sum_{k=1}^{N}a_{k}z^{-k}}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.1"
      ],
      "diagram": "iir-filter"
    },
    {
      "id": "recursive-realization",
      "term": "Recursive realization",
      "definition": "Realization where the present output is a function of past outputs, past and present inputs; corresponds to an IIR filter.",
      "formula": "y[n]=\\sum_{k=0}^{M}b_{k}x[n-k]-\\sum_{k=1}^{N}a_{k}y[n-k]",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.10"
      ],
      "diagram": "iir-filter"
    },
    {
      "id": "non-recursive-realization",
      "term": "Non-recursive realization",
      "definition": "Realization where the present output depends only on past and present inputs; corresponds to an FIR filter.",
      "formula": "y[n]=\\sum_{k=0}^{M}h[k]\\,x[n-k]",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.10"
      ],
      "diagram": "fir-filter"
    },
    {
      "id": "impulse-invariance-method",
      "term": "Impulse invariance method",
      "definition": "IIR design method that digitizes an analog filter by sampling its impulse response.",
      "formula": "h[n]=T\\,h_{a}(nT)",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.5"
      ],
      "artifact": "digital-signal-processing--impulse-invariance-method"
    },
    {
      "id": "bilinear-transformation",
      "term": "Bilinear transformation",
      "definition": "One-to-one mapping from the s-plane to the z-plane that maps the left half-plane into the unit circle, avoiding aliasing.",
      "formula": "s=\\frac{2}{T}\\,\\frac{1-z^{-1}}{1+z^{-1}}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.5"
      ],
      "diagram": "z-plane",
      "artifact": "digital-signal-processing--bilinear-transformation"
    },
    {
      "id": "warping-effect",
      "term": "Warping effect",
      "definition": "Non-linear frequency compression at high frequencies introduced by the bilinear transformation.",
      "formula": "\\omega=2\\tan^{-1}\\!\\left(\\frac{\\Omega T}{2}\\right)",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.7"
      ]
    },
    {
      "id": "prewarping",
      "term": "Prewarping",
      "definition": "Compensates warping by prescaling critical frequencies before applying the bilinear transformation.",
      "formula": "\\Omega=\\frac{2}{T}\\tan\\!\\left(\\frac{\\omega}{2}\\right)",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.7"
      ]
    },
    {
      "id": "backward-difference",
      "term": "Backward difference",
      "definition": "Simplest analog-to-digital conversion approximating the derivative as (y(n)-y(n-1))/T.",
      "formula": "s=\\frac{1-z^{-1}}{T}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.6"
      ]
    },
    {
      "id": "matched-z-transformation",
      "term": "Matched z-transformation",
      "definition": "Converts an analog filter to digital by mapping each s-plane zero/pole z to e^(sT).",
      "formula": "z=e^{sT}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.7"
      ],
      "diagram": "z-plane"
    },
    {
      "id": "direct-form-i",
      "term": "Direct-form I structure",
      "definition": "IIR realization with separate delay chains for the numerator (zeros) and denominator (poles).",
      "formula": "H(z)=\\left(\\sum_{k=0}^{M}b_{k}z^{-k}\\right)\\frac{1}{1+\\sum_{k=1}^{N}a_{k}z^{-k}}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.10"
      ]
    },
    {
      "id": "direct-form-ii",
      "term": "Direct-form II structure",
      "definition": "IIR realization sharing one delay chain, requiring max(M,N) memory locations.",
      "formula": "w[n]=x[n]-\\sum_{k=1}^{N}a_{k}w[n-k]",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.10"
      ]
    },
    {
      "id": "signal-flow-graph",
      "term": "Signal flow graph",
      "definition": "Graphical representation of the relationships among variables of a set of linear difference equations.",
      "formula": "H=\\frac{1}{\\Delta}\\sum_{k}P_{k}\\Delta_{k}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.12"
      ]
    },
    {
      "id": "transposition-theorem",
      "term": "Transposition theorem",
      "definition": "Reversing branch directions and interchanging input/output leaves the system function unchanged.",
      "formula": "H_{\\text{tr}}(z)=H(z)",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.12"
      ]
    },
    {
      "id": "cascade-form",
      "term": "Cascade form",
      "definition": "Realization of a system as a product of lower-order sections to minimize quantization errors.",
      "formula": "H(z)=\\prod_{k=1}^{K}H_{k}(z)",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.10"
      ]
    },
    {
      "id": "parallel-form",
      "term": "Parallel form",
      "definition": "Realization obtained by partial-fraction expansion of H(z) into parallel first/second-order sections.",
      "formula": "H(z)=C+\\sum_{k=1}^{K}\\frac{A_{k}}{1-p_{k}z^{-1}}",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.10"
      ]
    },
    {
      "id": "iir-linear-phase",
      "term": "Linear phase in IIR",
      "definition": "A causal and stable recursive filter cannot have phase response proportional to frequency because that would require poles outside the unit circle.",
      "formula": "",
      "unit": 4,
      "unitTitle": "IIR filter design",
      "sources": [
        "dsp-unit-4-dsp-questions#p.6"
      ]
    },
    {
      "id": "fir-filter",
      "term": "FIR filter",
      "definition": "Non-recursive digital filter whose present output depends on the present and past inputs only; always stable.",
      "formula": "H(z)=\\sum_{n=0}^{N-1}h[n]z^{-n}",
      "unit": 5,
      "unitTitle": "FIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.1"
      ],
      "diagram": "fir-filter"
    },
    {
      "id": "linear-phase-filter",
      "term": "Linear phase filter",
      "definition": "System whose delay is constant across frequency, preserving signal shape; FIR can be exact if impulse response is symmetric.",
      "formula": "\\theta(\\omega)=-\\alpha\\omega",
      "unit": 5,
      "unitTitle": "FIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.1"
      ],
      "artifact": "digital-signal-processing--linear-phase-filter"
    },
    {
      "id": "gibbs-phenomenon",
      "term": "Gibbs phenomenon",
      "definition": "Oscillations in passband and stopband caused by abrupt truncation of the infinite Fourier series.",
      "formula": "\\Delta\\approx8.95\\%",
      "unit": 5,
      "unitTitle": "FIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.7"
      ]
    },
    {
      "id": "window-function",
      "term": "Window function",
      "definition": "Finite weighing sequence multiplied with the infinite impulse response to reduce Gibbs oscillations.",
      "formula": "h[n]=h_{d}[n]\\,w[n]",
      "unit": 5,
      "unitTitle": "FIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.8"
      ],
      "diagram": "windowing",
      "artifact": "digital-signal-processing--window-function"
    },
    {
      "id": "kaiser-window",
      "term": "Kaiser window",
      "definition": "Adjustable window whose main-lobe width and side-lobe level can be varied via a parameter using a Bessel function.",
      "formula": "w[n]=\\frac{I_{0}\\!\\left(\\beta\\sqrt{1-\\left(\\frac{2n}{N-1}\\right)^{2}}\\right)}{I_{0}(\\beta)}",
      "unit": 5,
      "unitTitle": "FIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.11"
      ],
      "diagram": "windowing"
    },
    {
      "id": "frequency-sampling-method",
      "term": "Frequency sampling method",
      "definition": "FIR design technique that specifies the desired response at discrete points and obtains coefficients by IDFT.",
      "formula": "h[n]=\\frac{1}{N}\\sum_{k=0}^{N-1}H[k]\\,e^{j2\\pi kn/N}",
      "unit": 5,
      "unitTitle": "FIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.2"
      ]
    },
    {
      "id": "fir-stability",
      "term": "FIR filter stability",
      "definition": "An FIR filter is always stable because all its poles are at the origin.",
      "formula": "\\text{ROC}: |z|>0",
      "unit": 5,
      "unitTitle": "FIR filter design",
      "sources": [
        "dsp-dsp-unit-5-questions#p.2"
      ]
    },
    {
      "id": "multirate-signal-processing",
      "term": "Multirate signal processing",
      "definition": "Processing discrete-time signals at more than one sampling rate within a system.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.1"
      ]
    },
    {
      "id": "downsampling",
      "term": "Downsampling",
      "definition": "Reducing the sampling rate by factor M by keeping every M-th sample and discarding the rest.",
      "formula": "y[n]=x[Mn]",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.1"
      ],
      "diagram": "multirate"
    },
    {
      "id": "upsampling",
      "term": "Upsampling",
      "definition": "Increasing the sampling rate by factor L by inserting L-1 zeros between consecutive samples.",
      "formula": "y[n]=x[n/L]\\ \\text{if }L\\mid n,\\ 0\\ \\text{otherwise}",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.9"
      ]
    },
    {
      "id": "decimation",
      "term": "Decimation",
      "definition": "Filtering a signal with an anti-aliasing filter followed by downsampling to avoid aliasing.",
      "formula": "y[n]=(x*h)[Mn]",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.5"
      ]
    },
    {
      "id": "interpolation",
      "term": "Interpolation",
      "definition": "Upsampling followed by filtering with an anti-imaging filter to remove image spectra.",
      "formula": "y[n]=(x_{\\uparrow L}*h)[n]",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.12"
      ],
      "diagram": "multirate"
    },
    {
      "id": "anti-aliasing-filter",
      "term": "Anti-aliasing filter",
      "definition": "Lowpass filter applied before downsampling with cutoff π/M to prevent aliasing.",
      "formula": "\\omega_{c}=\\pi/M",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.5"
      ]
    },
    {
      "id": "anti-imaging-filter",
      "term": "Anti-imaging filter",
      "definition": "Lowpass filter applied after upsampling with cutoff π/L to remove image spectra.",
      "formula": "\\omega_{c}=\\pi/L",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.12"
      ]
    },
    {
      "id": "sampling-rate-conversion",
      "term": "Sampling rate conversion",
      "definition": "Converting a signal from one sampling rate to another by rational factor L/M using interpolation then decimation.",
      "formula": "F_{\\text{new}}=\\frac{L}{M}F_{s}",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.19"
      ]
    },
    {
      "id": "aliasing",
      "term": "Aliasing",
      "definition": "Spectral overlap that occurs when downsampling a signal not band-limited to π/M.",
      "formula": "f_{a}=\\left|f-\\operatorname{round}\\!\\left(\\frac{f}{F_{s}}\\right)F_{s}\\right|",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.5"
      ],
      "diagram": "aliasing"
    },
    {
      "id": "imaging",
      "term": "Imaging",
      "definition": "Extra spectral copies introduced by upsampling a discrete-time signal.",
      "formula": "X_{\\uparrow L}(e^{j\\omega})=X\\!\\left(e^{j\\omega L}\\right)",
      "unit": 6,
      "unitTitle": "Multirate signal processing",
      "sources": [
        "dsp-dsp-unit-6#p.12"
      ]
    },
    {
      "id": "discrete-time-signal",
      "term": "Discrete-time signal",
      "definition": "Sequence of quantities defined only at separate instants, obtainable by sampling a continuously varying waveform.",
      "formula": "x[n]=x_{a}(nT)",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-discrete-signal#discrete-time"
      ],
      "diagram": "sampling"
    },
    {
      "id": "periodic-sequence",
      "term": "Periodic sequence",
      "definition": "Series of samples satisfying x[n + N] = x[n] for every n, so the pattern repeats every N samples.",
      "formula": "x[n+N]=x[n]",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-dfs#introduction"
      ]
    },
    {
      "id": "unit-impulse",
      "term": "Unit impulse",
      "definition": "Sample pattern equal to one at index zero and zero at every other index, also called the Kronecker delta.",
      "formula": "\\delta[n]=1\\ \\text{for }n=0,\\quad 0\\ \\text{otherwise}",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-lti#discrete-time-systems"
      ]
    },
    {
      "id": "linear-shift-invariant-system",
      "term": "Linear shift-invariant system",
      "definition": "Discrete-domain processor obeying superposition whose behavior is unchanged by delaying the input, fully described by its impulse response.",
      "formula": "T\\{x[n-k]\\}=y[n-k],\\quad T\\{ax_{1}+bx_{2}\\}=aT\\{x_{1}\\}+bT\\{x_{2}\\}",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-lti#definition"
      ]
    },
    {
      "id": "impulse-response",
      "term": "Impulse response",
      "definition": "Output h[n] produced when a unit sample at index zero is applied, completely characterizing a linear shift-invariant processor.",
      "formula": "h[n]=T\\{\\delta[n]\\}",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-lti#impulse-response-and-convolution"
      ]
    },
    {
      "id": "convolution-sum",
      "term": "Convolution sum",
      "definition": "Output formula expressing a linear shift-invariant processor's response as the input combined with its characteristic output h[n].",
      "formula": "y[n]=\\sum_{k=-\\infty}^{\\infty}x[k]\\,h[n-k]",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-lti#impulse-response-and-convolution"
      ],
      "diagram": "convolution"
    },
    {
      "id": "causality",
      "term": "Causality",
      "definition": "Property that the output at any instant depends only on present and past inputs, equivalent to an impulse response that is zero for n < 0.",
      "formula": "h[n]=0\\ \\text{for }n<0",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-causal#discrete-time-causality-via-the-impulse-response"
      ]
    },
    {
      "id": "bibo-stability",
      "term": "BIBO stability",
      "definition": "Property guaranteeing finite outputs for every finite-amplitude excitation, which for discrete shift-invariant processors holds when the impulse response is absolutely summable.",
      "formula": "\\sum_{n=-\\infty}^{\\infty}|h[n]|<\\infty",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-bibo#time-domain-condition-for-lti-systems"
      ]
    },
    {
      "id": "linear-constant-coefficient-difference-equation",
      "term": "Linear constant-coefficient difference equation",
      "definition": "Recurrence expressing each term of a sequence as a fixed-weight combination of earlier terms, used to describe discrete processors.",
      "formula": "\\sum_{k=0}^{N}a_{k}y[n-k]=\\sum_{m=0}^{M}b_{m}x[n-m]",
      "unit": 1,
      "unitTitle": "Introduction to Discrete-Time Signals and Systems",
      "sources": [
        "dsp-wiki-linear-recurrence#definitions"
      ]
    },
    {
      "id": "discrete-fourier-series",
      "term": "Discrete Fourier series",
      "definition": "Expansion of a repeating sample pattern into N complex exponentials that are harmonics of the fundamental digital frequency 1/N.",
      "formula": "c_{k}=\\frac{1}{N}\\sum_{n=0}^{N-1}x[n]\\,e^{-j2\\pi kn/N}",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
        "dsp-wiki-dfs#introduction"
      ]
    },
    {
      "id": "dtft",
      "term": "DTFT",
      "definition": "Transform mapping a sample sequence to a continuous function of angular frequency that repeats every 2π.",
      "formula": "X(e^{j\\omega})=\\sum_{n=-\\infty}^{\\infty}x[n]\\,e^{-j\\omega n}",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
        "dsp-wiki-dtft#definition"
      ],
      "diagram": "fourier"
    },
    {
      "id": "dft",
      "term": "DFT",
      "definition": "Transform mapping N complex numbers to N complex numbers, giving equally spaced samples of the DTFT of a finite sequence.",
      "formula": "X[k]=\\sum_{n=0}^{N-1}x[n]\\,e^{-j2\\pi kn/N}",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
        "dsp-wiki-dft#definition"
      ],
      "artifact": "digital-signal-processing--dft"
    },
    {
      "id": "inverse-dft",
      "term": "Inverse DFT",
      "definition": "Transform recovering the original N samples using the opposite exponent sign and a 1/N normalization.",
      "formula": "x[n]=\\frac{1}{N}\\sum_{k=0}^{N-1}X[k]\\,e^{j2\\pi kn/N}",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
        "dsp-wiki-dft#definition"
      ]
    },
    {
      "id": "circular-shift-property",
      "term": "Circular shift property",
      "definition": "Duality where multiplying the input by a linear phase rotates the output indices modulo N, and a rotated input multiplies the output by a linear phase.",
      "formula": "x[(n-m)\\bmod N]\\ \\leftrightarrow\\ X[k]\\,e^{-j2\\pi km/N}",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
        "dsp-wiki-dft#properties"
      ]
    },
    {
      "id": "circular-convolution",
      "term": "Circular convolution",
      "definition": "Operation combining two length-N sequences with indices wrapped modulo N, corresponding to pointwise multiplication of their DFTs.",
      "formula": "y[n]=\\sum_{m=0}^{N-1}x[m]\\,h[(n-m)\\bmod N]",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
        "dsp-wiki-circular-convolution#definition"
      ]
    },
    {
      "id": "overlap-add",
      "term": "Overlap-add",
      "definition": "Block-processing technique that splits a long input into segments, filters each using FFT-based circular operations after appended zeros, and sums the intersecting output pieces.",
      "formula": "y[n]=\\sum_{m}y_{m}[n-mL]",
      "unit": 2,
      "unitTitle": "Discrete Fourier Transform",
      "sources": [
        "dsp-wiki-overlap-add#definition"
      ],
      "artifact": "digital-signal-processing--overlap-add"
    },
    {
      "id": "overlap-save",
      "term": "Overlap-save",
      "definition": "Block-processing technique that reuses the last M−1 input samples of each block, filters by circular operations, and discards the first M−1 corrupted outputs.",
      "formula": "N\\ge L+M-1",
      "unit": 2,
