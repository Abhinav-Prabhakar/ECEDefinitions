      "diagram": "fft-stages"
    },
    {
      "id": "decimation-in-time",
      "term": "Decimation in time",
      "definition": "Radix-2 splitting that separates the input into even-indexed and odd-indexed samples, transforms each half and combines the results.",
      "formula": "X[k]=E[k]+W_{N}^{k}O[k]",
      "unit": 3,
      "unitTitle": "Fast Fourier Transform",
      "sources": [
        "dsp-wiki-cooley-tukey#radix-2-dit"
      ],
      "diagram": "fft-stages"
