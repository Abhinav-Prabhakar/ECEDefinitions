      ]
    },
    {
      "id": "fft",
      "term": "FFT",
      "definition": "Any algorithm computing the DFT or its inverse in O(N log N) operations, producing the same results as direct evaluation.",
      "formula": "O(N\\log_{2}N)",
      "unit": 3,
      "unitTitle": "Fast Fourier Transform",
      "sources": [
