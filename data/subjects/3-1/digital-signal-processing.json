    {
      "id": "decimation-in-frequency",
      "term": "Decimation in frequency",
      "definition": "Radix-2 variant, also known as the Sande–Tukey algorithm, obtained by reversing the order of the splitting steps of its time-domain counterpart.",
      "formula": "X[2k]=\\sum_{n=0}^{N/2-1}\\left(x[n]+x[n+N/2]\\right)W_{N/2}^{kn}",
      "unit": 3,
      "unitTitle": "Fast Fourier Transform",
      "sources": [
        "dsp-wiki-cooley-tukey#radix-2-dif"
      ]
    },
    {
      "id": "butterfly",
      "term": "Butterfly",
      "definition": "Size-2 transform that combines even and odd sub-results by forming their sum and difference after scaling the odd part by a twiddle factor.",
      "formula": "y_{0}=a+W_{N}^{k}b,\\quad y_{1}=a-W_{N}^{k}b",
