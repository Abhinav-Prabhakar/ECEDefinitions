      "unitTitle": "Linear Wire Antennas and Arrays",
      "sources": [
        "awp-unit-2-part-2#p.53"
      ]
    },
    {
      "id": "uniqueness-theorem",
      "term": "Uniqueness theorem",
      "definition": "For given sources and boundary conditions in a lossy medium, Maxwell's equation solutions are unique.",
