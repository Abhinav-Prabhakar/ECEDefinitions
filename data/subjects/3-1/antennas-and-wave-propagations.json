  "definitions": [
    {
      "id": "hertzian-dipole",
      "term": "Hertzian dipole",
      "definition": "A small current element terminated at both ends with small spheres or discs.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.20"
      ]
    },
    {
      "id": "radiation-mechanism",
      "term": "Radiation mechanism",
      "definition": "Creating fields and coupling energy to free space in the desired direction produced by accelerated or decelerated charge.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.25"
      ]
    },
    {
      "id": "antenna",
      "term": "Antenna",
      "definition": "A transition device or transducer between a guided wave on a transmission line and a free-space wave.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.26"
      ]
    },
    {
      "id": "radiation-pattern",
      "term": "Radiation pattern",
      "definition": "A three-dimensional vector field showing field intensity or power as a function of spatial angle.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.36"
      ]
    },
    {
      "id": "major-lobe",
      "term": "Major lobe",
      "definition": "The radiation lobe that contains the maximum radiation, also called the main lobe.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.38"
      ]
    },
    {
      "id": "minor-lobe",
      "term": "Minor lobe",
      "definition": "A radiation lobe containing the minimum radiation in the pattern, representing power wasted in unwanted directions and best kept small.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.38"
      ]
    },
    {
      "id": "side-lobe",
      "term": "Side lobe",
      "definition": "A radiation lobe in any direction other than the intended main lobe.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.38"
      ]
    },
    {
      "id": "e-plane-pattern",
      "term": "E-plane pattern",
      "definition": "The plane containing the electric field vector in the direction of maximum radiation.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.39"
      ]
    },
    {
      "id": "h-plane-pattern",
      "term": "H-plane pattern",
      "definition": "The plane containing the magnetic field vector in the direction of maximum radiation.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.39"
      ]
    },
    {
      "id": "beamwidth",
      "term": "Beamwidth",
      "definition": "The angular separation between two identical points on opposite sides of the pattern maximum.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.42"
      ]
    },
    {
      "id": "hpbw",
      "term": "Half-power beamwidth",
      "definition": "The angle between directions where radiation intensity is half the maximum beam value.",
      "formula": "HPBW",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.42"
      ]
    },
    {
      "id": "polarization",
      "term": "Polarization",
      "definition": "The orientation of the electric field vector in a particular direction.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.45"
      ]
    },
    {
      "id": "linear-polarization",
      "term": "Linear polarization",
      "definition": "A wave is linearly polarized if its electric field remains along a straight line over time.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.46"
      ]
    },
    {
      "id": "circular-polarization",
      "term": "Circular polarization",
      "definition": "Polarization where the electric field vector traces a circle with equal semi-axes.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.50"
      ]
    },
    {
      "id": "antenna-bandwidth",
      "term": "Antenna bandwidth",
      "definition": "The range of frequencies over which the antenna maintains required characteristics.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.52"
      ]
    },
    {
      "id": "beam-solid-angle",
      "term": "Beam solid angle",
      "definition": "The solid angle over which the radiation intensity is maximum, denoted ΩA.",
      "formula": "ΩA",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.53"
      ]
    },
    {
      "id": "directivity",
      "term": "Directivity",
      "definition": "The ratio of radiation intensity in a given direction to the average radiation intensity.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.55"
      ]
    },
    {
      "id": "antenna-gain",
      "term": "Antenna gain",
      "definition": "The realized quantity less than directivity due to ohmic losses in the antenna.",
      "formula": "G = K D",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.57"
      ]
    },
    {
      "id": "radiation-intensity",
      "term": "Radiation intensity",
      "definition": "The power radiated from the antenna per unit solid angle in a given direction.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.59"
      ]
    },
    {
      "id": "reciprocity",
      "term": "Reciprocity",
      "definition": "The transmit and receive properties of an antenna are identical.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.61"
      ]
    },
    {
      "id": "effective-aperture",
      "term": "Effective aperture",
      "definition": "The area of the receiving antenna that absorbs most power from the incoming wavefront.",
      "formula": "Aeff",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.62"
      ]
    },
    {
      "id": "antenna-efficiency",
      "term": "Antenna efficiency",
      "definition": "The ratio of power radiated to the total input power supplied to the antenna.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Fundamental Parameters of Antennas",
      "sources": [
        "awp-unit-1#p.64"
      ]
    },
    {
      "id": "short-dipole",
      "term": "Short dipole",
      "definition": "A dipole whose length is very small compared with the wavelength with uniform current.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Linear Wire Antennas and Arrays",
      "sources": [
        "awp-unit-2-part-1#p.19"
      ]
    },
    {
      "id": "half-wave-dipole",
      "term": "Half-wave dipole",
      "definition": "An antenna whose length equals half a wavelength.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Linear Wire Antennas and Arrays",
      "sources": [
        "awp-unit-2-part-1#p.2"
      ]
    },
    {
      "id": "antenna-array",
      "term": "Antenna array",
      "definition": "A set of two or more antennas combined for improved performance over a single antenna.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Linear Wire Antennas and Arrays",
      "sources": [
        "awp-unit-2-part-2#p.3"
      ]
    },
    {
      "id": "broadside-array",
      "term": "Broadside array",
