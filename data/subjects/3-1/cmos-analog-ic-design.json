{
  "version": 1,
  "id": "cmos-analog-ic-design",
  "semester": "3-1",
  "name": "CMOS Analog IC Design",
  "shortName": "CMOS",
  "code": "9C518",
  "courseType": "PE",
  "elective": "Professional Elective I",
  "folderId": "10Nns1hDMfbWviOrNQyVT3plgIgd6gcsq",
  "folderUrl": "https://drive.google.com/drive/folders/10Nns1hDMfbWviOrNQyVT3plgIgd6gcsq",
  "status": "complete",
  "definitions": [
    {
      "id": "integrated-circuit",
      "term": "Integrated circuit",
      "definition": "Set of electronic circuits on a small chip of semiconductor material, typically silicon, containing transistors, resistors and capacitors.",
      "formula": "",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-unit-1#slide.2"
      ],
      "diagram": "chip-floorplan"
    },
    {
      "id": "analog-ic-design",
      "term": "Analog IC design",
      "definition": "Design of circuits that process continuous signals, focused on amplification, filtering, modulation and voltage regulation.",
      "formula": "",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-unit-1#slide.4"
      ]
    },
    {
      "id": "gate-threshold-voltage",
      "term": "Gate threshold voltage",
      "definition": "Minimum gate-to-source voltage required to create a conductive channel between the source and drain terminals of a field-effect transistor.",
      "formula": "V_{TH}=V_{FB}+2\\phi_F+\\frac{\\sqrt{2q\\varepsilon_s N_A(2\\phi_F)}}{C_{ox}}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.33"
      ]
    },
    {
      "id": "drain-source-on-resistance",
      "term": "Drain-source on-resistance",
      "definition": "Resistance between the drain and source terminals of a MOSFET when it is turned on, set in ohms.",
      "formula": "R_{DS(on)}=\\frac{1}{\\mu_n C_{ox}\\frac{W}{L}(V_{GS}-V_{TH})}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.34"
      ]
    },
    {
      "id": "drain-cut-off-current",
      "term": "Drain cut-off current",
      "definition": "Small leakage current flowing between the drain and source terminals of a FET when the gate-to-source voltage is zero.",
      "formula": "I_{DSS}\\approx I_{0}\\frac{W}{L}e^{-V_{TH}/(nV_T)}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.35"
      ]
    },
    {
      "id": "gate-leakage-current",
      "term": "Gate leakage current",
      "definition": "Small current flowing between the gate and source terminals of a MOSFET when a specified voltage is applied between them.",
      "formula": "J_{G}\\propto e^{-2t_{ox}\\sqrt{2m\\phi_B}/\\hbar}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.38"
      ]
    },
    {
      "id": "drain-source-breakdown-voltage",
      "term": "Drain-source breakdown voltage",
      "definition": "Maximum voltage that can be applied between drain and source, with the gate shorted to the source, without damaging avalanche breakdown.",
      "formula": "V_{(BR)DSS}=\\frac{\\varepsilon_s E_{crit}^{2}}{2qN_B}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.40"
      ]
    },
    {
      "id": "input-capacitance",
      "term": "Input capacitance",
      "definition": "Capacitance between the gate and source terminals with the drain shorted to the source, made up of gate-source and gate-drain capacitances.",
      "formula": "C_{iss}=C_{gs}+C_{gd}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.42"
      ]
    },
    {
      "id": "reverse-transfer-capacitance",
      "term": "Reverse transfer capacitance",
      "definition": "Capacitance between the gate and drain terminals of a MOSFET, also called feedback or Miller capacitance, which affects switching speed.",
      "formula": "C_{rss}=C_{gd}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.43"
      ]
    },
    {
      "id": "output-capacitance",
      "term": "Output capacitance",
      "definition": "Parasitic capacitance measured across the drain-source terminals of a MOSFET in the off state, which affects switching speed.",
      "formula": "C_{oss}=C_{ds}+C_{gd}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.44"
      ]
    },
    {
      "id": "mosfet-operating-regions",
      "term": "MOSFET operating regions",
      "definition": "Cutoff, linear (triode) and saturation, set by the gate-to-source and drain-to-source voltages relative to the threshold voltage.",
      "formula": "V_{DS}<V_{GS}-V_{TH}\\Rightarrow\\text{triode};\\quad V_{DS}>V_{GS}-V_{TH}\\Rightarrow\\text{sat}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-unit-2#slide.45"
      ],
      "diagram": "mosfet-curves"
    },
    {
      "id": "mosfet",
      "term": "MOSFET",
      "definition": "Three-terminal device with gate, drain and source terminals, used to control current.",
      "formula": "I_{D}=\\frac{1}{2}\\mu_n C_{ox}\\frac{W}{L}(V_{GS}-V_{TH})^{2}",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-unit-3#slide.2"
      ],
      "diagram": "mosfet"
    },
    {
      "id": "active-resistor",
      "term": "Active resistor",
      "definition": "Transistor used as a resistor in the triode region, giving compact on-chip area and electronically controllable resistance.",
      "formula": "R_{eq}=\\frac{1}{\\mu_n C_{ox}\\frac{W}{L}\\left(V_{GS}-V_{TH}-\\frac{V_{DS}}{2}\\right)}",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-unit-3#slide.12",
        "cmos-unit-3#slide.13"
      ],
      "diagram": "mosfet-curves"
    },
    {
      "id": "current-sink",
      "term": "Current sink",
      "definition": "Two-terminal component whose current at any instant of time is independent of the voltage across it.",
      "formula": "r_{out}=\\frac{\\partial V_{DS}}{\\partial I_{D}}\\to\\infty",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-unit-3#slide.21"
      ]
    },
    {
      "id": "current-mirror",
      "term": "Current mirror",
      "definition": "Circuit in which two matched transistors share the same gate-to-source voltage, so the output current is a copy of the input current.",
      "formula": "I_{out}=\\frac{(W/L)_{2}}{(W/L)_{1}}I_{ref}",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-unit-3#slide.21"
      ],
      "diagram": "current-mirror"
    },
    {
      "id": "mos-switch",
      "term": "MOS switch",
      "definition": "Transistor operated as a switch, off in cutoff with negligible drain current and on in the triode region.",
      "formula": "\\tau_{sw}=R_{on}(C_{gd}+C_{db}+C_{L})",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-unit-3#slide.26"
      ]
    },
    {
      "id": "differential-amplifier",
      "term": "Differential amplifier",
      "definition": "Circuit that amplifies the difference between two input signals and is immune to external noise and interference.",
      "formula": "A_{d}=g_{m}(r_{o2}\\parallel r_{o4})",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-unit-4-cmos#p.4"
      ],
      "diagram": "differential-pair"
    },
    {
      "id": "early-voltage",
      "term": "Early voltage",
      "definition": "Parameter representing channel-length modulation, showing how drain current rises slightly with drain-to-source voltage even in saturation.",
      "formula": "I_{D}=I_{D0}\\left(1+\\frac{V_{DS}}{V_{A}}\\right)",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-unit-4-cmos#p.44"
      ]
    },
    {
      "id": "load-stage",
      "term": "Load stage",
      "definition": "Part of a differential amplifier, across which the output is taken, that defines gain, bandwidth, output common-mode range and supply rejection.",
      "formula": "",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-unit-4-cmos#p.49"
      ]
    },
    {
      "id": "cascode-amplifier",
      "term": "Cascode amplifier",
      "definition": "Configuration that raises the output resistance of a common-source amplifier in order to achieve higher intrinsic gain.",
      "formula": "R_{out}\\approx g_{m2}r_{o2}r_{o1},\\quad A_{v}\\approx-g_{m1}R_{out}",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-unit-4-cmos#p.57"
      ]
    },
    {
      "id": "intrinsic-gain",
      "term": "Intrinsic gain",
      "definition": "Voltage gain of a transistor stage given by the product of its transconductance and its output resistance.",
      "formula": "A_{v}=g_{m}r_{o}=\\frac{2V_{A}}{V_{OV}}",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-unit-4-cmos#p.63"
      ]
    },
    {
      "id": "open-loop-voltage-gain",
      "term": "Open-loop voltage gain",
      "definition": "Ratio of the change in output voltage to the change in differential input voltage of an op-amp.",
      "formula": "A_{OL}=\\frac{\\Delta V_{out}}{\\Delta(V_{+}-V_{-})}",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.4"
      ]
    },
    {
      "id": "bandwidth",
      "term": "Bandwidth",
      "definition": "Frequency range over which an amplifier can operate effectively.",
      "formula": "BW=f_{H}-f_{L}\\approx f_{H}",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.6"
      ],
      "diagram": "bode"
    },
    {
      "id": "gain-bandwidth-product",
      "term": "Gain-bandwidth product",
      "definition": "Product of open-loop gain and bandwidth, which stays approximately constant as gain falls after the dominant pole.",
      "formula": "GBW=A_{v0}f_{-3dB}=f_{u}",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.6"
      ],
      "diagram": "bode"
    },
    {
      "id": "cmrr",
      "term": "CMRR",
      "definition": "Ability of an op-amp to reject signals common to both inputs, given by the ratio of differential gain to common-mode gain.",
      "formula": "\\text{CMRR}=20\\log_{10}\\left|\\frac{A_{d}}{A_{cm}}\\right|",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.7"
      ]
    },
    {
      "id": "psrr",
      "term": "PSRR",
      "definition": "Measure of how well an op-amp rejects variations or noise in the supply voltage, as a ratio of differential gain to supply-noise gain.",
      "formula": "\\text{PSRR}=20\\log_{10}\\left|\\frac{A_{d}}{A_{dd}}\\right|",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.8"
      ]
    },
    {
      "id": "icmr",
      "term": "ICMR",
      "definition": "Range of input voltages over which an op-amp operates correctly without distortion.",
      "formula": "\\text{ICMR}=V_{in,max}-V_{in,min}",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.9"
      ]
    },
    {
      "id": "output-voltage-swing",
      "term": "Output voltage swing",
      "definition": "Maximum positive and negative output levels reachable before the output transistor enters saturation.",
      "formula": "V_{out}\\in[V_{DS,sat},\\,V_{DD}-V_{DS,sat}]",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.10"
      ]
    },
    {
      "id": "thermal-noise",
      "term": "Thermal noise",
      "definition": "Noise component of a CMOS op-amp that is proportional to channel resistance.",
      "formula": "\\overline{i_{n}^{2}}=4kT\\gamma g_{m}\\Delta f",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.11"
      ]
    },
    {
      "id": "flicker-noise",
      "term": "Flicker noise",
      "definition": "Low-frequency noise, also called 1/f noise, that dominates at low frequencies and is higher in MOSFETs.",
      "formula": "\\overline{v_{n}^{2}}=\\frac{K}{C_{ox}WL}\\frac{1}{f}\\Delta f",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-unit-5-cmos#p.11"
      ]
    },
    {
      "id": "multistage-amplifier",
      "term": "Multistage amplifier",
      "definition": "Cascade of amplifier stages that achieves higher gain and better impedance matching than one stage, with a high-impedance input and low-impedance output.",
      "formula": "A_{v}=\\prod_{i=1}^{n}A_{vi}",
      "unit": 6,
      "unitTitle": "Comparators",
      "sources": [
        "cmos-unit-6-cmos#p.3",
        "cmos-unit-6-cmos#p.4"
      ]
    },
    {
      "id": "two-stage-op-amp",
      "term": "Two-stage op-amp",
      "definition": "Operational amplifier made of a differential input stage followed by a common-source gain stage.",
      "formula": "A_{v}=g_{m1}(r_{o2}\\parallel r_{o4})\\,g_{m6}(r_{o6}\\parallel r_{o7})",
      "unit": 6,
      "unitTitle": "Comparators",
      "sources": [
        "cmos-unit-6-cmos#p.45"
      ],
      "diagram": "opamp"
    },
    {
      "id": "settling-time",
      "term": "Settling time",
      "definition": "Time taken for the output to settle within 0.1% or 1% of its final value after a step input.",
      "formula": "t_{s}\\approx-\\tau\\ln\\epsilon",
      "unit": 6,
      "unitTitle": "Comparators",
      "sources": [
        "cmos-unit-6-cmos#p.52"
      ]
    },
    {
      "id": "mos-capacitor",
      "term": "MOS capacitor",
      "definition": "Structure equivalent to a planar capacitor with one electrode replaced by a semiconductor, forming the heart of the MOSFET.",
      "formula": "C_{ox}=\\frac{\\varepsilon_{ox}}{t_{ox}}WL",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-wiki-mos-capacitor#overview"
      ],
      "diagram": "cmos-cross-section"
    },
    {
      "id": "depletion-region",
      "term": "Depletion region",
      "definition": "Carrier-free region of immobile, negatively charged acceptor ions left when a positive gate voltage pushes holes away from the interface.",
      "formula": "x_{d}=\\sqrt{\\frac{2\\varepsilon_s\\phi_s}{qN_A}}",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-wiki-mos-capacitor#operation"
      ]
    },
    {
      "id": "inversion-layer",
      "term": "Inversion layer",
      "definition": "Surface layer in which a p-type body flips to n-type, with electrons as majority carriers, once the gate voltage is high enough.",
      "formula": "Q_{inv}=-C_{ox}(V_{GS}-V_{TH})",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-wiki-mos-capacitor#operation"
      ],
      "diagram": "cmos-cross-section"
    },
    {
      "id": "gate-dielectric",
      "term": "Gate dielectric",
      "definition": "Insulator lying directly below the gate electrode and above the channel, separating the gate from the channel.",
      "formula": "E_{ox}=\\frac{V_{GS}}{t_{ox}}",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-wiki-mos-capacitor#overview"
      ],
      "diagram": "cmos-cross-section"
    },
    {
      "id": "overdrive-voltage",
      "term": "Overdrive voltage",
      "definition": "Amount by which the gate-to-source voltage exceeds the threshold value.",
      "formula": "V_{OV}=V_{GS}-V_{TH}",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-wiki-mos-capacitor#operation"
      ]
    },
    {
      "id": "integrated-circuit-layout",
      "term": "Integrated circuit layout",
      "definition": "Representation of an integrated circuit in terms of planar geometric shapes that correspond to the material layers forming its components.",
      "formula": "",
      "unit": 1,
      "unitTitle": "MOS Devices",
      "sources": [
        "cmos-wiki-ic-layout#overview"
      ],
      "diagram": "cmos-layout"
    },
    {
      "id": "channel-length-modulation",
      "term": "Channel length modulation",
      "definition": "Shortening of the inverted channel region as drain bias increases, which raises saturation drain current and sets the MOSFET output resistance.",
      "formula": "I_{D}=\\frac{1}{2}\\mu_n C_{ox}\\frac{W}{L}(V_{GS}-V_{TH})^{2}(1+\\lambda V_{DS})",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-wiki-clm#overview"
      ],
      "diagram": "mosfet-curves"
    },
    {
      "id": "subthreshold-conduction",
      "term": "Subthreshold conduction",
      "definition": "Current between source and drain of a MOSFET when the gate voltage is below the threshold voltage.",
      "formula": "I_{D}=I_{0}\\frac{W}{L}e^{(V_{GS}-V_{TH})/(nV_{T})}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-wiki-subthreshold#overview"
      ]
    },
    {
      "id": "subthreshold-slope",
      "term": "Subthreshold slope",
      "definition": "Log-linear slope of drain current against gate voltage in the subthreshold region, used as a figure of merit for switching efficiency.",
      "formula": "S=\\frac{kT}{q}\\ln(10)\\left(1+\\frac{C_{dep}}{C_{ox}}\\right)",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-wiki-subthreshold#overview"
      ]
    },
    {
      "id": "weak-inversion",
      "term": "Weak inversion",
      "definition": "Another name for the subthreshold operating region, which is an efficient region for analog micropower design.",
      "formula": "\\frac{g_{m}}{I_{D}}=\\frac{1}{nV_{T}}",
      "unit": 2,
      "unitTitle": "CMOS Device Modeling",
      "sources": [
        "cmos-wiki-subthreshold#overview"
      ]
    },
    {
      "id": "compliance-range",
      "term": "Compliance range",
      "definition": "Range of voltages over which a current mirror works, bounded by its compliance voltage.",
      "formula": "V_{out,min}=V_{DS,sat}=V_{GS}-V_{TH}",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-wiki-current-mirror#characteristics"
      ]
    },
    {
      "id": "source-degeneration",
      "term": "Source degeneration",
      "definition": "Resistor in a transistor's source that can offset threshold variation in a mirror but lowers its output resistance.",
      "formula": "I_{out}\\approx\\frac{(W/L)_{2}}{(W/L)_{1}}\\frac{I_{ref}}{1+g_{m}R_{S}}",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-wiki-current-mirror#mosfet-mirrors"
      ]
    },
    {
      "id": "bandgap-voltage-reference",
      "term": "Bandgap voltage reference",
      "definition": "Voltage reference circuit widely used in integrated circuits that gives a nearly constant output tied to the band gap, varying little with supply, load, time or temperature.",
      "formula": "V_{ref}=V_{BE}+K\\frac{kT}{q}\\ln N",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-wiki-bandgap#overview"
      ]
    },
    {
      "id": "ptat-quantity",
      "term": "PTAT quantity",
      "definition": "Quantity generated from the voltage difference between two p-n junctions at different current densities, rising in proportion to absolute temperature.",
      "formula": "\\Delta V_{BE}=\\frac{kT}{q}\\ln N\\propto T",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-wiki-bandgap#principle"
      ]
    },
    {
      "id": "ctat-voltage",
      "term": "CTAT voltage",
      "definition": "Voltage across a diode held at constant current, which falls as temperature rises at about −2 mV per kelvin.",
      "formula": "\\frac{\\partial V_{BE}}{\\partial T}\\approx-2\\ \\text{mV/K}",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-wiki-bandgap#principle"
      ]
    },
    {
      "id": "cascode-current-source",
      "term": "Cascode current source",
      "definition": "Multi-transistor current source that stacks transistors to give higher output resistance than a single mirror.",
      "formula": "R_{out}\\approx g_{m}r_{o}^{2}",
      "unit": 3,
      "unitTitle": "Analog CMOS Sub-Circuits",
      "sources": [
        "cmos-wiki-current-mirror#mosfet-mirrors"
      ]
    },
    {
      "id": "cascode",
      "term": "Cascode",
      "definition": "Two-stage amplifier, a common-source stage feeding a common-gate stage in FETs, giving very large output resistance.",
      "formula": "A_{v}\\approx-g_{m1}g_{m2}r_{o1}r_{o2}",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-wiki-cascode#overview"
      ]
    },
    {
      "id": "miller-effect",
      "term": "Miller effect",
      "definition": "Increase in the equivalent input capacitance of an inverting voltage amplifier caused by the capacitance between its input and output.",
      "formula": "C_{M}=C(1+|A_{v}|)",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-wiki-miller#overview"
      ],
      "diagram": "opamp-inverting"
    },
    {
      "id": "pole-splitting",
      "term": "Pole splitting",
      "definition": "Technique used when a gain stage also serves as a high-impedance output, to counter the effect of feedback capacitance on performance.",
      "formula": "\\omega_{p1}\\approx\\frac{1}{g_{m2}R_{1}R_{2}C_{c}},\\quad\\omega_{p2}\\approx\\frac{g_{m2}C_{c}}{C_{1}C_{2}}",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-wiki-miller#overview"
      ],
      "diagram": "bode"
    },
    {
      "id": "mosfet-output-resistance",
      "term": "MOSFET output resistance",
      "definition": "Resistance at the drain set by channel length modulation, infinite when the modulation parameter is zero.",
      "formula": "r_{o}=\\frac{1}{\\lambda I_{D}}=\\frac{V_{A}}{I_{D}}",
      "unit": 4,
      "unitTitle": "CMOS Amplifiers",
      "sources": [
        "cmos-wiki-clm#output-resistance"
      ]
    },
    {
      "id": "operational-amplifier",
      "term": "Operational amplifier",
      "definition": "DC-coupled electronic amplifier with a differential input, a single-ended output and very high gain.",
      "formula": "V_{out}=A_{OL}(V_{+}-V_{-})",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
        "cmos-wiki-opamp#overview"
      ],
      "diagram": "opamp"
    },
    {
      "id": "input-offset-voltage",
      "term": "Input offset voltage",
      "definition": "Voltage required across the input terminals of an op-amp to drive its output voltage to zero, arising from imperfections in the input stage.",
      "formula": "V_{OS}=\\Delta V_{TH}+\\frac{V_{OV}}{2}\\frac{\\Delta(W/L)}{(W/L)}",
      "unit": 5,
      "unitTitle": "CMOS Operational Amplifiers",
      "sources": [
