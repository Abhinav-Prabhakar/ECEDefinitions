  "definitions": [
    {
      "id": "product",
      "term": "Product",
      "definition": "Anything that can be offered to a market for attention, acquisition, use or consumption, including physical objects, services, places, organisations and ideas.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.4"
      ]
    },
    {
      "id": "product-market-fit",
      "term": "Product-market fit",
      "definition": "Having built something that solves a real problem for a specific group of people who actively use it, recommend it and will pay for it.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.6"
      ]
    },
    {
      "id": "product-levels",
      "term": "Product levels",
      "definition": "Different layers of value that a product offers a customer, ranging from core benefit to potential product.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.8"
      ]
    },
    {
      "id": "core-benefit",
      "term": "Core benefit",
      "definition": "The service or benefit the customer is really buying.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.11"
      ]
    },
    {
      "id": "basic-product",
      "term": "Basic product",
      "definition": "Form into which the marketer turns the core benefit, such as a hotel room with a bed, bathroom and towels.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.11"
      ]
    },
    {
      "id": "expected-product",
      "term": "Expected product",
      "definition": "Set of attributes and conditions that buyers normally expect when they purchase the product.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.12"
      ]
    },
    {
      "id": "augmented-product",
      "term": "Augmented product",
      "definition": "Level of the offering that exceeds customer expectations, for example a complimentary breakfast at a hotel.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.12"
      ]
    },
    {
      "id": "potential-product",
      "term": "Potential product",
      "definition": "Everything an offering can become in the future, focusing on innovation, growth and long-term competitiveness rather than today's features.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.13"
      ]
    },
    {
      "id": "product-mix-width",
      "term": "Product mix width",
      "definition": "Number of different product lines that a company carries.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.20"
      ]
    },
    {
      "id": "product-mix-length",
      "term": "Product mix length",
      "definition": "Total number of items in the mix of a company.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.20"
      ]
    },
    {
      "id": "product-mix-depth",
      "term": "Product mix depth",
      "definition": "Number of variants offered of each product in the line.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.21"
      ]
    },
    {
      "id": "product-line-pruning",
      "term": "Product line pruning",
      "definition": "Removing weak or non-performing items from a line so the company can focus on profitable, high-demand ones.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.23"
      ]
    },
    {
      "id": "product-cannibalization",
      "term": "Product cannibalization",
      "definition": "Situation in which a new offering takes sales away from a company's existing offering instead of attracting new customers.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.26"
      ]
    },
    {
      "id": "consumer-goods",
      "term": "Consumer goods",
      "definition": "Goods bought and consumed by the end customer.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.28"
      ]
    },
    {
      "id": "industrial-goods",
      "term": "Industrial goods",
      "definition": "Class of goods that are used for the manufacturing of other goods.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.28"
      ]
    },
    {
      "id": "capital-goods",
      "term": "Capital goods",
      "definition": "Class of products such as tools, machinery, buildings, vehicles and computers.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Interpretations on Product",
      "sources": [
        "ps-unit-i-p-and-s#slide.32"
      ]
    },
    {
      "id": "new-product",
      "term": "New product",
      "definition": "Any product perceived by the customer as new, such as a repositioned product, a lower-priced existing product or an added product item.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.3"
      ]
    },
    {
      "id": "product-concept",
      "term": "Product concept",
      "definition": "Developed form of a product idea that consumers actually buy, since consumers do not buy mere ideas.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.9"
      ]
    },
    {
      "id": "scamper",
      "term": "SCAMPER",
      "definition": "Creative technique that improves existing products or ideas by asking guided questions to modify something.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.18"
      ]
    },
    {
      "id": "brainstorming",
      "term": "Brainstorming",
      "definition": "Creative technique for generating many ideas in a short time through free thinking without criticism or judgment.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.20"
      ]
    },
    {
      "id": "synectics",
      "term": "Synectics",
      "definition": "Creative problem-solving technique that uses analogies, mentally taking things apart and putting them together to give new insight.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.23"
      ]
    },
    {
      "id": "attribute-listing",
