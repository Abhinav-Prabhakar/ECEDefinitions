      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.25"
      ]
    },
    {
      "id": "forced-relationships",
      "term": "Forced relationships",
      "definition": "Technique that joins totally different ideas to come up with a fresh idea, often yielding useful combinations.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.29"
      ]
    },
    {
      "id": "stage-gate-process",
      "term": "Stage/Gate process",
      "definition": "Cross-functional approach that involves many business function areas throughout the entire product innovation cycle.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.34"
      ]
    },
    {
      "id": "financial-analysis",
      "term": "Financial analysis",
      "definition": "Examination of financial information to reach business decisions.",
      "formula": "",
      "unit": 2,
      "unitTitle": null,
      "sources": [
        "ps-unit-2-p-and-s#slide.50"
      ]
    },
    {
      "id": "cost-analysis",
      "term": "Cost analysis",
