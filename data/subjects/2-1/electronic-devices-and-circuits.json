  "status": "complete",
  "definitions": [
    {
      "id": "intrinsic-semiconductor",
      "term": "Intrinsic semiconductor",
      "definition": "A pure semiconductor in which the number of free electrons equals the number of holes at room temperature.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.13"
      ],
      "formula": "n_{i}=\\sqrt{N_{C}N_{V}}\\,e^{-E_{g}/(2k_{B}T)}"
    },
    {
      "id": "extrinsic-semiconductor",
      "term": "Extrinsic semiconductor",
      "definition": "A semiconductor whose electrical properties are altered by adding impurity atoms (doping).",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.12"
      ],
      "formula": "np=n_{i}^{2}"
    },
    {
      "id": "n-type-semiconductor",
      "term": "n-type semiconductor",
      "definition": "A semiconductor doped with pentavalent impurity, where electrons are majority carriers.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.5"
      ],
      "formula": "n_{n}\\approx N_{D},\\quad p_{n}\\approx\\frac{n_{i}^{2}}{N_{D}}"
    },
    {
      "id": "p-type-semiconductor",
      "term": "p-type semiconductor",
      "definition": "A semiconductor doped with trivalent impurity, where holes are majority carriers.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.30"
      ],
      "formula": "p_{p}\\approx N_{A},\\quad n_{p}\\approx\\frac{n_{i}^{2}}{N_{A}}"
    },
    {
      "id": "depletion-region",
      "term": "Depletion region",
      "definition": "The region around a pn junction depleted of mobile charges, containing immobile ions.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.43"
      ],
      "formula": "W=\\sqrt{\\frac{2\\varepsilon_{s}}{q}\\left(\\frac{1}{N_{A}}+\\frac{1}{N_{D}}\\right)\\left(V_{bi}-V\\right)}",
      "diagram": "pn-junction"
    },
    {
      "id": "barrier-potential",
      "term": "Barrier potential",
      "definition": "The potential difference developed across a pn junction that opposes further diffusion of carriers.",
      "formula": "V_{bi}=V_{T}\\ln\\frac{N_{A}N_{D}}{n_{i}^{2}}",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.42"
      ]
    },
    {
      "id": "forward-bias",
      "term": "Forward bias",
      "definition": "Applied voltage that reduces the depletion width and barrier potential, allowing majority carrier current.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.46"
      ],
      "formula": "I_{D}=I_{S}\\left(e^{V_{D}/(\\eta V_{T})}-1\\right)",
      "diagram": "diode-iv"
    },
    {
      "id": "reverse-saturation-current",
      "term": "Reverse saturation current",
      "definition": "Small current due to minority carriers that flows when a pn junction is reverse biased.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.55"
      ],
      "formula": "I_{S}=qA\\left(\\frac{D_{p}}{L_{p}N_{D}}+\\frac{D_{n}}{L_{n}N_{A}}\\right)n_{i}^{2}"
    },
    {
      "id": "zener-diode",
      "term": "Zener diode",
      "definition": "A heavily doped pn junction diode that maintains a constant voltage in reverse breakdown.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.66"
      ],
      "formula": "I_{Z}=\\frac{V_{S}-V_{Z}}{R_{S}}-I_{L}"
    },
    {
      "id": "zener-breakdown",
      "term": "Zener breakdown",
      "definition": "Breakdown in a heavily doped junction caused by rupture of covalent bonds in a strong electric field.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.80"
      ],
      "formula": "E_{\\text{crit}}=\\frac{2V_{Z}}{W}",
      "diagram": "diode-iv"
    },
    {
      "id": "avalanche-breakdown",
      "term": "Avalanche breakdown",
      "definition": "Breakdown in a lightly doped junction caused by carrier multiplication through collision ionization.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.79"
      ],
      "formula": "M=\\frac{1}{1-\\left(V/V_{B}\\right)^{n}}"
    },
    {
      "id": "transition-capacitance",
      "term": "Transition capacitance",
      "definition": "Capacitance of the depletion region in reverse bias due to uncovered immobile charges.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.87"
      ],
      "formula": "C_{T}=\\frac{C_{T0}}{\\left(1+V_{R}/V_{bi}\\right)^{n}}"
    },
    {
      "id": "diffusion-capacitance",
      "term": "Diffusion capacitance",
      "definition": "Capacitance due to stored minority charge in a forward-biased pn junction.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.83"
      ],
      "formula": "C_{D}=\\tau\\frac{dI_{D}}{dV_{D}}=\\frac{\\tau I_{D}}{\\eta V_{T}}"
    },
    {
      "id": "rectifier",
      "term": "Rectifier",
      "definition": "A device that converts alternating current into pulsating direct current.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.100"
      ],
      "formula": "\\eta=\\frac{P_{\\text{dc}}}{P_{\\text{ac}}}\\times100\\%"
    },
    {
      "id": "ripple-factor",
      "term": "Ripple factor",
      "definition": "Ratio of the RMS value of the AC component to the DC component in a rectifier output.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.125"
      ],
      "formula": "r=\\sqrt{\\left(\\frac{V_{\\text{rms}}}{V_{\\text{dc}}}\\right)^{2}-1}"
    },
    {
      "id": "peak-inverse-voltage",
      "term": "Peak inverse voltage (PIV)",
      "definition": "The maximum reverse voltage a diode can withstand without breakdown.",
      "unit": 1,
      "unitTitle": "PN Junction Diodes and Rectifiers",
      "sources": [
        "edc-edc-unit-1#slide.127"
      ],
      "formula": "\\text{PIV}_{\\text{centre-tap}}=2V_{m},\\quad \\text{PIV}_{\\text{bridge}}=V_{m}"
    },
    {
      "id": "bjt",
      "term": "Bipolar junction transistor",
      "definition": "A three-terminal active device in which current at one terminal is controlled by voltage at the other two.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.2"
      ],
      "formula": "I_{E}=I_{B}+I_{C}",
      "diagram": "bjt"
    },
    {
      "id": "active-region",
      "term": "Active region",
      "definition": "Region where the emitter junction is forward biased and the collector junction is reverse biased, used for amplification.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.9"
      ],
      "formula": "I_{C}=\\beta I_{B},\\quad I_{B}>0"
    },
    {
      "id": "saturation-region",
      "term": "Saturation region",
      "definition": "Region where both emitter and collector junctions are forward biased, acting as a closed switch.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.9"
      ],
      "formula": "I_{C}<\\beta I_{B},\\quad V_{CE}\\approx0"
    },
    {
      "id": "cutoff-region",
      "term": "Cut-off region",
      "definition": "Region where both emitter and collector junctions are reverse biased, acting as an open switch.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.9"
      ],
      "formula": "I_{B}=0\\;\\Rightarrow\\;I_{C}\\approx I_{CEO}\\approx0"
    },
    {
      "id": "common-base",
      "term": "Common base configuration",
      "definition": "Transistor configuration with the base common to input and output; low input and high output resistance.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.7"
      ],
      "formula": "R_{\\text{in}}=r_{e}=\\frac{V_{T}}{I_{E}}"
    },
    {
      "id": "common-emitter",
      "term": "Common emitter configuration",
      "definition": "Transistor configuration with the emitter common to input and output; used for amplification.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.8"
      ],
      "formula": "A_{v}=-g_{m}R_{C},\\quad A_{i}=\\beta"
    },
    {
      "id": "common-collector",
      "term": "Common collector configuration",
      "definition": "Transistor configuration with the collector common to input and output; used for impedance matching.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.8"
      ],
      "formula": "A_{v}=\\frac{R_{E}}{r_{e}+R_{E}}\\approx1"
    },
    {
      "id": "early-effect",
      "term": "Early effect",
      "definition": "Modulation of effective base width by collector-base voltage, increasing collector current.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.29"
      ],
      "formula": "I_{C}=I_{S}e^{V_{BE}/V_{T}}\\left(1+\\frac{V_{CE}}{V_{A}}\\right)"
    },
    {
      "id": "punch-through",
      "term": "Punch-through",
      "definition": "Breakdown when the collector-base depletion region extends through the base to the emitter.",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.44"
      ],
      "formula": "V_{PT}\\approx\\frac{qN_{B}W_{B}^{2}}{2\\varepsilon_{s}}"
    },
    {
      "id": "current-gain-alpha",
      "term": "Current gain alpha",
      "definition": "Ratio of collector current to emitter current in a BJT, typically 0.9 to 0.995.",
      "formula": "\\alpha=\\frac{I_{C}}{I_{E}},\\quad\\beta=\\frac{\\alpha}{1-\\alpha}",
      "unit": 2,
      "unitTitle": "Bipolar Junction Transistor",
      "sources": [
        "edc-edc-unit-2#slide.2"
      ]
    },
    {
      "id": "h-parameters",
      "term": "h-parameters",
      "definition": "Hybrid values describing a two-port network by input impedance, reverse voltage gain, forward current gain and output admittance.",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.6"
      ],
      "formula": "V_{1}=h_{11}I_{1}+h_{12}V_{2},\\quad I_{2}=h_{21}I_{1}+h_{22}V_{2}"
    },
    {
      "id": "millers-theorem",
      "term": "Miller's theorem",
      "definition": "A bridging impedance between two nodes can be replaced by two shunt impedances to ground.",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.52"
      ],
      "formula": "Z_{1}=\\frac{Z}{1-A_{v}},\\quad Z_{2}=\\frac{Z}{1-1/A_{v}}"
    },
    {
      "id": "frequency-response",
      "term": "Frequency response",
      "definition": "Curve of amplifier voltage gain versus signal frequency.",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.59"
      ],
      "formula": "A_{v}(j\\omega)=\\frac{A_{v0}}{1+j\\omega/\\omega_{H}}",
      "diagram": "bode"
    },
    {
      "id": "lower-cutoff-frequency",
      "term": "Lower cut-off frequency",
      "definition": "Frequency at which amplifier gain falls to 1/sqrt(2) of mid-frequency gain in the low-frequency range.",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.61"
      ],
      "formula": "|A_{v}(f_{L})|=\\frac{|A_{v,\\text{mid}}|}{\\sqrt{2}}"
    },
    {
      "id": "bandwidth",
      "term": "Bandwidth",
      "definition": "Frequency interval between lower and upper cut-off frequencies.",
      "formula": "\\text{BW}=f_{U}-f_{L}",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.61"
      ]
    },
    {
      "id": "multistage-amplifier",
      "term": "Multistage amplifier",
      "definition": "Amplifier with cascaded stages to increase overall voltage gain.",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.62"
      ],
      "formula": "A_{v}=\\prod_{k=1}^{n}A_{vk}"
    },
    {
      "id": "rc-coupled-amplifier",
      "term": "RC coupled amplifier",
      "definition": "Multistage amplifier using resistor-capacitor coupling between stages, suited for audio frequencies.",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.68"
      ],
      "formula": "f_{L}=\\frac{1}{2\\pi\\left(R_{C}+R_{L}\\right)C_{C}}"
    },
    {
      "id": "hybrid-pi-model",
      "term": "Hybrid-pi model",
      "definition": "High-frequency small-signal equivalent circuit of a BJT using transconductance and junction capacitances.",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.100"
      ],
      "formula": "g_{m}=\\frac{I_{C}}{V_{T}},\\quad r_{\\pi}=\\frac{\\beta}{g_{m}}"
    },
    {
      "id": "transconductance",
      "term": "Transconductance",
      "definition": "Ratio of change in collector current to change in base-emitter voltage at constant collector-emitter voltage.",
      "formula": "g_{m}=\\frac{\\Delta I_{C}}{\\Delta V_{BE}}=\\frac{I_{C}}{V_{T}}",
      "unit": 3,
      "unitTitle": "Small Signal and High Frequency Analysis of BJT",
      "sources": [
        "edc-edc-unit-3#slide.105"
      ]
    },
    {
      "id": "fet",
      "term": "Field-effect transistor (FET)",
      "definition": "A unipolar, voltage-controlled three-terminal semiconductor device whose conduction from source to drain relies only on majority carriers, modulated by the gate voltage.",
      "unit": 4,
      "unitTitle": "Field Effect Transistor",
      "sources": [
        "edc-unit-iv#slide.1"
      ],
      "formula": "g_{m}=\\frac{\\partial I_{D}}{\\partial V_{GS}}"
    },
    {
      "id": "jfet",
      "term": "JFET",
      "definition": "A FET in which a reverse-biased pn junction controls channel width and drain current.",
      "unit": 4,
      "unitTitle": "Field Effect Transistor",
      "sources": [
        "edc-unit-iv#slide.4"
      ],
      "formula": "I_{D}=I_{DSS}\\left(1-\\frac{V_{GS}}{V_{P}}\\right)^{2}"
    },
    {
      "id": "pinch-off-voltage",
      "term": "Pinch-off voltage",
      "definition": "The gate voltage at which the channel is completely depleted and drain current saturates.",
      "unit": 4,
      "unitTitle": "Field Effect Transistor",
      "sources": [
        "edc-unit-iv#slide.6"
      ],
      "formula": "V_{DS(\\text{sat})}=V_{GS}-V_{P}"
    },
    {
      "id": "mosfet",
      "term": "MOSFET",
      "definition": "A FET with an insulated gate, also called an insulated-gate field-effect transistor.",
      "unit": 4,
      "unitTitle": "Field Effect Transistor",
      "sources": [
        "edc-edc-fet-unit4#slide.3"
      ],
      "formula": "I_{D}=\\frac{1}{2}\\mu_{n}C_{ox}\\frac{W}{L}\\left(V_{GS}-V_{th}\\right)^{2}",
      "diagram": "mosfet"
    },
    {
      "id": "enhancement-mosfet",
      "term": "Enhancement MOSFET",
      "definition": "MOSFET with no conducting channel at zero gate bias; channel is enhanced by gate voltage.",
      "unit": 4,
      "unitTitle": "Field Effect Transistor",
      "sources": [
        "edc-edc-fet-unit4#slide.3"
      ],
      "formula": "Q_{n}=C_{ox}\\left(V_{GS}-V_{th}\\right)"
    },
    {
      "id": "depletion-mosfet",
      "term": "Depletion MOSFET",
      "definition": "MOSFET with a built-in channel that can be depleted or enhanced by gate voltage.",
      "unit": 4,
      "unitTitle": "Field Effect Transistor",
      "sources": [
        "edc-edc-fet-unit4#slide.3"
      ],
      "formula": "V_{GS}=0\\;\\Rightarrow\\;I_{D}=I_{DSS}"
    },
    {
      "id": "self-bias-fet",
      "term": "Self-bias",
      "definition": "FET biasing method where the source resistor provides the gate-source bias voltage.",
      "unit": 4,
      "unitTitle": "Field Effect Transistor",
      "sources": [
        "edc-fet-biasing#p.2"
      ],
      "formula": "V_{GS}=-I_{D}R_{S}"
    },
    {
      "id": "feedback-amplifier",
      "term": "Feedback amplifier",
      "definition": "Amplifier in which a portion of the output is fed back and combined with the input.",
      "unit": 5,
      "unitTitle": "Feedback Amplifiers and Oscillators",
      "sources": [
        "edc-edc-unit-5-feedback-amplifiers-oscillators#slide.9"
      ],
      "formula": "A_{f}=\\frac{A}{1+A\\beta}"
    },
    {
      "id": "positive-feedback",
      "term": "Positive feedback",
      "definition": "Feedback where the output portion is added to the input, used in oscillators.",
      "unit": 5,
      "unitTitle": "Feedback Amplifiers and Oscillators",
      "sources": [
        "edc-edc-unit-5-feedback-amplifiers-oscillators#slide.11"
      ],
      "formula": "A_{f}=\\frac{A}{1-A\\beta}"
    },
    {
      "id": "negative-feedback",
      "term": "Negative feedback",
      "definition": "Feedback where the output portion is subtracted from the input to stabilize gain.",
      "unit": 5,
      "unitTitle": "Feedback Amplifiers and Oscillators",
      "sources": [
        "edc-edc-unit-5-feedback-amplifiers-oscillators#slide.15"
      ],
      "formula": "\\frac{dA_{f}}{A_{f}}=\\frac{1}{1+A\\beta}\\frac{dA}{A}",
      "diagram": "control-loop"
    },
    {
      "id": "barkhausen-criterion",
      "term": "Barkhausen criterion",
      "definition": "Conditions for oscillation: loop gain magnitude unity and total phase shift 0 or 360 degrees.",
      "unit": 5,
      "unitTitle": "Feedback Amplifiers and Oscillators",
      "sources": [
        "edc-edc-unit-5-feedback-amplifiers-oscillators#slide.47"
      ],
      "formula": "|A\\beta|=1,\\quad\\angle A\\beta=0^{\\circ}\\ (360^{\\circ})"
    },
    {
      "id": "oscillator",
      "term": "Oscillator",
      "definition": "Circuit that generates an AC output without an AC input using positive feedback.",
      "unit": 5,
      "unitTitle": "Feedback Amplifiers and Oscillators",
      "sources": [
        "edc-edc-unit-5-feedback-amplifiers-oscillators#slide.45"
      ],
      "formula": "v_{o}(t)=V_{m}\\sin\\left(2\\pi f_{0}t\\right)"
    },
    {
      "id": "resonant-frequency",
      "term": "Resonant frequency",
      "definition": "Frequency at which the oscillator output is maximized.",
      "unit": 5,
      "unitTitle": "Feedback Amplifiers and Oscillators",
      "sources": [
        "edc-edc-unit-5-feedback-amplifiers-oscillators#slide.57"
      ],
      "formula": "f_{r}=\\frac{1}{2\\pi\\sqrt{LC}}"
    },
    {
      "id": "piezoelectric-effect",
      "term": "Piezoelectric effect",
      "definition": "Mechanical stress on a crystal produces voltage across it, and vice versa.",
      "unit": 5,
      "unitTitle": "Feedback Amplifiers and Oscillators",
      "sources": [
        "edc-edc-unit-5-feedback-amplifiers-oscillators#slide.79"
      ],
      "formula": "Q=d_{33}F,\\quad S_{3}=d_{33}E_{3}"
    },
    {
      "id": "voltage-regulator",
      "term": "Voltage regulator",
      "definition": "Circuit that produces a constant DC output voltage by reducing ripple to negligible amount.",
      "unit": 6,
      "unitTitle": "Voltage Regulators",
      "sources": [
        "edc-edc-syllabus#para.23"
      ],
      "formula": "V_{\\text{out}}=V_{Z}\\left(1+\\frac{R_{1}}{R_{2}}\\right)"
    }
  ]
}
