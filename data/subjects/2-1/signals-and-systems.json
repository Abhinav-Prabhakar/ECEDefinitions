  "status": "complete",
  "definitions": [
    {"id":"signal","term":"Signal","definition":"A function that conveys information, e.g. voltage vs time.","formula":"x(t), x[n]","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"ct-signal","term":"Continuous-time signal","definition":"Signal defined for every real value of time.","formula":"x(t), t∈ℝ","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"dt-signal","term":"Discrete-time signal","definition":"Signal defined only at discrete instants of time.","formula":"x[n], n∈ℤ","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"periodic-signal","term":"Periodic signal","definition":"Signal repeating after a fixed period T.","formula":"x(t+T)=x(t)","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"aperiodic-signal","term":"Aperiodic signal","definition":"Signal that does not repeat periodically.","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"energy-signal","term":"Energy signal","definition":"Finite total energy signal with zero average power.","formula":"E=∫|x(t)|²dt<∞","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"power-signal","term":"Power signal","definition":"Finite average power signal with infinite energy.","formula":"P=lim (1/2T)∫|x(t)|²dt","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"even-signal","term":"Even signal","definition":"Signal symmetric about the origin.","formula":"x(-t)=x(t)","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"odd-signal","term":"Odd signal","definition":"Signal antisymmetric about the origin.","formula":"x(-t)=-x(t)","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"causal-signal","term":"Causal signal","definition":"Signal zero for all t<0.","formula":"x(t)=0, t<0","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"unit-step","term":"Unit step u(t)","definition":"Signal that is 0 for t<0 and 1 for t≥0.","formula":"u(t)","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"unit-impulse","term":"Unit impulse δ(t)","definition":"Generalized function with unit area at origin.","formula":"∫δ(t)dt=1","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"time-shift","term":"Time shifting","definition":"Delay or advance of a signal in time.","formula":"x(t-a)","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"time-scale","term":"Time scaling","definition":"Compression or expansion of signal in time.","formula":"x(at)","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},
    {"id":"time-reversal","term":"Time reversal","definition":"Reflecting a signal about t=0.","formula":"x(-t)","unit":1,"unitTitle":"Signal classification & operations","sources":["ss-unit-1-ss#slide.1"]},

    {"id":"system","term":"System","definition":"Entity that processes input signals to produce output signals.","formula":"y=T[x]","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.3"]},
    {"id":"static-system","term":"Static (memoryless) system","definition":"Output depends only on present input.","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.8"]},
    {"id":"dynamic-system","term":"Dynamic system","definition":"Output depends on present and past inputs.","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.8"]},
    {"id":"causal-system","term":"Causal system","definition":"Output depends only on present and past inputs.","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.10"]},
    {"id":"linear-system","term":"Linear system","definition":"Satisfies superposition: T[ax1+bx2]=aT[x1]+bT[x2].","formula":"T[ax1+bx2]=ay1+by2","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.12"]},
    {"id":"time-invariant-system","term":"Time-invariant system","definition":"Behavior does not change with time; delayed input gives delayed output.","formula":"T[x(t-t0)]=y(t-t0)","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.19"]},
    {"id":"stable-system","term":"Stable (BIBO) system","definition":"Bounded input produces bounded output.","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.24"]},
    {"id":"lti-system","term":"LTI system","definition":"System that is both linear and time-invariant.","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.2"]},
    {"id":"impulse-response","term":"Impulse response h(t)","definition":"Output when input is unit impulse δ(t).","formula":"h(t)=T[δ(t)]","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.29"]},
    {"id":"convolution","term":"Convolution","definition":"Output of LTI system as integral of input and impulse response.","formula":"y(t)=x(t)*h(t)=∫x(τ)h(t-τ)dτ","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.31"]},
    {"id":"transfer-function","term":"Transfer function H(s)","definition":"Ratio of output to input spectra; Fourier/Laplace transform of impulse response.","formula":"H(ω)=Y(ω)/X(ω)","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.33"]},
    {"id":"frequency-response","term":"Frequency response","definition":"System response to complex exponential input e^(jωt).","formula":"H(jω)","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.33"]},
    {"id":"correlation","term":"Correlation","definition":"Measure of similarity between two signals as a function of lag.","formula":"R_xy(τ)=∫x(t)y*(t-τ)dt","unit":2,"unitTitle":"LTI systems & convolution","sources":["ss-unit-iv-correlation-nsr#slide.1"]},

    {"id":"fourier-transform","term":"Fourier transform","definition":"Represents a signal in frequency domain.","formula":"X(ω)=∫x(t)e^(-jωt)dt","unit":3,"unitTitle":"Fourier transform","sources":["ss-unit-ii-s-s-including-hillbert-transform#slide.1"]},
    {"id":"inverse-fourier-transform","term":"Inverse Fourier transform","definition":"Recovers time-domain signal from spectrum.","formula":"x(t)=(1/2π)∫X(ω)e^(jωt)dω","unit":3,"unitTitle":"Fourier transform","sources":["ss-unit-ii-s-s-including-hillbert-transform#slide.1"]},
    {"id":"fourier-series","term":"Fourier series","definition":"Representation of periodic signal as sum of harmonics.","formula":"x(t)=Σ c_n e^(jnω0t)","unit":3,"unitTitle":"Fourier transform","sources":["ss-unit-ii-s-s-including-hillbert-transform#slide.1"]},
    {"id":"parseval-theorem","term":"Parseval's theorem","definition":"Energy in time domain equals energy in frequency domain.","formula":"∫|x(t)|²dt=(1/2π)∫|X(ω)|²dω","unit":3,"unitTitle":"Fourier transform","sources":["ss-unit-ii-s-s-including-hillbert-transform#slide.1"]},
    {"id":"convolution-property-ft","term":"Convolution property (FT)","definition":"Convolution in time becomes multiplication in frequency.","formula":"x(t)*h(t) ↔ X(ω)H(ω)","unit":3,"unitTitle":"Fourier transform","sources":["ss-unit-iii-ss-unit-3-lec-1#slide.32"]},
    {"id":"modulation-property","term":"Modulation property","definition":"Multiplication in time shifts spectrum in frequency.","formula":"x(t)e^(jω0t) ↔ X(ω-ω0)","unit":3,"unitTitle":"Fourier transform","sources":["ss-unit-ii-s-s-including-hillbert-transform#slide.1"]},
    {"id":"hilbert-transform","term":"Hilbert transform","definition":"Filters negative frequencies; produces quadrature signal in same domain.","formula":"ŷ(t)=x(t)*1/(πt)","unit":3,"unitTitle":"Fourier transform","sources":["ss-unit-ii-s-s-including-hillbert-transform#slide.1"]},

    {"id":"laplace-transform","term":"Laplace transform","definition":"Generalized Fourier transform with complex frequency s.","formula":"X(s)=∫_0^∞ x(t)e^(-st)dt","unit":4,"unitTitle":"Laplace transform","sources":["ss-laplace-transforms#slide.1"]},
    {"id":"bilateral-laplace","term":"Bilateral Laplace transform","definition":"Integrates over all time (-∞ to ∞).","formula":"X(s)=∫_{-∞}^{∞} x(t)e^(-st)dt","unit":4,"unitTitle":"Laplace transform","sources":["ss-laplace-transforms#slide.1"]},
    {"id":"roc","term":"Region of convergence (ROC)","definition":"Set of s values for which Laplace transform integral converges.","unit":4,"unitTitle":"Laplace transform","sources":["ss-laplace-transforms#slide.1"]},
    {"id":"inverse-laplace","term":"Inverse Laplace transform","definition":"Recovers x(t) from X(s).","formula":"x(t)=L^{-1}[X(s)]","unit":4,"unitTitle":"Laplace transform","sources":["ss-inverse-laplace#p.1"]},
    {"id":"initial-value-theorem-lt","term":"Initial value theorem (LT)","definition":"Finds x(0+) from X(s).","formula":"x(0+)=lim_{s→∞} sX(s)","unit":4,"unitTitle":"Laplace transform","sources":["ss-properties-of-lt#p.1"]},
    {"id":"final-value-theorem-lt","term":"Final value theorem (LT)","definition":"Finds steady-state value x(∞).","formula":"x(∞)=lim_{s→0} sX(s)","unit":4,"unitTitle":"Laplace transform","sources":["ss-properties-of-lt#p.1"]},

    {"id":"z-transform","term":"Z-transform","definition":"Transform for discrete-time signals using z.","formula":"X(z)=Σ x[n] z^{-n}","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.1"]},
    {"id":"bilateral-z","term":"Bilateral Z-transform","definition":"Sum over all n from -∞ to ∞.","formula":"X(z)=Σ_{n=-∞}^{∞} x[n]z^{-n}","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.1"]},
    {"id":"roc-z","term":"ROC of Z-transform","definition":"Range of z for which Z-transform converges.","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.9"]},
    {"id":"inverse-z","term":"Inverse Z-transform","definition":"Recovers x[n] from X(z).","formula":"x[n]=Z^{-1}[X(z)]","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.14"]},
    {"id":"initial-value-theorem-z","term":"Initial value theorem (Z)","definition":"Finds x[0] from X(z).","formula":"x[0]=lim_{z→∞} X(z)","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.8"]},
    {"id":"final-value-theorem-z","term":"Final value theorem (Z)","definition":"Finds x[∞] from X(z).","formula":"x[∞]=lim_{z→1}(z-1)X(z)","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.8"]},
    {"id":"causality-z","term":"Causality condition (Z)","definition":"ROC is outside outermost pole for causal LTI system.","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.12"]},
    {"id":"stability-z","term":"Stability condition (Z)","definition":"All poles lie inside unit circle |z|=1.","formula":"|z|=1 in ROC","unit":5,"unitTitle":"Z-transform","sources":["ss-z-transforms#slide.12"]},

    {"id":"sampling-theorem","term":"Sampling theorem","definition":"Bandlimited signal recoverable if sampled at ≥2fm.","formula":"f_s≥2f_m","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.9"]},
    {"id":"nyquist-rate","term":"Nyquist rate","definition":"Minimum sampling rate 2fm for a signal bandlimited to fm.","formula":"f_N=2f_m","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.9"]},
    {"id":"nyquist-interval","term":"Nyquist interval","definition":"Maximum time between samples 1/(2fm).","formula":"T_s=1/(2f_m)","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.9"]},
    {"id":"aliasing","term":"Aliasing","definition":"Overlap of spectral replicas due to undersampling.","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.15"]},
    {"id":"anti-aliasing-filter","term":"Anti-aliasing filter","definition":"Low-pass filter before sampling to prevent aliasing.","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.19"]},
    {"id":"natural-sampling","term":"Natural sampling","definition":"Sampling where pulse top follows signal variation.","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.20"]},
    {"id":"flat-top-sampling","term":"Flat-top sampling","definition":"Sample held constant for whole sample period (S/H).","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.23"]},
    {"id":"bandpass-sampling","term":"Bandpass sampling","definition":"Sampling a bandpass signal at rate based on bandwidth.","formula":"f_s≥2B(1+M/N)","unit":6,"unitTitle":"Sampling theorem","sources":["ss-unit5-sampling-theorem#slide.27"]}
  ]
}
