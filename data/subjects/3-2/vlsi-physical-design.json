{
  "version": 1,
  "id": "vlsi-physical-design",
  "semester": "3-2",
  "name": "VLSI Physical Design",
  "shortName": "VLSIPD",
  "code": "9C622",
  "courseType": "PE",
  "elective": "Professional Elective II",
  "folderId": "1BoTRdZk1tei1mGA8vlS7As4G2ejJfMJz",
  "folderUrl": "https://drive.google.com/drive/folders/1BoTRdZk1tei1mGA8vlS7As4G2ejJfMJz",
  "status": "partial",
  "definitions": [
    {
      "id": "tapeout",
      "term": "Tapeout",
      "definition": "Official handover of the design data from the design team to the silicon foundry for manufacturing.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.21"
      ]
    },
    {
      "id": "rtl-verification",
      "term": "RTL verification",
      "definition": "Functional verification of the RTL design by applying test cases, sending the design back to the RTL designers if mistakes are found.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.27"
      ]
    },
    {
      "id": "logic-synthesis",
      "term": "Logic synthesis",
      "definition": "Process of converting the technology-independent RTL code into a technology-dependent gate-level netlist.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.28"
      ]
    },
    {
      "id": "design-for-testability",
      "term": "Design for testability",
      "definition": "Design technique that facilitates a design becoming testable, listed as a step of the physical design flow.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.28"
      ]
    },
    {
      "id": "floorplan",
      "term": "Floorplan",
      "definition": "Step that determines the die and core area, creates wire tracks for standard cells, creates power straps and places ports, pads and macros.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.28"
      ]
    },
    {
      "id": "clock-tree-synthesis",
      "term": "Clock tree synthesis",
      "definition": "Process of building the clock tree with inverters and buffers, balancing clock skew and minimising insertion delay to meet timing.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.28"
      ]
    },
    {
      "id": "asic",
      "term": "ASIC",
      "definition": "Non-standard integrated circuit designed for a specific use or application.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.42"
      ]
    },
    {
      "id": "full-custom-asic",
      "term": "Full custom ASIC",
      "definition": "Chip in which some or all logic cells and all mask layers are customised, avoiding pretested and pre-characterised cells.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.45"
      ]
    },
    {
      "id": "semi-custom-asic",
      "term": "Semi custom ASIC",
      "definition": "Chip in which all logic cells are predesigned and some or all mask layers are customised.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.47"
      ]
    },
    {
      "id": "cell-based-asic",
      "term": "Cell-based ASIC",
      "definition": "Chip built from predesigned logic cells such as gates, multiplexers and flip-flops, generally taken to mean a standard-cell based design.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.47"
      ]
    },
    {
      "id": "standard-cells",
      "term": "Standard cells",
      "definition": "Predesigned logic cells such as AND gates, OR gates, multiplexers and flip-flops, arranged in rows like bricks in a wall.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.47",
        "vlsipd-unit-1-vlsipd#slide.48"
      ]
    },
    {
      "id": "mega-cells",
      "term": "Mega cells",
      "definition": "Large predesigned blocks such as microcontrollers or microprocessors that are used in combination with standard-cell areas.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.48"
      ]
    },
    {
      "id": "base-array",
      "term": "Base array",
      "definition": "Predefined pattern of transistors on a gate array, made by replicating the smallest repeated element.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.50"
      ]
    },
    {
      "id": "base-cell",
      "term": "Base cell",
      "definition": "Smallest element replicated to make the predefined transistor pattern of a gate array, sometimes called a primitive cell.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.50"
      ]
    },
    {
      "id": "masked-rom",
      "term": "Masked ROM",
      "definition": "Regular array of transistors permanently programmed using custom mask patterns, which can be embedded on any ASIC as a large specialised logic cell.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.60"
      ]
    },
    {
      "id": "fpga",
      "term": "FPGA",
      "definition": "Newest member of the ASIC family, with a core of programmable basic logic cells and interconnect that can implement combinational and sequential logic.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.61"
      ]
    },
    {
      "id": "clock-gating",
      "term": "Clock gating",
      "definition": "Inserting logic to disable the clock for idle modules, the most effective technique for reducing dynamic power.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.65"
      ]
    },
    {
      "id": "static-timing-analysis",
      "term": "Static timing analysis",
      "definition": "Method of verifying that a digital circuit meets all timing requirements such as speed, setup and hold without simulating with input vectors.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction",
      "sources": [
        "vlsipd-unit-1-vlsipd#slide.67",
        "vlsipd-unit-3-vlsipd#slide.2"
      ]
    },
    {
      "id": "implementation",
      "term": "Implementation",
      "definition": "Process of converting a logical specification into a physical layout.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.5"
      ]
    },
    {
      "id": "pitch",
      "term": "Pitch",
      "definition": "The distance between two adjacent tracks of the routing grid used for layout.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.8"
      ]
    },
    {
      "id": "via",
      "term": "Via",
      "definition": "Structure used to connect two different metal layers, for example M1 and M2.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.8"
      ]
    },
    {
      "id": "isolation-cell",
      "term": "Isolation cell",
      "definition": "Cell that isolates the output of a powered-off domain so a floating value does not reach the powered-on domain, also called a clamp cell.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.14"
      ]
    },
    {
      "id": "power-gating",
      "term": "Power gating",
      "definition": "Technique that reduces power consumption by shutting off the power to blocks of the circuit that are not in use.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.18"
      ]
    },
    {
      "id": "ramp-up-time",
      "term": "Ramp up time",
      "definition": "Time required to power up a component that was switched off.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.18"
      ]
    },
    {
      "id": "retention-flop",
      "term": "Retention flop",
      "definition": "Combination of a regular flop and a state-saving latch.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.20"
      ]
    },
    {
      "id": "metal-eco-able-cells",
      "term": "Metal eco-able cells",
      "definition": "Filler cells that are converted to attain a required functionality.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.23"
      ]
    },
    {
      "id": "antenna-effect",
      "term": "Antenna effect",
      "definition": "Rupture of a gate caused when stray charges accumulated in metal layers during fabrication exceed a threshold set by the metal-to-gate area ratio.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.25"
      ]
    },
    {
      "id": "characterization",
      "term": "Characterization",
      "definition": "Generation of .lib files for a cell library, done with respect to PVT corners.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.30"
      ]
    },
    {
      "id": "netlist",
      "term": "Netlist",
      "definition": "Detailed list of all logic gates and their interconnections that implement an RTL design.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.54"
      ]
    },
    {
      "id": "sleep-transistors",
      "term": "Sleep transistors",
      "definition": "Devices used in power gating to shut off the supply entirely to idle blocks, the primary method for eliminating leakage power.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Design Standard Cell Libraries",
      "sources": [
        "vlsipd-unit-2-vlsipd#slide.63"
      ]
    },
    {
      "id": "slack",
      "term": "Slack",
      "definition": "Difference between the required time and the arrival time of a signal along a timing path.",
      "formula": "Slack = Required − Arrival",
      "unit": 3,
      "unitTitle": "Static Timing Analysis",
      "sources": [
        "vlsipd-unit-3-vlsipd#slide.2"
      ]
    },
    {
      "id": "dynamic-timing-analysis",
      "term": "Dynamic timing analysis",
      "definition": "Timing verification method often used for specific functional validation, in contrast to the sign-off standard method.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Static Timing Analysis",
      "sources": [
        "vlsipd-unit-3-vlsipd#slide.6"
      ]
    },
    {
      "id": "timing-path",
      "term": "Timing path",
      "definition": "Physical route that signals travel through the chip, analysed in STA by splitting the chip into four such routes.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Static Timing Analysis",
      "sources": [
        "vlsipd-unit-3-vlsipd#slide.8",
        "vlsipd-unit-3-vlsipd#slide.4"
      ]
    },
    {
      "id": "timing-constraints",
      "term": "Timing constraints",
      "definition": "Mathematical rules imposed on timing paths to ensure the chip works at the desired speed, written in an SDC file.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Static Timing Analysis",
      "sources": [
        "vlsipd-unit-3-vlsipd#slide.8",
        "vlsipd-unit-3-vlsipd#slide.9"
      ]
    },
    {
      "id": "clock-skew",
      "term": "Clock skew",
      "definition": "Time difference between the clock edge arriving at the launch flip-flop and at the capture flip-flop.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Static Timing Analysis",
      "sources": [
        "vlsipd-unit-3-vlsipd#slide.11"
      ]
    }
  ]
}
