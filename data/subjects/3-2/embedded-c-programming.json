      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.37"
      ],
      "diagram": "interrupt-flow"
    },
    {
      "id": "switch-bounce",
      "term": "Switch bounce",
      "definition": "Repeated making and breaking of mechanical switch contacts after the switch is closed or opened, usually lasting under 20 ms.",
