    {
      "id": "embedded-system",
      "term": "Embedded system",
      "definition": "Hardware with software embedded in it for a dedicated application, containing at least one programmable computer such as a microcontroller, processor or DSP chip.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Programming Embedded Systems in C",
      "sources": [
