      "id": "multi-state-timed-system",
      "term": "Multi-state (timed) system",
      "definition": "System in which the transition between states depends only on the passage of time.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Case Study: Intruder Alarm System",
      "sources": [
        "ecp-unit-6#p.27"
      ]
    },
    {
      "id": "multi-state-input-timed-system",
      "term": "Multi-state (input/timed) system",
      "definition": "System in which the transition between states, and behaviour in each state, depends on both the passage of time and system inputs.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Case Study: Intruder Alarm System",
