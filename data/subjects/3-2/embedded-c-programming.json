    {
      "id": "hardware-delay",
      "term": "Hardware delay",
      "definition": "Delay created with one of the on-chip timers of the 8051 family, allowing more accurate timing than software loops.",
      "formula": "t_{\\text{delay}}=N\\,T_{\\text{mc}}",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.9"
      ],
      "diagram": "counter-timing"
    },
    {
      "id": "timer-overflow",
      "term": "Timer overflow",
      "definition": "Event that occurs when a 16-bit timer is incremented past its maximum count of 65535.",
      "formula": "N_{\\text{ovf}}=2^{16}-N_{\\text{init}}",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.10",
        "ecp-unit-5#p.17"
      ],
      "diagram": "counter-timing"
    },
    {
      "id": "tcon",
      "term": "TCON",
      "definition": "Special function register holding the timer run-control bits TR0 and TR1 and the external interrupt flags IE0 and IE1.",
      "formula": "\\text{TCON}=88\\text{H},\\;\\text{TR0}=2^{4}=10\\text{H},\\;\\text{TR1}=2^{6}=40\\text{H}",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.12",
        "ecp-unit-5#p.13"
      ]
    },
    {
      "id": "tmod",
      "term": "TMOD",
      "definition": "Special function register that selects the mode of operation of each timer using the M1 and M0 bits, with GATE and counter/timer controls.",
      "formula": "\\text{mode}_k=\\left\\lfloor\\frac{\\text{TMOD}}{2^{4k}}\\right\\rfloor\\;\\&\\;03\\text{H}",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.14",
        "ecp-unit-5#p.15"
      ]
    },
    {
      "id": "timer-2",
      "term": "Timer 2",
      "definition": "Extra, more flexible timer found in devices based on the slightly later 8052 architecture.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.23"
      ]
    },
    {
      "id": "timeout-mechanism",
      "term": "Timeout mechanism",
      "definition": "Technique that prevents a system from hanging forever when an expected event, such as release of a switch, never occurs.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.24"
      ]
    },
    {
      "id": "loop-timeout",
      "term": "Loop timeout",
      "definition": "Timeout built from a loop variable that keeps running until it reaches its maximum value of 65535 and overflows.",
      "formula": "t_{\\text{timeout}}=N_{\\text{loop}}\\,t_{\\text{loop}}",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.26"
      ]
    },
    {
      "id": "hardware-timeout",
      "term": "Hardware timeout",
      "definition": "Timeout created by using a timer, which allows precise timeout delays to be generated easily.",
      "formula": "t_{\\text{timeout}}=(2^{16}-N_{\\text{init}})\\,T_{\\text{mc}}",
      "unit": 5,
      "unitTitle": "Meeting Real-Time Constraints",
      "sources": [
        "ecp-unit-5#p.33"
      ]
    },
    {
      "id": "multi-state-task",
      "term": "Multi-state task",
      "definition": "Software architecture with a series of system states, each calling one or more functions, with rules defining the transitions between states.",
      "formula": "s_{n+1}=\\delta(s_{n},x_{n})",
      "unit": 6,
      "unitTitle": "Case Study: Intruder Alarm System",
      "sources": [
        "ecp-unit-6#p.26"
      ]
    },
