      "sources": [
        "ecp-unit-2#slide.23"
      ]
    },
    {
      "id": "bdata-area",
      "term": "BDATA area",
      "definition": "16-byte area of data memory that can also be accessed using bit addresses and is used to store bit-sized variables.",
      "formula": "A_{\\text{bit}}=8\\,(A_{\\text{byte}}-20\\text{H})+n,\\;0\\le n\\le 7",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.27"
      ]
    },
    {
      "id": "8-bit-microcontroller",
      "term": "8-bit microcontroller",
      "definition": "Device whose registers and data bus are 8 bits wide, handling 8-bit data quickly and 16-bit or 32-bit data less efficiently.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.30"
      ]
    },
    {
      "id": "timer",
      "term": "Timer",
      "definition": "16-bit counting register that can hold values between 0 and 65535 in decimal.",
      "formula": "N_{\\max}=2^{16}-1=65535",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.32"
      ],
      "diagram": "counter-timing"
    },
    {
      "id": "interrupt",
      "term": "Interrupt",
      "definition": "Hardware mechanism that notifies the processor that an internal or external event, such as timer overflow or serial data arrival, has occurred.",
      "formula": "3T_{\\text{mc}}\\le t_{\\text{lat}}\\le 8T_{\\text{mc}}",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.34"
      ],
      "diagram": "interrupt-flow"
    },
    {
      "id": "isr",
      "term": "ISR",
      "definition": "Function written to handle an interrupt, located elsewhere in code memory.",
