        "ecp-unit-1#slide.15"
      ]
    },
    {
      "id": "microprocessor",
      "term": "Microprocessor",
      "definition": "Single-chip semiconductor device that is a computer on a chip, but not a complete computer.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Programming Embedded Systems in C",
      "sources": [
        "ecp-unit-1#slide.35"
      ]
    },
    {
      "id": "microcontroller",
      "term": "Microcontroller",
      "definition": "Functional computer system on a chip containing a processor, memory and programmable input/output peripherals.",
