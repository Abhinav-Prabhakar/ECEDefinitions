        "ecp-unit-4#p.10"
      ]
    },
    {
      "id": "project-header",
      "term": "Project header",
      "definition": "Header file included in all projects that groups key information about the 8051 device used, such as oscillator frequency and type definitions.",
      "formula": "T_{\\text{mc}}=\\frac{12}{f_{\\text{osc}}}",
      "unit": 4,
      "unitTitle": "Adding Structure to the Code",
      "sources": [
        "ecp-unit-4#p.16"
      ]
    },
