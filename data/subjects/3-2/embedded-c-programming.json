      ]
    },
    {
      "id": "mcs-51",
      "term": "MCS-51",
      "definition": "Intel's designation for its family of 8051 devices, whose original member is the core for all of them.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.4"
      ]
    },
    {
      "id": "stack-pointer",
      "term": "Stack pointer",
      "definition": "Register incremented just before data is stored by a push, call or interrupt and initialised to 07H on reset.",
      "formula": "\\text{SP}_{n+1}=\\text{SP}_{n}+1,\\quad \\text{SP}_{\\text{reset}}=07\\text{H}",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.18"
      ],
      "diagram": "memory-layout"
    },
    {
      "id": "dynamic-ram",
      "term": "Dynamic RAM",
      "definition": "Read-write memory technology that stores information in a small capacitor, which discharges quickly and so must be refreshed frequently.",
      "formula": "t_{\\text{ref}}=\\frac{t_{\\text{ret}}}{N_{\\text{rows}}}",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.21"
      ]
    },
    {
      "id": "static-ram",
      "term": "Static RAM",
      "definition": "Read-write memory technology that uses a form of electronic flip-flop to store the information.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Introducing the 8051 Microcontroller Family",
      "sources": [
        "ecp-unit-2#slide.21"
      ]
    },
    {
      "id": "prom",
      "term": "PROM",
      "definition": "Memory form that is write-once, read-many, also called one-time programmable.",
      "formula": "",
      "unit": 2,
