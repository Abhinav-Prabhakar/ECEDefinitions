        "dip-wikipedia-digital-image-processing#para.7"
      ]
    },
    {
      "id": "convolution",
      "term": "Convolution",
      "definition": "Operation in which each output pixel is a weighted sum of neighbouring input pixels, with weights taken from a small kernel.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Digital Image Fundamentals",
      "sources": [
        "dip-wikipedia-kernel-image-processing#para.5",
        "dip-wikipedia-kernel-image-processing#para.1"
      ]
    },
    {
      "id": "cross-correlation",
      "term": "Cross-correlation",
      "definition": "Similarity measure obtained by sliding a template over an image and summing products of overlapping values; higher means a better match.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Digital Image Fundamentals",
      "sources": [
        "dip-wikipedia-template-matching#para.10",
        "dip-wikipedia-template-matching#para.11"
      ]
    },
    {
      "id": "discrete-cosine-transform",
      "term": "Discrete cosine transform",
      "definition": "Transform that rewrites a finite set of values as a combination of cosine waves at different frequencies, using only real numbers.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-discrete-cosine-transform#para.1",
        "dip-wikipedia-discrete-cosine-transform#para.2"
      ]
    },
    {
      "id": "energy-compaction",
      "term": "Energy compaction",
      "definition": "Property of concentrating most of a signal's information in a few low-frequency coefficients, enabling high compression with good quality.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-discrete-cosine-transform#para.5",
        "dip-wikipedia-discrete-cosine-transform#para.13"
      ]
    },
    {
      "id": "walsh-hadamard-transform",
      "term": "Walsh-Hadamard transform",
      "definition": "Orthogonal, symmetric, self-inverse linear operation on 2^m numbers that acts as a generalized Fourier transform using only plus and minus signs.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-hadamard-transform#para.1",
        "dip-wikipedia-hadamard-transform#para.15"
      ]
    },
    {
      "id": "hadamard-matrix",
      "term": "Hadamard matrix",
      "definition": "Square matrix of size 2^m with entries of only +1 and -1, buildable recursively or by Kronecker products; its rows are Walsh functions.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-hadamard-transform#para.4",
        "dip-wikipedia-hadamard-transform#para.6",
        "dip-wikipedia-hadamard-transform#para.12"
      ]
    },
    {
      "id": "haar-transform",
      "term": "Haar transform",
      "definition": "Wavelet transform, among the oldest, that compares a signal with shifted and stretched copies of the simplest box-shaped wavelet.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-haar-wavelet#para.1",
        "dip-wikipedia-haar-wavelet#para.36",
        "dip-wikipedia-haar-wavelet#para.37"
      ]
    },
    {
      "id": "karhunen-loeve-transform",
      "term": "Karhunen-Loeve transform",
      "definition": "Expansion in orthogonal functions that are eigenfunctions of the covariance, giving uncorrelated coefficients; also called the Hotelling or eigenvector transform.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-karhunen-loeve-theorem#para.1"
      ]
    },
    {
      "id": "radon-transform",
      "term": "Radon transform",
      "definition": "Integral transform, introduced in 1917, that maps a function on the plane to its line integrals along every line.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-radon-transform#para.1"
      ]
    },
    {
      "id": "sinogram",
      "term": "Sinogram",
      "definition": "Collection of line-integral data from a Radon transform, named because an off-centre point source traces a sine-shaped curve.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-radon-transform#para.3"
      ]
    },
    {
      "id": "hough-transform",
      "term": "Hough transform",
      "definition": "Feature-extraction method that detects shapes by letting image points vote for the parameter values of candidate shapes.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Image Transforms",
      "sources": [
        "dip-wikipedia-hough-transform#para.1"
      ]
    },
    {
      "id": "image-enhancement",
      "term": "Image enhancement",
      "definition": "Improving the quality of an image, for example by reducing noise or improving the distribution of gray levels.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Image Enhancement",
      "sources": [
        "dip-wikipedia-digital-image-processing#para.2"
      ]
    },
    {
      "id": "image-histogram",
      "term": "Image histogram",
      "definition": "Count of how many pixels in an image take each intensity value.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Image Enhancement",
      "sources": [
        "dip-wikipedia-histogram-equalization#para.28"
      ]
    },
    {
      "id": "histogram-equalization",
      "term": "Histogram equalization",
      "definition": "Contrast-adjustment method that uses the cumulative distribution of intensities to spread the most common values across the full range.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Image Enhancement",
      "sources": [
        "dip-wikipedia-histogram-equalization#para.1",
        "dip-wikipedia-histogram-equalization#para.11",
        "dip-wikipedia-histogram-equalization#para.12"
      ]
    },
    {
      "id": "adaptive-histogram-equalization",
      "term": "Adaptive histogram equalization",
      "definition": "Variant that builds several sub-histograms to emphasise local contrast rather than overall global contrast.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Image Enhancement",
      "sources": [
        "dip-wikipedia-histogram-equalization#para.6"
      ]
    },
    {
      "id": "spatial-filtering",
      "term": "Spatial filtering",
      "definition": "Processing in which each output pixel is a function of nearby input pixels, with a small kernel defining that function.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Image Enhancement",
      "sources": [
        "dip-wikipedia-kernel-image-processing#para.1"
      ]
    },
    {
      "id": "smoothing-filter",
      "term": "Smoothing filter",
