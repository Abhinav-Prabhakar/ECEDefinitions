      "formula": "",
      "unit": 6,
      "unitTitle": "Image Compression",
      "sources": [
        "dip-wikipedia-image-compression#para.1",
        "dip-wikipedia-digital-image#para.20"
      ]
    },
    {
      "id": "lossless-compression",
