      "formula": "",
      "unit": 3,
      "unitTitle": "Image Enhancement",
      "sources": [
        "dip-wikipedia-kernel-image-processing#para.3"
      ]
    },
    {
      "id": "sharpening-filter",
      "term": "Sharpening filter",
      "definition": "Kernel with a large positive centre and negative neighbours that exaggerates local contrast.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Image Enhancement",
      "sources": [
        "dip-wikipedia-kernel-image-processing#para.3"
      ]
    },
    {
      "id": "frequency-domain-filtering",
      "term": "Frequency-domain filtering",
      "definition": "Blurring or sharpening an image by masking chosen ranges of frequencies in its Fourier transform.",
