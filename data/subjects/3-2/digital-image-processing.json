      "unit": 6,
      "unitTitle": "Image Compression",
      "sources": [
        "dip-wikipedia-arithmetic-coding#para.1",
        "dip-wikipedia-arithmetic-coding#para.2"
      ]
    },
    {
      "id": "vector-quantization",
      "term": "Vector quantization",
