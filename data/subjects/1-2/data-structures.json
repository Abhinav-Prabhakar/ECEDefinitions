  "definitions": [
    {
      "id": "structure",
      "term": "Structure",
      "definition": "Collection of one or more variables, possibly of different data types, grouped under a single name.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.4"
      ],
      "artifact": "data-structures--structure"
    },
    {
      "id": "tagged-structure",
      "term": "Tagged structure",
      "definition": "A structure definition associated with a name (tag) that declares no instance and allocates no memory.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.5"
      ]
    },
    {
      "id": "type-defined-structure",
      "term": "Type-defined structure",
      "definition": "Record declaration prefixed with typedef so that its name can be used directly as a data type.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.10"
      ]
    },
    {
      "id": "array-of-structures",
      "term": "Array of structures",
      "definition": "Contiguous sequence whose elements are grouped records, allowing multiple related variables to be stored together.",
      "formula": "\\text{addr}(A[i])=\\text{base}+i\\cdot\\text{sizeof}(\\text{record})",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.34"
      ]
    },
    {
      "id": "nested-structure",
      "term": "Nested structure",
      "definition": "A structure that contains another structure as one of its members.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.40"
      ]
    },
    {
      "id": "self-referential-structure",
      "term": "Self-referential structure",
      "definition": "A structure containing at least one pointer member to another structure of the same type.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.43",
        "ds-ds-unit-3#slide.15"
      ],
      "artifact": "data-structures--self-referential-structure"
    },
    {
      "id": "union",
      "term": "Union",
      "definition": "A derived data type whose members share one memory location, so only one member can be used at a time.",
      "formula": "\\text{sizeof}(U)=\\max_{i}\\text{sizeof}(m_i)",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.45"
      ],
      "artifact": "data-structures--union"
    },
    {
      "id": "typedef",
      "term": "typedef",
      "definition": "A keyword that gives a new name to an existing data type without creating a new type.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.53"
      ],
      "artifact": "data-structures--typedef"
    },
    {
      "id": "enumerated-data-type",
      "term": "Enumerated data type (enum)",
      "definition": "A user-defined data type whose variables can take values only from a listed set of named constants.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.57"
      ],
      "artifact": "data-structures--enumerated-data-type"
    },
    {
      "id": "static-memory-allocation",
      "term": "Static memory allocation",
      "definition": "Memory reservation fully specified in the source program, whose size cannot change during run time.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.68"
      ],
      "diagram": "memory-layout"
    },
    {
      "id": "dynamic-memory-allocation",
      "term": "Dynamic memory allocation",
      "definition": "Allocation and release of memory for data during program execution using predefined functions.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.68",
        "ds-ds-unit-3#slide.13"
      ],
      "diagram": "memory-layout"
    },
    {
      "id": "malloc",
      "term": "malloc",
      "definition": "Allocates a block of uninitialized memory of the requested size and returns a pointer to it.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.74",
        "ds-ds-unit-3#slide.14"
      ],
      "artifact": "data-structures--malloc"
    },
    {
      "id": "free",
      "term": "free",
      "definition": "Releases memory previously allocated by malloc, calloc or realloc back to the heap.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.81"
      ]
    },
    {
      "id": "abstract-data-type",
      "term": "Abstract data type (ADT)",
      "definition": "Model defined by its permitted values and operations, independent of any implementation details.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.4"
      ]
    },
    {
      "id": "stack",
      "term": "Stack",
      "definition": "An ordered collection of homogeneous elements where insertion and deletion occur only at one end, called the top.",
      "formula": "\\text{top}\\in\\{-1,0,1,\\dots,n-1\\}",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.5"
      ],
      "diagram": "stack-queue"
    },
    {
      "id": "lifo",
      "term": "LIFO (Last In First Out)",
      "definition": "Discipline in which the element inserted most recently is the first one removed.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.5"
      ]
    },
    {
      "id": "queue",
      "term": "Queue",
      "definition": "Linear data structure where insertion occurs at the rear and deletion at the front.",
      "formula": "\\text{count}=\\text{rear}-\\text{front}+1",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.23"
      ],
      "diagram": "stack-queue"
    },
    {
      "id": "fifo",
      "term": "FIFO (First In First Out)",
      "definition": "Discipline in which the element inserted earliest is the first one removed.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.23"
      ]
    },
    {
      "id": "circular-queue",
      "term": "Circular queue",
      "definition": "Linear structure that connects its last position back to the first, forming a ring buffer.",
      "formula": "\\text{rear}=(\\text{rear}+1)\\bmod n",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.39"
      ],
      "diagram": "stack-queue"
    },
    {
      "id": "deque",
      "term": "Deque (double-ended queue)",
      "definition": "Homogeneous list where insertion and deletion can occur at both ends.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.38"
      ]
    },
    {
      "id": "priority-queue",
      "term": "Priority queue",
      "definition": "Structure that serves items in order of importance, always removing the most important first.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.38"
      ]
    },
    {
      "id": "push",
      "term": "Push",
      "definition": "Operation of inserting or adding an element onto a stack.",
      "formula": "\\text{top}\\leftarrow\\text{top}+1",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.7"
      ]
    },
    {
      "id": "pop",
      "term": "Pop",
      "definition": "Operation of deleting or removing an element from a stack.",
      "formula": "\\text{top}\\leftarrow\\text{top}-1",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.7"
      ]
    },
    {
      "id": "linked-list",
      "term": "Linked list",
      "definition": "Linear collection of homogeneous nodes whose order is maintained by pointers.",
      "formula": "T_{\\text{access}}(k)=O(k)",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.8"
      ],
      "diagram": "linked-list"
    },
    {
      "id": "node",
      "term": "Node",
      "definition": "Element of a linked list containing data and a pointer to the next element.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.8"
      ]
    },
    {
      "id": "singly-linked-list",
      "term": "Singly linked list",
      "definition": "List traversable in one direction whose last element ends with a null pointer.",
      "formula": "p_{\\text{last}}\\to\\text{next}=\\text{NULL}",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.12"
      ],
      "diagram": "linked-list"
    },
    {
      "id": "doubly-linked-list",
      "term": "Doubly linked list",
      "definition": "Two-way list where each element has forward and backward pointers.",
      "formula": "p\\to\\text{next}\\to\\text{prev}=p",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.33"
      ]
    },
    {
      "id": "circular-linked-list",
      "term": "Circular linked list",
      "definition": "List in which the last element's pointer points back to the first element.",
      "formula": "p_{\\text{last}}\\to\\text{next}=p_{\\text{head}}",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.12"
      ]
    },
    {
      "id": "tree",
      "term": "Tree",
      "definition": "Finite set of nodes with a specially designated root and disjoint subtrees.",
      "formula": "|E|=|V|-1",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.5"
      ]
    },
    {
      "id": "binary-tree",
      "term": "Binary tree",
      "definition": "Hierarchical structure where each node has at most two subtrees, left and right.",
      "formula": "n_{\\max}(h)=2^{h+1}-1",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.15"
      ],
      "diagram": "binary-tree"
    },
    {
      "id": "binary-search-tree",
      "term": "Binary search tree",
      "definition": "Ordered structure in which every left-subtree key is smaller and every right-subtree key larger than the root.",
      "formula": "T_{\\text{search}}(n)=O(h)",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.40"
      ],
      "diagram": "binary-tree"
    },
    {
      "id": "avl-tree",
      "term": "AVL tree",
      "definition": "Height-balanced search structure whose left and right subtree heights differ by at most one.",
      "formula": "|h_L-h_R|\\le 1",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.58"
      ]
    },
    {
      "id": "array-representation-of-binary-tree",
      "term": "Array representation of binary tree",
      "definition": "A binary tree stored in an array with the root at index 0 and children of node i at 2i+1 and 2i+2.",
      "formula": "\\text{left}(i)=2i+1,\\ \\text{right}(i)=2i+2,\\ \\text{parent}(i)=\\lfloor(i-1)/2\\rfloor",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.23"
      ],
      "artifact": "data-structures--array-representation-of-binary-tree"
    },
    {
      "id": "linked-representation-of-binary-tree",
      "term": "Linked representation of binary tree",
      "definition": "A binary tree stored using nodes containing data with left and right pointers.",
      "formula": "\\text{node}=(\\text{data},\\text{left},\\text{right})",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.26"
      ]
    },
    {
      "id": "graph",
      "term": "Graph",
      "definition": "Pair G=(V,E) where V is a finite nonempty set of vertices and E is the set of edges.",
      "formula": "G=(V,E),\\quad |E|\\le\\frac{|V|(|V|-1)}{2}",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.2"
      ]
    },
    {
      "id": "directed-graph",
      "term": "Directed graph",
      "definition": "Structure in which every edge has a direction.",
      "formula": "|E|\\le |V|(|V|-1)",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.3"
      ]
    },
    {
      "id": "undirected-graph",
      "term": "Undirected graph",
      "definition": "Structure in which the edges have no direction.",
      "formula": "\\sum_{v\\in V}\\deg(v)=2|E|",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.3"
      ]
    },
    {
      "id": "adjacency-matrix",
      "term": "Adjacency matrix",
      "definition": "Square bit matrix indicating by 1 or 0 whether an edge connects each pair of vertices.",
      "formula": "A_{ij}=1\\iff(v_i,v_j)\\in E",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.12"
      ]
    },
    {
      "id": "adjacency-list",
      "term": "Adjacency list",
      "definition": "Linked representation where each vertex stores a list of its adjacent vertices.",
      "formula": "\\text{space}=O(|V|+|E|)",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.13"
      ]
    },
    {
      "id": "depth-first-search",
      "term": "Depth-first search (DFS)",
      "definition": "Traversal that explores as far as possible along each branch before backtracking, using a stack.",
      "formula": "T=O(|V|+|E|)",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.17"
      ],
      "diagram": "graph-search",
      "artifact": "data-structures--depth-first-search"
    },
    {
      "id": "breadth-first-search",
      "term": "Breadth-first search (BFS)",
      "definition": "Traversal that visits all vertices at one level before moving to the next level, using a queue.",
      "formula": "T=O(|V|+|E|)",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.18"
      ],
      "diagram": "graph-search"
    },
    {
      "id": "max-heap",
      "term": "Max heap",
      "definition": "Complete or nearly complete binary tree where each node's key is greater than or equal to its descendants'.",
      "formula": "A[\\lfloor(i-1)/2\\rfloor]\\ge A[i]",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.26"
      ],
      "diagram": "heap"
    },
    {
      "id": "hash-table",
      "term": "Hash table",
      "definition": "Structure that stores key-value pairs and supports insertion, lookup and deletion in O(1) time.",
      "formula": "\\alpha=\\frac{n}{m},\\quad T_{\\text{lookup}}=O(1+\\alpha)",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.44"
      ],
      "diagram": "hash-table"
    },
    {
      "id": "linear-search",
      "term": "Linear search",
      "definition": "Method that sequentially checks each array element until the item is found or the array ends.",
      "formula": "T_{\\text{avg}}(n)=\\frac{n+1}{2}",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.2"
      ]
    },
    {
      "id": "binary-search",
      "term": "Binary search",
      "definition": "Method that repeatedly compares the key with the middle element of a sorted array and halves the interval.",
      "formula": "T(n)=T(n/2)+O(1)=O(\\log n)",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.11"
      ]
    },
    {
      "id": "selection-sort",
      "term": "Selection sort",
      "definition": "Method that repeatedly selects the smallest element from the unsorted portion and swaps it into place.",
      "formula": "T(n)=\\frac{n(n-1)}{2}=O(n^2)",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.22"
      ]
    },
    {
      "id": "insertion-sort",
      "term": "Insertion sort",
      "definition": "Method that builds a sorted segment by inserting each next element into its correct position.",
      "formula": "T_{\\text{worst}}(n)=O(n^2),\\ T_{\\text{best}}(n)=O(n)",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.25"
      ]
    },
    {
      "id": "merge-sort",
      "term": "Merge sort",
      "definition": "Method that divides the list into halves, sorts them, and merges the sorted halves.",
      "formula": "T(n)=2T(n/2)+\\Theta(n)=O(n\\log n)",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.46"
      ]
    }
  ]
}
