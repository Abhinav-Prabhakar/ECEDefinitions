  "definitions": [
    {
      "id": "structure",
      "term": "Structure",
      "definition": "A structure is a collection of one or more variables, possibly of different data types, grouped under a single name.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.4"
      ]
    },
    {
      "id": "tagged-structure",
      "term": "Tagged structure",
      "definition": "A structure definition associated with a name (tag) that declares no instance and allocates no memory.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.5"
      ]
    },
    {
      "id": "type-defined-structure",
      "term": "Type-defined structure",
      "definition": "A structure definition prefixed with typedef, so its name becomes a user-defined data type.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.10"
      ]
    },
    {
      "id": "array-of-structures",
      "term": "Array of structures",
      "definition": "An array whose elements are structures, allowing multiple related structure variables to be stored together.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.34"
      ]
    },
    {
      "id": "nested-structure",
      "term": "Nested structure",
      "definition": "A structure that contains another structure as one of its members.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.40"
      ]
    },
    {
      "id": "self-referential-structure",
      "term": "Self-referential structure",
      "definition": "A structure containing at least one pointer member to another structure of the same type.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.43",
        "ds-ds-unit-3#slide.15"
      ]
    },
    {
      "id": "union",
      "term": "Union",
      "definition": "A derived data type whose members share one memory location, so only one member can be used at a time.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.45"
      ]
    },
    {
      "id": "typedef",
      "term": "typedef",
      "definition": "A keyword that gives a new name to an existing data type without creating a new type.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.53"
      ]
    },
    {
      "id": "enumerated-data-type",
      "term": "Enumerated data type (enum)",
      "definition": "A user-defined data type whose variables can take values only from a listed set of named constants.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.57"
      ]
    },
    {
      "id": "static-memory-allocation",
      "term": "Static memory allocation",
      "definition": "Memory reservation fully specified in the source program, whose size cannot change during run time.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.68"
      ]
    },
    {
      "id": "dynamic-memory-allocation",
      "term": "Dynamic memory allocation",
      "definition": "Allocation and release of memory for data during program execution using predefined functions.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.68",
        "ds-ds-unit-3#slide.13"
      ]
    },
    {
      "id": "malloc",
      "term": "malloc",
      "definition": "Allocates a block of uninitialized memory of the requested size and returns a pointer to it.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.74",
        "ds-ds-unit-3#slide.14"
      ]
    },
    {
      "id": "free",
      "term": "free",
      "definition": "Releases memory previously allocated by malloc, calloc or realloc back to the heap.",
      "formula": "",
      "unit": 1,
      "unitTitle": "Introduction, Arrays, Structures",
      "sources": [
        "ds-ds-unit-1#slide.81"
      ]
    },
    {
      "id": "abstract-data-type",
      "term": "Abstract data type (ADT)",
      "definition": "An abstract data type is defined by its data values and operations, without implementation details.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.4"
      ]
    },
    {
      "id": "stack",
      "term": "Stack",
      "definition": "A stack is an ordered collection of homogeneous elements where insertion and deletion occur at one end called top.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.5"
      ]
    },
    {
      "id": "lifo",
      "term": "LIFO (Last In First Out)",
      "definition": "Last In First Out means the element inserted last into a stack is deleted first.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.5"
      ]
    },
    {
      "id": "queue",
      "term": "Queue",
      "definition": "A queue is a linear data structure where insertion occurs at the rear and deletion at the front.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.23"
      ]
    },
    {
      "id": "fifo",
      "term": "FIFO (First In First Out)",
      "definition": "First In First Out means the element inserted first into a queue is deleted first.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.23"
      ]
    },
    {
      "id": "circular-queue",
      "term": "Circular queue",
      "definition": "A circular queue connects the last position back to the first, forming a ring buffer.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.39"
      ]
    },
    {
      "id": "deque",
      "term": "Deque (double-ended queue)",
      "definition": "A deque is a homogeneous list where insertion and deletion can occur at both ends.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.38"
      ]
    },
    {
      "id": "priority-queue",
      "term": "Priority queue",
      "definition": "A priority queue removes items according to their priority, with the highest priority first.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.38"
      ]
    },
    {
      "id": "push",
      "term": "Push",
      "definition": "Push is the operation of inserting or adding an element onto a stack.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.7"
      ]
    },
    {
      "id": "pop",
      "term": "Pop",
      "definition": "Pop is the operation of deleting or removing an element from a stack.",
      "formula": "",
      "unit": 2,
      "unitTitle": "Stacks and Queues",
      "sources": [
        "ds-ds-unit-2#slide.7"
      ]
    },
    {
      "id": "linked-list",
      "term": "Linked list",
      "definition": "A linked list is a linear collection of homogeneous nodes whose order is maintained by pointers.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.8"
      ]
    },
    {
      "id": "node",
      "term": "Node",
      "definition": "A node is an element of a linked list containing data and a pointer to the next node.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.8"
      ]
    },
    {
      "id": "singly-linked-list",
      "term": "Singly linked list",
      "definition": "A singly linked list is traversable in one direction and ends with a null pointer.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.12"
      ]
    },
    {
      "id": "doubly-linked-list",
      "term": "Doubly linked list",
      "definition": "A doubly linked list is a two-way list where each node has forward and backward pointers.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.33"
      ]
    },
    {
      "id": "circular-linked-list",
      "term": "Circular linked list",
      "definition": "A circular linked list is one where the last node's pointer points back to the first node.",
      "formula": "",
      "unit": 3,
      "unitTitle": "Linked Lists",
      "sources": [
        "ds-ds-unit-3#slide.12"
      ]
    },
    {
      "id": "tree",
      "term": "Tree",
      "definition": "A tree is a finite set of nodes with a specially designated root and disjoint subtrees.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.5"
      ]
    },
    {
      "id": "binary-tree",
      "term": "Binary tree",
      "definition": "A binary tree is a tree where each node has at most two subtrees, left and right.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.15"
      ]
    },
    {
      "id": "binary-search-tree",
      "term": "Binary search tree",
      "definition": "A binary search tree satisfies the BST property: left-subtree keys are smaller and right-subtree keys are larger.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.40"
      ]
    },
    {
      "id": "avl-tree",
      "term": "AVL tree",
      "definition": "An AVL tree is a binary search tree whose left and right subtree heights differ by at most one.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.58"
      ]
    },
    {
      "id": "array-representation-of-binary-tree",
      "term": "Array representation of binary tree",
      "definition": "A binary tree stored in an array with the root at index 0 and children of node i at 2i+1 and 2i+2.",
      "formula": "left = 2i + 1, right = 2i + 2",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.23"
      ]
    },
    {
      "id": "linked-representation-of-binary-tree",
      "term": "Linked representation of binary tree",
      "definition": "A binary tree stored using nodes containing data with left and right pointers.",
      "formula": "",
      "unit": 4,
      "unitTitle": "Trees",
      "sources": [
        "ds-ds-unit-4#slide.26"
      ]
    },
    {
      "id": "graph",
      "term": "Graph",
      "definition": "A graph is a pair G=(V,E) where V is a finite nonempty set of vertices and E is the set of edges.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.2"
      ]
    },
    {
      "id": "directed-graph",
      "term": "Directed graph",
      "definition": "A directed graph is one in which every edge has a direction.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.3"
      ]
    },
    {
      "id": "undirected-graph",
      "term": "Undirected graph",
      "definition": "An undirected graph is one in which edges have no direction.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.3"
      ]
    },
    {
      "id": "adjacency-matrix",
      "term": "Adjacency matrix",
      "definition": "An adjacency matrix is a square bit matrix indicating by 1 or 0 whether an edge connects each vertex pair.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.12"
      ]
    },
    {
      "id": "adjacency-list",
      "term": "Adjacency list",
      "definition": "An adjacency list is a linked representation where each vertex stores a list of its adjacent vertices.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.13"
      ]
    },
    {
      "id": "depth-first-search",
      "term": "Depth-first search (DFS)",
      "definition": "Depth-first search explores as far as possible along each branch before backtracking, using a stack.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.17"
      ]
    },
    {
      "id": "breadth-first-search",
      "term": "Breadth-first search (BFS)",
      "definition": "Breadth-first search visits all vertices at one level before moving to the next level, using a queue.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.18"
      ]
    },
    {
      "id": "max-heap",
      "term": "Max heap",
      "definition": "A max heap is a complete or nearly complete binary tree where each node's key is greater than or equal to its descendants'.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.26"
      ]
    },
    {
      "id": "hash-table",
      "term": "Hash table",
      "definition": "A hash table stores key-value pairs and supports insertions, lookups and deletions in O(1) time.",
      "formula": "",
      "unit": 5,
      "unitTitle": "Graphs, Heaps and Hashing",
      "sources": [
        "ds-ds-unit-5#slide.44"
      ]
    },
    {
      "id": "linear-search",
      "term": "Linear search",
      "definition": "Linear search sequentially checks each array element until the item is found or the array ends.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.2"
      ]
    },
    {
      "id": "binary-search",
      "term": "Binary search",
      "definition": "Binary search repeatedly compares the key with the middle element of a sorted array and halves the search interval.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.11"
      ]
    },
    {
      "id": "selection-sort",
      "term": "Selection sort",
      "definition": "Selection sort repeatedly selects the smallest element from the unsorted portion and swaps it into place.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.22"
      ]
    },
    {
      "id": "insertion-sort",
      "term": "Insertion sort",
      "definition": "Insertion sort builds a sorted segment by inserting each next element into its correct position.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.25"
      ]
    },
    {
      "id": "merge-sort",
      "term": "Merge sort",
      "definition": "Merge sort divides the list into halves, sorts them, and merges the sorted halves.",
      "formula": "",
      "unit": 6,
      "unitTitle": "Searching and Sorting",
      "sources": [
        "ds-ds-unit-6#slide.46"
      ]
    }
  ]
}
